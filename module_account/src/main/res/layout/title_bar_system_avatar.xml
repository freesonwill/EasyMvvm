<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    style="@style/CustomToolbarStyleAccount">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_back"
        android:layout_marginStart="-3dp"
        style="@style/CustomToolbarImgStyle2"
        app:srcCompat="@drawable/universal_icon_back"
        />


    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title"
        android:text="@string/personal_info_system_avatar_title"
        android:layout_marginStart="-5dp"
        style="@style/CustomToolbarTvStyle"
        android:textColor="@color/white"
        tools:ignore="MissingConstraints" />


    <ImageView
        android:id="@+id/ivRotate"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/avatar_rotate"
        />


</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>