<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/title_bg">

    <arch.cayenne.lib.common.ui.view.TitleBarView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:background="@color/app_bg"
        android:paddingTop="@dimen/dp_32"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_height="match_parent">

    <arch.cayenne.lib.common.ui.view.ClipRoundedFrameLayout
        android:id="@+id/ll_head"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:cornerRadius="@dimen/dp_45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tool:ignore="MissingConstraints">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAvatar"
            android:layout_width="@dimen/dp_90"
            android:layout_height="@dimen/dp_90"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:scaleType="centerCrop"
            android:src="@drawable/account_avatar_default"
            tool:ignore="MissingConstraints" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/HalfCircle"
            android:layout_width="@dimen/dp_90"
            android:visibility="gone"
            android:layout_height="27dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:background="@color/user_avatar_text_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tool:ignore="MissingConstraints">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_account_avatar_camera"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:background="@drawable/account_avatar_camera" />

            <TextView
                android:id="@+id/cameraText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="@string/personal_info_system_avatar_change"
                android:textSize="12sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </arch.cayenne.lib.common.ui.view.ClipRoundedFrameLayout>
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/account_name_item"
        android:layout_marginTop="@dimen/dp_32"
        app:layout_constraintTop_toBottomOf="@+id/ll_head"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_52"
        android:background="@drawable/acc_effect">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:text="@string/info_name"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/sp_15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:text="模拟数据模拟数"
            android:paddingStart="88dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tool:ignore="RtlSymmetry" />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:background="@drawable/account_avatar_chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            android:background="@color/account_line"
            app:layout_constraintBottom_toBottomOf="parent" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/account_userId_item"
        app:layout_constraintTop_toBottomOf="@+id/account_name_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_52"
        android:background="@drawable/acc_effect">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:text="@string/info_user_id"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/sp_15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_UserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:text="41609856"
            android:paddingStart="88dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tool:ignore="RtlSymmetry" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_copy_userId"
            app:layout_constraintLeft_toRightOf="@+id/tv_UserId"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="7dp"
            android:background="@drawable/account_avatar_copy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</arch.cayenne.lib.skin.widget.SkinnableLinearLayout>