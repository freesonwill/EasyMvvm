<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_1E1E1E"
    android:orientation="vertical"
    app:interceptedDirection="RIGHT">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:layout_marginStart="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginEnd="@dimen/dp_28"
        android:background="@drawable/shape_register_edittext"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_country_code"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_4" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                app:srcCompat="@drawable/account_register_drop_down" />


            <androidx.appcompat.widget.AppCompatImageView
                android:layout_marginStart="@dimen/dp_4"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_21" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <arch.cayenne.lib.skin.widget.SkinnableEditText
            android:id="@+id/edit_text_phone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="请输入手机号"
            android:inputType="phone"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/gray" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>