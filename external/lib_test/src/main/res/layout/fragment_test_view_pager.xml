        android:layout_height="match_parent"
        app:navGraph="@navigation/nav_graph_vp_home"
        />-->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fr2"
        android:name="arch.cayenne.lib.test.ui.fragment.ViewPager2Fragment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_200" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host2"
        android:name="androidx.navigation.fragment.HideShowNavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_200"
        app:defaultNavHost="false"
        app:navGraph="@navigation/nav_graph_host2"
        android:background="@color/green_for_white_bg"
        />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host3"
