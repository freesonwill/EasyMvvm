<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    app:dividerPadding="@dimen/dp_100">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="通信测试页面" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/ws_connect"
        style="@style/ws_popup_btn"
        android:text="ws连接" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/ws_origin_connect"
        style="@style/ws_popup_btn"
        android:text="ws纯原生连接" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/ws_login"
        style="@style/ws_popup_btn"
        android:text="ws登录" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/ws_today"
        style="@style/ws_popup_btn"
        android:text="ws今日数据" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/ws_http"
        style="@style/ws_popup_btn"
        android:text="http首开接口" />

</androidx.appcompat.widget.LinearLayoutCompat>