<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_47"
    android:layout_marginHorizontal="@dimen/dp_0"
    android:clickable="false"
    android:focusable="false">

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_combination"
        android:layout_marginHorizontal="@dimen/dp_12"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_tab_combo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/sf_pro"
        android:gravity="start|center_vertical"
        android:paddingStart="@dimen/dp_24"
        android:textColor="@color/color_C0C0C0"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_tab_bet"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"
        app:skinnableFontWeight="400"
        android:paddingBottom="1.6dp"
        tools:text="1·2·3" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_tab_bet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="@font/sf_pro"
        android:gravity="center"
        android:textColor="@color/color_C0C0C0"
        android:textSize="@dimen/sp_14"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_tab_win"
        app:layout_constraintStart_toEndOf="@+id/tv_tab_combo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"
        app:skinnableFontWeight="400"
        android:paddingBottom="1.6dp"
        android:paddingEnd="3dp"
        tools:text="$10.00" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_tab_win"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="@font/sf_pro"
        android:gravity="center"
        android:paddingStart="@dimen/dp_8"
        android:textColor="@color/color_C0C0C0"
        android:textSize="@dimen/sp_14"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_tab_odds"
        app:layout_constraintStart_toEndOf="@+id/tv_tab_bet"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"
        app:skinnableFontWeight="400"
        android:paddingBottom="1.6dp"
        tools:text="$91.30" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_tab_odds"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:ellipsize="end"
        android:fontFamily="@font/sf_pro"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:paddingEnd="@dimen/dp_24"
        android:textColor="@color/color_C0C0C0"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_tab_win"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"
        app:skinnableFontWeight="400"
        android:paddingBottom="1.6dp"
        tools:text="\@9.13" />

</androidx.constraintlayout.widget.ConstraintLayout>