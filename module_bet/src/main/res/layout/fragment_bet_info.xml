<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="gone"
    tools:visibility="visible">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_bet_info"
        android:layout_width="207dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_12"
        android:gravity="start|center_vertical"
        android:textColor="@color/color_1E1E1E"
        android:textSize="@dimen/sp_13"
        android:background="@drawable/bg_shape_bet_tip"
        android:minHeight="42dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_bg_top"
        app:layout_constraintBottom_toBottomOf="@id/iv_bg_bottom"
        tools:text="3串1组合由所有3串1注单组成"
        app:skinnableFontWeight="400"
        android:paddingBottom="@dimen/dp_1"
        android:layout_marginTop="7.5dp"
        android:layout_marginBottom="7.5dp"
        app:layout_constraintVertical_bias="0.0"
        app:layout_goneMarginBottom="0dp"
        app:layout_goneMarginTop="0dp"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_bg_top"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_10"
        android:layout_marginStart="31dp"
        android:layout_marginBottom="-2.5dp"
        android:rotation="180"
        app:layout_constraintStart_toStartOf="@id/tv_bet_info"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_bet_info_arrow"
        android:visibility="gone"
        tools:visibility="gone"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_bg_bottom"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_10"
        android:layout_marginStart="31dp"
        android:layout_marginTop="-2.5dp"
        app:layout_constraintStart_toStartOf="@+id/tv_bet_info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/icon_bet_info_arrow"
        tools:visibility="visible"
        />

</androidx.constraintlayout.widget.ConstraintLayout>