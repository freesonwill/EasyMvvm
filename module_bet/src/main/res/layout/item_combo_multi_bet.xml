<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_12"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_multi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textColor="@color/main_text"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/et_money"
        app:layout_constraintEnd_toStartOf="@id/et_money"
        app:layout_constraintTop_toTopOf="@id/et_money"
        app:skinnableFontWeight="600"
        tools:text="6x"/>

    <arch.cayenne.lib.skin.widget.SkinnableEditText
        android:id="@+id/et_money"
        android:layout_width="127dp"
        android:layout_height="36dp"
        android:background="@drawable/shape_8dp"
        android:backgroundTint="@color/color_0FFFFFFF"
        android:cursorVisible="false"
        android:padding="8dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/color_FFFFFF"
        android:textColorHint="@color/color_C0C0C0"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="¥ 100"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title_combo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:textColor="@color/color_FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_multi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:skinnableFontWeight="500"
        tools:text="2串1组合"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/money_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_money"
        tools:text="6x"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="@string/title_combo_bet_odds_amount"
        android:textColor="@color/color_C0C0C0"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_money"
        app:layout_constraintTop_toTopOf="@id/tv_money"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title_max_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/title_combo_bet_odds_max_money"
        android:textColor="@color/color_C0C0C0"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_combo" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_max_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/money_color"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_title_max_money"
        app:layout_constraintStart_toEndOf="@id/tv_title_max_money"
        app:layout_constraintTop_toTopOf="@id/tv_title_max_money"
        tools:text="¥0"/>

</androidx.constraintlayout.widget.ConstraintLayout>