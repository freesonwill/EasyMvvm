<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_floating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_main_floating"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_floating_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/icon_main_floating_pin"
        app:layout_constraintEnd_toEndOf="@id/iv_floating"
        app:layout_constraintTop_toTopOf="@id/iv_floating" />

    <TextView
        android:id="@+id/tv_float_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:text="1"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/iv_floating_pin"
        app:layout_constraintEnd_toEndOf="@id/iv_floating_pin"
        app:layout_constraintStart_toStartOf="@id/iv_floating_pin"
        app:layout_constraintTop_toTopOf="@id/iv_floating_pin" />


</androidx.constraintlayout.widget.ConstraintLayout>