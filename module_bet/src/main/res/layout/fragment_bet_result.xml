<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bet_dialog">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_19"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_title"
                android:layout_width="20dp"
                android:layout_height="20dp" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                app:skinnableFontWeight="500" />
        </LinearLayout>

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_bet_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_21"
            android:textColor="@color/color_C0C0C0"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="@dimen/dp_19"
        android:layout_marginBottom="@dimen/dp_17"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom"
        app:layout_constraintTop_toBottomOf="@id/ll_top">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_order_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bet_sheet"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
                    android:id="@+id/rv_bet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:listitem="@layout/item_bet_sheet" />

                <LinearLayout
                    android:id="@+id/ll_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_25"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center|top"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/tv_order_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_result_count"
                        android:textColor="@color/color_C0C0C0"
                        android:textSize="@dimen/sp_12" />

                    <arch.cayenne.lib.skin.widget.SkinnableImageView
                        android:id="@+id/iv_order_expand"
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="@dimen/dp_12"
                        android:layout_marginTop="@dimen/dp_3"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
            </LinearLayout>

            <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
                android:id="@+id/cl_combo_bet_money"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/bg_bet_sheet"
                android:orientation="vertical"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/ll_order_list"
                app:layout_goneMarginTop="@dimen/dp_10">

                <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
                    android:id="@+id/rv_combo_odds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_result_multi_bet" />

                <LinearLayout
                    android:id="@+id/ll_total_bet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_7"
                    android:orientation="horizontal">

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/tv_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_result_amount"
                        android:textColor="@color/color_C0C0C0"
                        android:textSize="@dimen/sp_14" />

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/tv_amount_money"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro"
                        android:gravity="end"
                        android:textColor="@color/color_00E0E5"
                        android:textSize="@dimen/sp_14"
                        app:skinnableFontWeight="510" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:orientation="horizontal">

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/tv_max_win"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_C0C0C0"
                        android:textSize="@dimen/sp_14" />

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/tv_max_win_money"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro"
                        android:gravity="end"
                        android:textColor="@color/color_00E0E5"
                        android:textSize="@dimen/sp_14"
                        app:skinnableFontWeight="510" />
                </LinearLayout>
            </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableButton
            android:id="@+id/btn_check_bet"
            android:layout_width="@dimen/dp_117"
            android:layout_height="match_parent"
            android:background="@drawable/selector_check_bet"
            android:enabled="false"
            android:gravity="center"
            android:text="@string/btn_result_check_bet"
            android:textColor="@color/color_00E0E5"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/selector_confirm_button"
            android:gravity="center"
            android:text="@string/btn_confirm"
            android:textColor="@color/color_FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_check_bet"
            app:skinnableFontWeight="500" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>