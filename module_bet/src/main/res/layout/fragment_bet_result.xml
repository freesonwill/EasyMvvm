<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="10dp">

    <LinearLayout
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_title"
            android:layout_width="20dp"
            android:layout_height="20dp" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/main_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/title_result_hint"
        android:textColor="@color/explanation_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_top" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/rv_combo_odds"
        app:layout_constraintTop_toBottomOf="@id/tv_hint"
        app:layout_goneMarginTop="10dp"
        tools:itemCount="4"
        tools:listitem="@layout/item_bet_sheet" />

    <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
        android:id="@+id/rv_combo_odds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bet_sheet"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/cl_combo_bet_money"
        tools:itemCount="2"
        tools:listitem="@layout/item_result_multi_bet" />

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_combo_bet_money"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bet_sheet"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/btn_continue_bet"
        app:layout_goneMarginTop="12dp">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_result_amount"
            android:textColor="@color/secondary_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_max_win"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/secondary_text"
            app:layout_constraintStart_toStartOf="@id/tv_amount"
            app:layout_constraintTop_toBottomOf="@id/tv_amount" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_amount_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/main_text"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_amount" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_max_win_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/main_text"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_max_win"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_max_win" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_continue_bet"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:enabled="false"
        android:background="@drawable/select_continue_bet"
        android:gravity="center"
        android:text="@string/btn_result_continue_bet"
        android:textColor="#B324EE8A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/selector_send_button"
        android:gravity="center"
        android:text="@string/btn_confirm"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_continue_bet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_continue_bet"
        app:layout_constraintTop_toTopOf="@id/btn_continue_bet" />

</androidx.constraintlayout.widget.ConstraintLayout>