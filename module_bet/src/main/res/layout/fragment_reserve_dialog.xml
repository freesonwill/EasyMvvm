<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/triangle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_triangle_up"
        app:layout_constraintBottom_toTopOf="@id/cl_calculator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_calculator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_12dp"
        android:backgroundTint="@color/color_main_background"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/triangle">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/title_rate"
            android:textColor="@color/color_textview"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/et_rate"
            app:layout_constraintEnd_toStartOf="@id/et_rate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/et_rate" />

        <EditText
            android:id="@+id/et_rate"
            android:layout_width="130dp"
            android:layout_height="36dp"
            android:background="@drawable/shape_8dp"
            android:backgroundTint="@color/color_button_normal"
            android:cursorVisible="true"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:textColor="@color/color_textview"
            android:textColorHint="@color/color_edittext_hint"
            android:textCursorDrawable="@drawable/shape_edittext_cursor"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.walisport.module.bet.ui.custom.NumberKeyboardView
            android:id="@+id/number_keyboard"
            android:layout_width="224dp"
            android:layout_height="0dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@id/gl_other"
            app:layout_constraintEnd_toStartOf="@id/gl_other"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/gl_other" />

        <GridLayout
            android:id="@+id/gl_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_rate">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/NumberKeyboardButton"
                android:layout_width="62dp"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/color_button_normal"
                android:src="@mipmap/icon_back" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_clear"
                style="@style/NumberKeyboardButton"
                android:layout_width="62dp"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/color_button_normal"
                android:text="@string/btn_clear"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                style="@style/NumberKeyboardButton"
                android:layout_width="62dp"
                android:layout_height="96dp"
                android:layout_columnWeight="2"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/color_button"
                android:text="@string/btn_confirm"
                android:textSize="12sp" />

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>