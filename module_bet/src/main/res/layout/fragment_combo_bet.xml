<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_153"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@mipmap/bet_bg" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title_bet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_title_betting_slip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="16dp"
            android:text="@string/title_betting_combo"
            android:textColor="@color/main_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_balance"
            android:fontFamily="@font/sf_pro_display_bold"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="@color/money_color"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_close"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_close"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/icon_collapse"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
        android:id="@+id/rv_bet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:nestedScrollingEnabled="true"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/cl_multi_bet"
        app:layout_constraintTop_toBottomOf="@id/cl_title_bet"
        tools:itemCount="2"
        tools:listitem="@layout/item_bet_sheet" />

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_multi_bet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        app:layout_goneMarginBottom="12dp"
        android:background="@drawable/bg_bet_sheet"
        app:layout_constraintBottom_toTopOf="@id/cl_odds_change">

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_multi_bet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_combo_multi_bet"
            app:layout_constraintBottom_toTopOf="@id/rv_multi_bet">

            <LinearLayout
                android:id="@+id/ll_multi_bet_collapse"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_multi_bet_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_combo_bet_ham" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_multi_bet_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/title_combo_bet_odds_expand"
                    android:textColor="@color/color_C0C0C0"
                    android:textSize="13sp" />
            </LinearLayout>

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_sum_bet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="@string/title_combo_bet_money"
                android:textColor="@color/color_C0C0C0"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_sum_bet_money"
                app:layout_constraintEnd_toStartOf="@id/tv_sum_bet_money"
                app:layout_constraintTop_toTopOf="@id/tv_sum_bet_money" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_sum_bet_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:textColor="@color/money_color"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
            android:id="@+id/rv_multi_bet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="true"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:itemCount="1"
            tools:listitem="@layout/item_combo_multi_bet" />

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_odds_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/shape_6dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_odds_change_mask"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cl_bottom_button"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible"
        >

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_odds_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:layout_marginStart="12dp"
            android:textColor="@color/keyboard_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_odds_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="11dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="11dp"
            android:src="@drawable/icon_odds_arrow_down"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_odds_change"
            app:layout_constraintTop_toTopOf="parent" />

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            android:id="@+id/btn_delete"
            layout="@layout/item_exit_combo_btn"
            android:layout_width="@dimen/dp_92"
            android:layout_height="@dimen/dp_48"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />


        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_bet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/selector_send_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_delete"
            app:layout_constraintTop_toTopOf="@id/btn_delete">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_bet_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_bet_hint"
                android:textColor="@color/color_FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_bet_money"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:skinnableFontWeight="500" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_bet_money_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="@string/title_combo_bet_odds_max_money"
                android:textColor="@color/color_FFFFFF"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_bet_money"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_bet_hint"
                app:skinnableFontWeight="500" />

            <TextView
                android:id="@+id/tv_bet_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:textColor="@color/color_FFFFFF"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_bet_money_hint"
                app:layout_constraintTop_toBottomOf="@id/tv_bet_hint" />
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>