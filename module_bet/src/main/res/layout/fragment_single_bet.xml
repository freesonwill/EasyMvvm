<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title_bet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_title_betting_slip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:layout_marginStart="22dp"
            android:text="@string/title_betting_slip"
            android:textColor="@color/main_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_balance"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@color/money_color"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_close"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:src="@drawable/icon_page_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/layout_bet"
        layout="@layout/item_bet_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@id/cl_title_bet" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_calculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layout_bet">

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_money"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/shape_8dp"
            android:backgroundTint="@color/input_box_2"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintEnd_toStartOf="@id/cl_reserve"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_money"
                android:layout_width="18dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginVertical="14dp"
                android:background="@drawable/bg_input_money"
                android:gravity="center"
                android:textColor="@color/money_color"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableEditText
                android:id="@+id/et_money"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:background="@null"
                android:textColor="@color/main_text"
                android:textColorHint="@color/input_word"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_money"
                app:layout_constraintTop_toTopOf="parent" />
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_reserve"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/cl_money"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cl_money">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_reserve"
                android:layout_width="62dp"
                android:layout_height="0dp"
                android:background="@drawable/selector_button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_reserve_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:text="@string/btn_reserve"
                    android:textColor="@color/text_on_theme_color"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_reserve_hint"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_reserve_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_add"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_reserve_hint"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                android:id="@+id/cl_cancel_reserve"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:background="@drawable/shape_8dp"
                android:backgroundTint="@color/input_box_2"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_cancel_reserve"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/shape_6dp"
                    android:backgroundTint="@color/reserve_bg"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/main_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_cancel_reserve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:padding="8dp"
                    android:src="@drawable/icon_page_close"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_cancel_reserve"
                    app:layout_constraintTop_toTopOf="parent" />

            </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/iv_faker_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_reserve" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_reserve">

            <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
                android:id="@+id/ll_common_amount"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_6dp"
                android:backgroundTint="@color/keyboard_1"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableButton
                    android:id="@+id/btn_100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="100"
                    android:textColor="@color/keyboard_number"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <arch.cayenne.lib.skin.widget.SkinnableView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@color/dividing_line" />

                <arch.cayenne.lib.skin.widget.SkinnableButton
                    android:id="@+id/btn_500"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="500"
                    android:textColor="@color/keyboard_number"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <arch.cayenne.lib.skin.widget.SkinnableView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@color/dividing_line" />

                <arch.cayenne.lib.skin.widget.SkinnableButton
                    android:id="@+id/btn_1000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="1000"
                    android:textColor="@color/keyboard_number"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <arch.cayenne.lib.skin.widget.SkinnableView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@color/dividing_line" />

                <arch.cayenne.lib.skin.widget.SkinnableButton
                    android:id="@+id/btn_2000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="2000"
                    android:textColor="@color/keyboard_number"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <arch.cayenne.lib.skin.widget.SkinnableView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@color/dividing_line" />

                <arch.cayenne.lib.skin.widget.SkinnableButton
                    android:id="@+id/btn_5000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="5000"
                    android:textColor="@color/keyboard_number"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

            <arch.cayenne.lib.common.ui.view.NumberKeyboardView
                android:id="@+id/number_keyboard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="4dp"
                app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
                app:layout_constraintEnd_toStartOf="@id/gl_other"
                app:layout_constraintStart_toEndOf="@id/ll_common_amount"
                app:layout_constraintTop_toTopOf="@id/ll_common_amount" />

            <GridLayout
                android:id="@+id/gl_other"
                android:layout_width="62dp"
                android:layout_height="0dp"
                android:columnCount="1"
                app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ll_common_amount">

                <arch.cayenne.lib.skin.widget.SkinnableImageButton
                    android:id="@+id/btn_back"
                    style="@style/NumberKeyboardButton"
                    android:layout_marginBottom="2dp"
                    android:backgroundTint="@color/keyboard_1"
                    android:src="@drawable/icon_keyboard_back" />

                <arch.cayenne.lib.skin.widget.SkinnableButton
                    android:id="@+id/btn_clear"
                    style="@style/NumberKeyboardButton"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:backgroundTint="@color/keyboard_1"
                    android:text="@string/btn_clear"
                    android:textSize="12sp" />

                <arch.cayenne.lib.skin.widget.SkinnableButton
                    android:id="@+id/btn_double"
                    style="@style/NumberKeyboardButton"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:backgroundTint="@color/keyboard_1"
                    android:text="@string/btn_double"
                    android:textSize="12sp" />

                <arch.cayenne.lib.skin.widget.SkinnableImageButton
                    android:id="@+id/btn_collapse"
                    style="@style/NumberKeyboardButton"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:backgroundTint="@color/keyboard_1"
                    android:padding="10dp"
                    android:src="@drawable/icon_keyboard" />

            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_calculator">

        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:src="@mipmap/icon_delete_combo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_collusion"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:background="@drawable/selector_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_collusion_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:text="@string/btn_collusion"
                android:textColor="@color/text_on_theme_color"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_collusion_hint"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_collusion_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_add"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_collusion_hint"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_bet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/selector_send_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_collusion"
            app:layout_constraintTop_toTopOf="@id/btn_collusion">

            <TextView
                android:id="@+id/tv_bet_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_bet_hint"
                android:textColor="@color/text_on_theme_color"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_bet_money"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_bet_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#016F4A"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_bet_hint" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>