<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_title_bet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/layout_bet"
            app:layout_constraintTop_toTopOf="parent">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_title_betting_slip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="16dp"
                android:text="@string/title_betting_slip"
                android:textColor="@color/main_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:skinnableFontWeight="500" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_balance"
                android:fontFamily="@font/sf_pro_display_bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="@color/money_color"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_close"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:id="@+id/iv_close"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="12dp"
                android:src="@drawable/icon_page_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/layout_bet"
            layout="@layout/item_bet_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/cl_calculator"
            app:layout_constraintTop_toBottomOf="@id/cl_title_bet" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_calculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/cl_bottom_button"
            app:layout_constraintTop_toBottomOf="@id/layout_bet">

            <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                android:id="@+id/cl_money"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/shape_8dp"
                android:backgroundTint="@color/input_box_2"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:layout_constraintEnd_toStartOf="@id/cl_reserve"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_money"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="14dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_input_money"
                    android:gravity="center"
                    android:textColor="@color/money_color"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <arch.cayenne.lib.skin.widget.SkinnableEditText
                    android:id="@+id/et_money"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:background="@null"
                    android:textSize="16sp"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:inputType="numberDecimal"
                    android:textCursorDrawable="@drawable/shape_edittext_cursor"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_money"
                    app:layout_constraintTop_toTopOf="parent" />
            </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_reserve"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/cl_money"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/cl_money">

                <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                    android:id="@+id/btn_reserve"
                    android:layout_width="62dp"
                    android:layout_height="0dp"
                    android:background="@drawable/selector_button"
                    android:foreground="@drawable/bg_click_mask_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0">

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/tv_reserve_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1.14dp"
                        android:gravity="center"
                        android:text="@string/btn_reserve"
                        android:textColor="@color/text_on_theme_color"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_reserve_hint"
                        app:layout_constraintTop_toTopOf="parent"
                        app:skinnableFontWeight="500" />

                    <ImageView
                        android:id="@+id/iv_reserve_hint"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/icon_add"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_reserve_hint"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

                <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                    android:id="@+id/cl_cancel_reserve"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_8dp"
                    android:backgroundTint="@color/input_box_2"
                    android:foreground="@drawable/bg_click_mask"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/tv_cancel_reserve"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="9dp"
                        android:background="@drawable/shape_6dp"
                        android:backgroundTint="@color/reserve_bg"
                        android:gravity="center"
                        android:paddingHorizontal="11dp"
                        android:textColor="@color/main_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:skinnableFontWeight="600" />

                    <arch.cayenne.lib.skin.widget.SkinnableImageView
                        android:id="@+id/iv_cancel_reserve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:padding="8dp"
                        android:src="@drawable/icon_page_close"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_cancel_reserve"
                        app:layout_constraintTop_toTopOf="parent" />

                </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                android:id="@+id/cl_odds_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_6dp"
                android:backgroundTint="@color/keyboard_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_money">

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_odds_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginVertical="5dp"
                    android:textColor="@color/keyboard_number"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_odds_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="11dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/icon_odds_arrow_down"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_odds_change"
                    app:layout_constraintTop_toTopOf="parent" />

            </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

            <ImageView
                android:id="@+id/iv_faker_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_odds_change" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_odds_change">

                <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                    android:id="@+id/ll_common_amount"
                    android:layout_width="61dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_6dp"
                    android:backgroundTint="@color/keyboard_1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <arch.cayenne.lib.skin.widget.SkinnableButton
                        android:id="@+id/btn_100"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/bg_click_mask_top_6dp_white_blue"
                        android:gravity="center"
                        android:text="100"
                        android:textColor="@color/keyboard_number"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:skinnableFontWeight="500" />

                    <arch.cayenne.lib.skin.widget.SkinnableView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/dividing_line"
                        app:layout_constraintBottom_toTopOf="@id/btn_500"
                        app:layout_constraintTop_toBottomOf="@id/btn_100" />

                    <arch.cayenne.lib.skin.widget.SkinnableButton
                        android:id="@+id/btn_500"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/bg_click_mask"
                        android:gravity="center"
                        android:text="500"
                        android:textColor="@color/keyboard_number"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/btn_100"
                        app:skinnableFontWeight="500" />

                    <arch.cayenne.lib.skin.widget.SkinnableView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/dividing_line"
                        app:layout_constraintBottom_toTopOf="@id/btn_1000"
                        app:layout_constraintTop_toBottomOf="@id/btn_500" />

                    <arch.cayenne.lib.skin.widget.SkinnableButton
                        android:id="@+id/btn_1000"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/bg_click_mask"
                        android:gravity="center"
                        android:text="1000"
                        android:textColor="@color/keyboard_number"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/btn_500"
                        app:skinnableFontWeight="500" />

                    <arch.cayenne.lib.skin.widget.SkinnableView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/dividing_line"
                        app:layout_constraintBottom_toTopOf="@id/btn_2000"
                        app:layout_constraintTop_toBottomOf="@id/btn_1000" />

                    <arch.cayenne.lib.skin.widget.SkinnableButton
                        android:id="@+id/btn_2000"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/bg_click_mask"
                        android:gravity="center"
                        android:text="2000"
                        android:textColor="@color/keyboard_number"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/btn_1000"
                        app:skinnableFontWeight="500" />

                    <arch.cayenne.lib.skin.widget.SkinnableView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/dividing_line"
                        app:layout_constraintBottom_toTopOf="@id/btn_5000"
                        app:layout_constraintTop_toBottomOf="@id/btn_2000" />

                    <arch.cayenne.lib.skin.widget.SkinnableButton
                        android:id="@+id/btn_5000"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/bg_click_mask_bottom_6dp_white_blue"
                        android:gravity="center"
                        android:text="5000"
                        android:textColor="@color/keyboard_number"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/btn_2000"
                        app:skinnableFontWeight="500" />
                </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

                <arch.cayenne.lib.common.ui.view.NumberKeyboardView
                    android:id="@+id/number_keyboard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
                    app:layout_constraintEnd_toStartOf="@id/gl_other"
                    app:layout_constraintStart_toEndOf="@id/ll_common_amount"
                    app:layout_constraintTop_toTopOf="@id/ll_common_amount" />

                <GridLayout
                    android:id="@+id/gl_other"
                    android:layout_width="62dp"
                    android:layout_height="0dp"
                    android:columnCount="1"
                    app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ll_common_amount">

                    <arch.cayenne.lib.skin.widget.SkinnableImageButton
                        android:id="@+id/btn_back"
                        style="@style/NumberKeyboardTextButton"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/keyboard_1"
                        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
                        android:scaleType="center"
                        android:src="@drawable/icon_keyboard_back" />

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/btn_clear"
                        style="@style/NumberKeyboardTextButton"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/keyboard_1"
                        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
                        android:text="@string/btn_clear"
                        android:textSize="12sp"
                        app:skinnableFontWeight="500" />

                    <arch.cayenne.lib.skin.widget.SkinnableTextView
                        android:id="@+id/btn_double"
                        style="@style/NumberKeyboardTextButton"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/keyboard_1"
                        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
                        android:text="@string/btn_double"
                        android:textSize="12sp"
                        app:skinnableFontWeight="500" />

                    <arch.cayenne.lib.skin.widget.SkinnableImageButton
                        android:id="@+id/btn_collapse"
                        style="@style/NumberKeyboardTextButton"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:backgroundTint="@color/keyboard_1"
                        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
                        android:padding="10dp"
                        android:scaleType="center"
                        android:src="@drawable/icon_keyboard" />

                </GridLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_bottom_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:id="@+id/btn_delete"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:foreground="@drawable/bg_click_mask_8dp"
                android:src="@mipmap/icon_delete_combo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                android:id="@+id/btn_collusion"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="@drawable/selector_button"
                android:foreground="@drawable/bg_click_mask_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_collusion_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0.57dp"
                    android:gravity="center"
                    android:text="@string/btn_collusion"
                    android:textColor="@color/text_on_theme_color"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_collusion_hint"
                    app:layout_constraintTop_toTopOf="parent"
                    app:skinnableFontWeight="500" />

                <ImageView
                    android:id="@+id/iv_collusion_hint"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/icon_add"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_collusion_hint"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

            <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                android:id="@+id/cl_bet"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/selector_send_button"
                android:foreground="@drawable/bg_click_mask_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_collusion"
                app:layout_constraintTop_toTopOf="@id/btn_collusion">

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_bet_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_bet_hint"
                    android:textColor="@color/text_on_theme_color"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tv_bet_money"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:skinnableFontWeight="500" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_bet_money"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#016F4A"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_bet_hint"
                    app:skinnableFontWeight="500" />
            </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>