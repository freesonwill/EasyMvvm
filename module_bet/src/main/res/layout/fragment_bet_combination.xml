<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="425dp"
    android:background="@drawable/bg_bet_dialog">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/combination_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_54">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_bet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:text="@string/title_combo_bet_super"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_bet_info"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_bet_title"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_bet_info" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_bet_expand"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_bet_close"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_bet_expand" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_bet_close"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_bet_close" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
        android:id="@+id/rv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/combination_title" />
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>