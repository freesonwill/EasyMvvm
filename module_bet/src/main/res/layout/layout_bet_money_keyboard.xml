<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/dp_0"
    android:paddingBottom="@dimen/dp_0"
    android:background="@color/color_1E1E1E"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
        android:id="@+id/rv_quick_amount"
        android:layout_width="61dp"
        android:layout_height="204dp"
        android:background="@drawable/shape_6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:orientation="vertical"
        android:outlineProvider="background"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:itemCount="5"
        tools:listitem="@layout/item_quick_amount"
        tools:visibility="gone" />

    <arch.cayenne.lib.common.ui.view.NumberKeyboardView
        android:id="@+id/number_keyboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@id/gl_other"
        app:layout_constraintEnd_toStartOf="@id/gl_other"
        app:layout_constraintStart_toEndOf="@id/rv_quick_amount"
        app:layout_constraintTop_toTopOf="@id/gl_other"
        android:spacing="@dimen/dp_6"/>

    <GridLayout
        android:id="@+id/gl_other"
        android:layout_width="61dp"
        android:layout_height="match_parent"
        android:columnCount="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableImageButton
            android:id="@+id/btn_back"
            style="@style/NumberKeyboardTextButton"
            android:layout_width="61dp"
            android:layout_height="48dp"
            android:layout_rowWeight="0"
            android:layout_marginBottom="3dp"
            android:scaleType="center"
            android:paddingTop="0dp"
            android:src="@drawable/icon_keyboard_back" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/btn_clear"
            style="@style/NumberKeyboardTextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_rowWeight="0"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:text="@string/btn_clear"
            android:textSize="14sp"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableImageButton
            android:id="@+id/btn_collapse"
            style="@style/NumberKeyboardTextButton"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:layout_rowWeight="0"
            android:layout_columnWeight="2"
            android:layout_marginTop="3dp"
            android:padding="10dp"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_down" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

