<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp">

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_combo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_C0C0C0"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3串1 @12.76"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_bet_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tv_combo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_combo"
        app:skinnableFontWeight="600"
        tools:text="1 * ¥20"/>

</androidx.constraintlayout.widget.ConstraintLayout>