<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_12dp"
        android:backgroundTint="@color/keyboard_3"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_money"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_8dp"
            android:backgroundTint="@color/input_box_2"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintTop_toTopOf="parent">

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:id="@+id/iv_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="13dp"
                android:src="@drawable/icon_coin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableEditText
                android:id="@+id/et_money"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:background="@null"
                android:hint="@string/et_money_hint"
                android:textColor="@color/main_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_money"
                app:layout_constraintTop_toTopOf="parent" />
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
            android:id="@+id/ll_common_amount"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_6dp"
            android:backgroundTint="@color/keyboard_1"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_money">

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_100"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="100"
                android:textColor="@color/keyboard_number"
                android:textSize="14sp"
                android:textStyle="bold" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_500"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="500"
                android:textColor="@color/keyboard_number"
                android:textSize="14sp"
                android:textStyle="bold" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_1000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="1000"
                android:textColor="@color/keyboard_number"
                android:textSize="14sp"
                android:textStyle="bold" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_2000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="2000"
                android:textColor="@color/keyboard_number"
                android:textSize="14sp"
                android:textStyle="bold" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_5000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="5000"
                android:textColor="@color/keyboard_number"
                android:textSize="14sp"
                android:textStyle="bold" />
        </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

        <arch.cayenne.lib.common.ui.view.NumberKeyboardView
            android:id="@+id/number_keyboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
            app:layout_constraintEnd_toStartOf="@id/gl_other"
            app:layout_constraintStart_toEndOf="@id/ll_common_amount"
            app:layout_constraintTop_toTopOf="@id/ll_common_amount" />

        <GridLayout
            android:id="@+id/gl_other"
            android:layout_width="62dp"
            android:layout_height="0dp"
            android:columnCount="1"
            app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ll_common_amount">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/NumberKeyboardButton"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/keyboard_1"
                android:src="@drawable/icon_keyboard_back" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_clear"
                style="@style/NumberKeyboardButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/keyboard_1"
                android:text="@string/btn_clear"
                android:textSize="12sp" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_double"
                style="@style/NumberKeyboardButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/keyboard_1"
                android:text="@string/btn_double"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                style="@style/ButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_marginTop="2dp"
                android:backgroundTint="@color/brand_color"
                android:text="@string/btn_confirm"
                android:textSize="12sp" />

        </GridLayout>

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/triangle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="70dp"
        android:background="@drawable/bg_triangle_down"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main" />

</androidx.constraintlayout.widget.ConstraintLayout>