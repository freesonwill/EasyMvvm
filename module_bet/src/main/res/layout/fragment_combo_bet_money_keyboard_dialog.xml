<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_12dp"
        android:backgroundTint="@color/keyboard_3"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="0dp">

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_money"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/shape_8dp"
            android:backgroundTint="@color/input_box_2"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintTop_toTopOf="parent">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_money"
                android:layout_width="18dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="9dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_input_money"
                android:gravity="center"
                android:textColor="@color/money_color"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableEditText
                android:id="@+id/et_money"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:background="@null"
                android:textColor="@color/main_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="16sp"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="numberDecimal"
                android:textCursorDrawable="@drawable/shape_edittext_cursor"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_money"
                app:layout_constraintTop_toTopOf="parent" />
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
            android:id="@+id/rv_quick_amount"
            android:layout_width="55dp"
            android:layout_height="183dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_6dp"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:outlineProvider="background"
            android:clipToOutline="true"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_money"
            tools:itemCount="5"
            tools:listitem="@layout/item_quick_amount" />

        <arch.cayenne.lib.common.ui.view.NumberKeyboardView
            android:id="@+id/number_keyboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@id/rv_quick_amount"
            app:layout_constraintEnd_toStartOf="@id/gl_other"
            app:layout_constraintStart_toEndOf="@id/rv_quick_amount"
            app:layout_constraintTop_toTopOf="@id/rv_quick_amount" />

        <GridLayout
            android:id="@+id/gl_other"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:columnCount="1"
            app:layout_constraintBottom_toBottomOf="@id/rv_quick_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/rv_quick_amount">

            <arch.cayenne.lib.skin.widget.SkinnableImageButton
                android:id="@+id/btn_back"
                style="@style/NumberKeyboardTextButton"
                android:layout_marginBottom="2dp"
                android:scaleType="center"
                android:src="@drawable/icon_keyboard_back" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/btn_clear"
                style="@style/NumberKeyboardTextButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:text="@string/btn_clear"
                android:textSize="12sp"
                app:skinnableFontWeight="500" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/btn_double"
                style="@style/NumberKeyboardTextButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:text="@string/btn_double"
                android:textSize="12sp"
                app:skinnableFontWeight="500" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                style="@style/ButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_marginTop="2dp"
                android:text="@string/btn_confirm"
                android:textSize="12sp"
                app:skinnableFontWeight="500" />

        </GridLayout>

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/triangle"
        android:layout_width="32dp"
        android:layout_height="10dp"
        android:layout_marginEnd="70dp"
        android:background="@drawable/bg_triangle_down"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main" />

</androidx.constraintlayout.widget.ConstraintLayout>