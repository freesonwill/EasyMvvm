<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BetModuleTheme">
        <item name="android:textAppearance">@style/TextViewStyle</item>
        <item name="android:buttonStyle">@style/ButtonStyle</item>
        <item name="android:editTextStyle">@style/EditTextStyle</item>
    </style>

    <style name="NumberKeyboardButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:background">@drawable/shape_6dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/keyboard_number</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextViewStyle">
        <item name="android:textColor">@color/main_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:background">@drawable/selector_button</item>
        <item name="android:textColor">@color/main_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:textColorHint">@color/input_word</item>
        <item name="android:textColor">@color/main_text</item>
        <item name="android:cursorVisible">true</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:textCursorDrawable">@drawable/shape_edittext_cursor</item>
    </style>

    <style name="CustomTabText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item> <!-- 设置字体大小 -->
    </style>

    <style name="KeyboardSideTextView">
        <item name="android:textColor">@color/keyboard_number</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="betSlipTabText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item> <!-- 设置字体大小 -->
    </style>

</resources>