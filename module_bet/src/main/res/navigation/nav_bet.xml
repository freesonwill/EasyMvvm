<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_bet">

    <fragment
        android:id="@+id/singleBetFragment"
        android:name="arch.cayenne.module.bet.ui.fragment.SingleBetFragment"
        android:label="SingleBetFragment"
        tools:layout="@layout/fragment_single_bet">
        <action
            android:id="@+id/action_singleBetFragment_to_singleBetResultFragment"
            app:destination="@id/betResultFragment"
            app:popUpToInclusive="true"
            app:popUpTo="@id/singleBetFragment" />
        <action
            android:id="@+id/action_singleBetFragment_to_betResultFragment"
            app:destination="@id/betResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/comboBetFragment"
        android:name="arch.cayenne.module.bet.ui.fragment.ComboBetFragment"
        android:label="ComboBetFragment"
        tools:layout="@layout/fragment_combo_bet">
        <action
            android:id="@+id/action_comboBetFragment_to_singleBetFragment"
            app:destination="@id/singleBetFragment"
            app:popUpToInclusive="true"
            app:popUpTo="@id/comboBetFragment" />
        <action
            android:id="@+id/action_comboBetFragment_to_betResultFragment"
            app:destination="@id/betResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/betResultFragment"
        android:name="arch.cayenne.module.bet.ui.fragment.BetResultFragment"
        android:label="SingleBetResultFragment"
        tools:layout="@layout/fragment_bet_result" >
        <action
            android:id="@+id/action_betResultFragment_to_singleBetFragment"
            app:destination="@id/singleBetFragment" />
        <action
            android:id="@+id/action_betResultFragment_to_comboBetFragment"
            app:destination="@id/comboBetFragment" />
    </fragment>


</navigation>