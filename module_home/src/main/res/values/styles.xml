<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="HomeTabLayoutTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="OddsShortNameStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/selector_odds_title_color</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="OddsTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/selector_odds_text_color</item>
        <item name="android:gravity">center</item>
    </style>
</resources>