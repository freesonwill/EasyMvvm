<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_home"
    app:startDestination="@id/homeFragment">


    <fragment
        android:id="@+id/homeFragment"
        android:name="arch.cayenne.module.home.ui.fragment.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_secondFragment"
            app:destination="@id/secondFragment"
            />
           <!-- app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true"-->
        <action
            android:id="@+id/action_homeFragment_to_LoginActivity"
            app:destination="@id/LoginActivity"
            >
            <argument
                android:name="userId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </action>

        <action
            android:id="@+id/action_homeFragment_to_LoginActivity2"
            app:destination="@id/LoginActivity2" />

        <action
            android:id="@+id/action_homeFragment_to_newHomeFragment"
            app:destination="@id/newHomeFragment" />

    </fragment>


    <!--  隐式调用其他模块的activity -->
    <activity
        android:id="@+id/LoginActivity"
        android:label="activity_home"
        app:targetPackage="${applicationId}"
        app:data="walisport://login_activity"
        >
        <argument
            android:name="userId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
         <deepLink app:uri="walisport://login_activity?userId={userId}" />
    </activity>

    <activity
        android:id="@+id/LoginActivity2"
        android:label="activity_home"
        app:dataPattern="walisport://login_activity?userId={userId}"
        app:targetPackage="${applicationId}">
        <argument
            android:name="userId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <deepLink
            app:action="walisport.intent.action.login_activity"
            app:uri="walisport://login_activity?userId={userId}" />
    </activity>


    <fragment
        android:id="@+id/secondFragment"
        android:name="arch.cayenne.module.home.test.SecondFragment"
        android:label="fragment_second"
        tools:layout="@layout/fragment_test_second"
        >
        <argument
            android:name="userId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_secondFragment_to_thirdFragment"
            app:destination="@id/thirdFragment" />
    </fragment>


    <activity
        android:id="@+id/homeActivity"
        android:name="arch.cayenne.module.home.ui.HomeActivity"
        android:label="activity_home"
        />
    <fragment
        android:id="@+id/thirdFragment"
        android:name="arch.cayenne.module.home.test.ThirdFragment"
        android:label="fragment_third"
        tools:layout="@layout/fragment_test_third" >
        <action
            android:id="@+id/action_thirdFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpToInclusive="true"
            app:popUpTo="@id/homeFragment"
            />
    </fragment>

    <fragment
        android:id="@+id/viewPagerFragment"
        android:name="arch.cayenne.module.home.test.ViewPagerFragment"
        android:label="ViewPagerFragment"
        >
        <action
            android:id="@+id/action_viewPagerItem2Fragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpToSaveState="true"
            app:restoreState="true"
            />
    </fragment>

    <fragment
        android:id="@+id/newHomeFragment"
        android:name="arch.cayenne.module.home.ui.fragment.NewHomeFragment"
        android:label="NewHomeFragment"
        >
        <action
            android:id="@+id/action_newHomeFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpToSaveState="true"
            app:restoreState="true"
            />
    </fragment>


</navigation>