<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_round_top">

    <View
        android:id="@+id/view_tournament_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/drawer_scrim_color"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_tournament_section_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_52"
        android:layout_marginStart="@dimen/dp_17"
        android:paddingTop="@dimen/dp_16"
        android:text="@string/tournament_section_title"
        android:textColor="@color/home_main_text"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="選聯賽" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/ll_search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:background="@drawable/home_search_rounded_background"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tournament_section_title" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_search_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/search_icon"
        app:layout_constraintBottom_toBottomOf="@id/ll_search_bar"
        app:layout_constraintEnd_toStartOf="@id/ce_search"
        app:layout_constraintStart_toStartOf="@id/ll_search_bar"
        app:layout_constraintTop_toTopOf="@id/ll_search_bar" />

    <arch.cayenne.lib.common.ui.view.ClearableEditText
        android:id="@+id/ce_search"
        style="@style/CustomToolbarEditStyle"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:drawablePadding="@dimen/dp_10"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:textColor="@color/tournament_list_search_text"
        android:textColorHint="@color/tournament_list_search_hint"
        app:layout_constraintBottom_toBottomOf="@id/ll_search_bar"
        app:layout_constraintEnd_toEndOf="@id/ll_search_bar"
        app:layout_constraintStart_toEndOf="@id/iv_search_icon"
        app:layout_constraintTop_toTopOf="@id/ll_search_bar"
        tools:ignore="MissingConstraints" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_home_league_collapse"
        android:layout_width="63dp"
        android:layout_height="@dimen/dp_52"
        android:paddingStart="25dp"
        android:paddingEnd="0dp"
        android:paddingTop="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_14"
        android:src="@drawable/ic_league_tabs_collapse"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="ll_search_bar,tv_tournament_section_title, iv_search_icon, ce_search" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tournament_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_4"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar" />

    <arch.cayenne.module.home.ui.view.CustomFilterSideBarView
        android:id="@+id/ll_index_container"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginTop="@dimen/dp_52"
        android:layout_marginEnd="@dimen/dp_7"
        android:layout_marginBottom="4dp"
        android:gravity="end"
        app:showCircle="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rv_tournament_list" />

    <arch.cayenne.lib.common.ui.view.DynamicStateLayout
        android:id="@+id/cl_dynamics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar" />
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
