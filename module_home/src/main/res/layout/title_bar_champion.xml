<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dp_6"
    android:paddingEnd="@dimen/dp_6"
    tools:ignore="MissingDefaultResource">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_back"
        style="@style/CustomToolbarImgStyle"
        android:background="@drawable/universal_icon_back"
        tools:ignore="MissingConstraints" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_competition_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dp_5"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/title_bar"
            android:textFontWeight="500"
            android:textSize="15sp"
            tools:ignore="MissingConstraints"
            tools:targetApi="p" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/includedLayout"
        layout="@layout/layout_money_bar" />
</arch.cayenne.lib.skin.widget.SkinnableLinearLayout>