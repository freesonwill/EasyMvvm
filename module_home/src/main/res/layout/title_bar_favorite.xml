<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CustomToolbarStyle"
    android:background="@color/title_bg">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_back"
        style="@style/CustomToolbarImgStyle"
        app:srcCompat="@drawable/bg_left_arrow"
        tools:ignore="MissingConstraints" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title_name"
        style="@style/CustomToolbarTvStyle"
        android:text="@string/favorite_title"
        android:textColor="@color/title_bar"
        tools:ignore="MissingConstraints" />

    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/ll_wallet_entry"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_wallet_entry"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tvMoney"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_18"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="7dp"
            android:fontFamily="@font/sf_pro_display_regular"
            android:textColor="@color/home_main_text"
            android:textSize="13sp"
            tools:text="$1,100.00" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_wallet_add"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/bg_wallet_add"
            android:padding="@dimen/dp_3"
            android:src="@drawable/ic_wallet_add" />
    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>