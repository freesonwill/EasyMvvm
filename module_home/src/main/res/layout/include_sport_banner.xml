<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="172dp"
    android:layout_height="111dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginEnd="@dimen/dp_11">



    <com.youth.banner.Banner
        android:id="@+id/vp_sport_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tran_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <arch.cayenne.lib.common.ui.view.GameRoundProgressBar
        android:id="@+id/pb_sport_banner"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="30dp"
        android:layout_height="5dp"
        android:layout_marginTop="@dimen/dp_7"
        android:layout_marginEnd="@dimen/dp_8"
        android:indeterminate="false"
        android:progressDrawable="@null"
        app:backgroundColor="@color/color_1FFFFFFF"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressColor="@color/color_D9D9D9"
        app:triggerTime="2000" />
</androidx.constraintlayout.widget.ConstraintLayout>

