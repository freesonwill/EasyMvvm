        <!--                android:textColor="@color/brand_color"-->
        <!--                android:textSize="15sp"-->
        <!--                tools:text="1" />-->
        <!--        </LinearLayout>-->

        <!-- 觀看人數/直播 -->
        <LinearLayout
            android:id="@+id/layout_live_entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <arch.cayenne.lib.skin.widget.SportImageView
                android:id="@+id/iv_live"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_live_video" />

            <arch.cayenne.lib.skin.widget.SportTextView
                android:id="@+id/tv_watch_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dp_10"
                android:textColor="@color/main_text"
                android:textSize="12sp"
                tools:text="127" />

            <arch.cayenne.lib.skin.widget.SportImageView
                android:id="@+id/iv_arrow"
                android:layout_width="9dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_arrow" />
        </LinearLayout>
    </arch.cayenne.lib.skin.widget.SportConstraintLayout>


    <!-- 垂直分隔 guideline -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.46" />

    <!-- 賠率標題 -->
    <GridLayout
        android:id="@+id/layout_odds_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="43dp"
        android:layout_marginBottom="8dp"
        android:paddingEnd="@dimen/dp_14"
        android:columnCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_vertical"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_odds_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:paddingEnd="@dimen/dp_14"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintEnd_toEndOf="@+id/layout_odds_title"
        app:layout_constraintStart_toEndOf="@id/guideline_vertical"
        app:layout_constraintTop_toBottomOf="@id/layout_odds_title"
        app:spanCount="3" />

    <arch.cayenne.lib.skin.widget.SportImageView
        android:id="@+id/iv_favorite"
        android:layout_width="@dimen/dp_46"
        android:layout_height="@dimen/dp_34"
        android:paddingBottom="@dimen/dp_10"
        android:paddingTop="@dimen/dp_2"
        android:paddingEnd="@dimen/dp_12"
        android:src="@drawable/selector_favorite_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</arch.cayenne.lib.skin.widget.SportConstraintLayout>