<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="213dp"
    android:layout_marginHorizontal="@dimen/dp_10"
    android:background="@mipmap/bg_match_card"
    android:orientation="vertical">

    <!-- 頂部賽事名稱 -->
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_tournament_icon"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_tournament_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_3"
        android:ellipsize="end"
        android:maxWidth="@dimen/dp_310"
        android:paddingBottom="@dimen/dp_1"
        android:singleLine="true"
        android:textColor="@color/home_secondary_text"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_tournament_icon"
        app:layout_constraintStart_toEndOf="@id/iv_tournament_icon"
        app:layout_constraintTop_toTopOf="@id/iv_tournament_icon"
        tools:text="2026美加墨世界盃2026美加墨世界盃2026美加墨世界盃2026美加墨世界盃" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_odds_title_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="42dp" />

    <!-- 垂直分隔 guideline -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="161dp" />

    <!-- 上下半場 + 比賽時間 -->
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_left_info_entry"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="0dp"
        app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top" />

    <Space
        android:id="@+id/space_before_roll"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_roll"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:background="@drawable/bg_match_item_card_roll"
        android:gravity="center"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8"
        android:text="@string/match_item_roll_title"
        android:textColor="@color/match_item_roll"
        android:textSize="@dimen/sp_13"
        app:layout_constraintStart_toEndOf="@id/space_before_roll"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_game_status"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_4"
        android:gravity="center"
        android:textColor="@color/home_secondary_text"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/tv_roll"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top"
        tools:text="加時下半場" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_game_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_4"
        android:gravity="center"
        android:textColor="@color/home_secondary_text"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/tv_game_status"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top"
        tools:text="117’" />

    <!-- 賠率標題 -->
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_odds_first"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_20"
        android:gravity="center"
        android:text="@string/match_title_win"
        android:textColor="@color/home_secondary_text"
        android:textSize="@dimen/sp_13"
        app:layout_constraintEnd_toStartOf="@id/tv_odds_second"
        app:layout_constraintStart_toStartOf="@id/rv_odds_grid"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_odds_second"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_20"
        android:gravity="center"
        android:text="@string/match_title_handicap"
        android:textColor="@color/home_secondary_text"
        android:textSize="@dimen/sp_13"
        app:layout_constraintEnd_toStartOf="@id/tv_odds_third"
        app:layout_constraintStart_toEndOf="@id/tv_odds_first"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_odds_third"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_20"
        android:gravity="center"
        android:text="@string/match_title_over_under"
        android:textColor="@color/home_secondary_text"
        android:textSize="@dimen/sp_13"
        app:layout_constraintEnd_toEndOf="@id/rv_odds_grid"
        app:layout_constraintStart_toEndOf="@id/tv_odds_second"
        app:layout_constraintTop_toTopOf="@id/guide_odds_title_top" />

    <!--    賠率recyclerview、主隊、客隊  -->
    <!-- 主隊區塊 -->
    <Space
        android:id="@+id/space_team_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/space_team_away"
        app:layout_constraintEnd_toEndOf="@id/guideline_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rv_odds_grid" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_home_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@id/space_team_home"
        app:layout_constraintStart_toStartOf="@id/space_team_home"
        app:layout_constraintTop_toTopOf="@id/space_team_home"
        tools:src="@drawable/ic_default_team" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_home_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="@dimen/dp_2"
        android:textColor="@color/home_main_text"
        android:textSize="14sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/space_team_home"
        app:layout_constraintEnd_toStartOf="@id/tv_home_score"
        app:layout_constraintStart_toEndOf="@id/iv_home_icon"
        app:layout_constraintTop_toTopOf="@id/space_team_home"
        tools:text="馬恩島" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_home_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_12"
        android:gravity="center_vertical"
        android:textColor="@color/match_card_score"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/space_team_home"
        app:layout_constraintEnd_toEndOf="@id/space_team_home"
        app:layout_constraintTop_toTopOf="@id/space_team_home"
        tools:text="1" />

    <!-- 客隊區塊 -->
    <Space
        android:id="@+id/space_team_away"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/space_team_blank"
        app:layout_constraintEnd_toEndOf="@id/guideline_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/space_team_home" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_away_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@id/space_team_away"
        app:layout_constraintStart_toStartOf="@id/space_team_away"
        app:layout_constraintTop_toTopOf="@id/space_team_away"
        tools:src="@drawable/ic_default_team" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_away_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/home_main_text"
        android:textSize="14sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/space_team_away"
        app:layout_constraintEnd_toStartOf="@id/tv_away_score"
        app:layout_constraintStart_toEndOf="@id/iv_away_icon"
        app:layout_constraintTop_toTopOf="@id/space_team_away"
        tools:text="阿根廷" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_away_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_12"
        android:gravity="center_vertical"
        android:textColor="@color/match_card_score"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/space_team_away"
        app:layout_constraintEnd_toEndOf="@id/space_team_away"
        app:layout_constraintTop_toTopOf="@id/space_team_away"
        tools:text="1" />

    <Space
        android:id="@+id/space_team_blank"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/rv_odds_grid"
        app:layout_constraintEnd_toEndOf="@id/guideline_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/space_team_away" />

    <!--   賠率 column recyclerview   -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_odds_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_9"
        android:layout_marginEnd="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_10"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_odds_first"
        app:spanCount="3"
        tools:listitem="@layout/item_odds_column" />

    <!-- 觀看人數/直播 -->
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_live_animation"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_10"
        android:stateListAnimator="@animator/layout_alpha_animator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_live_video"
        app:layout_constraintStart_toStartOf="parent"
        tools:src="@drawable/ic_live_animation_disabled" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_live_video"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:stateListAnimator="@animator/layout_alpha_animator"
        app:layout_constraintBottom_toBottomOf="@id/iv_live_animation"
        app:layout_constraintEnd_toStartOf="@id/tv_watch_count"
        app:layout_constraintStart_toEndOf="@id/iv_live_animation"
        app:layout_constraintTop_toTopOf="@id/iv_live_animation"
        tools:src="@drawable/ic_live_video_disabled" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_watch_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/dp_10"
        android:textColor="@color/home_main_text"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_live_animation"
        app:layout_constraintEnd_toStartOf="@id/iv_arrow"
        app:layout_constraintStart_toEndOf="@id/iv_live_video"
        app:layout_constraintTop_toTopOf="@id/iv_live_animation"
        tools:text="127" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_arrow"
        android:layout_width="9dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_arrow"
        android:stateListAnimator="@animator/layout_alpha_animator"
        app:layout_constraintBottom_toBottomOf="@id/iv_live_animation"
        app:layout_constraintStart_toEndOf="@id/tv_watch_count"
        app:layout_constraintTop_toTopOf="@id/iv_live_animation" />

    <!--  收藏按鈕  -->
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_favorite"
        android:layout_width="29dp"
        android:layout_height="24dp"
        android:paddingTop="@dimen/dp_10"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/dp_15"
        android:src="@drawable/layer_favorite_crossfade"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>