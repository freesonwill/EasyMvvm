<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SportConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_match_card"
    android:layout_width="match_parent"
    android:layout_height="213dp"
    android:background="@drawable/bg_match_item_card">

    <!-- 頂部賽事名稱 -->
    <arch.cayenne.lib.skin.widget.SportImageView
        android:id="@+id/iv_tournament_icon"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_6"
        android:src="@drawable/ic_ucl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/secondary_text" />

    <arch.cayenne.lib.skin.widget.SportTextView
        android:id="@+id/tv_tournament_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_3"
        android:paddingBottom="@dimen/dp_1"
        android:textColor="@color/secondary_text"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_tournament_icon"
        app:layout_constraintStart_toEndOf="@id/iv_tournament_icon"
        app:layout_constraintTop_toTopOf="@id/iv_tournament_icon"
        tools:text="2026美加墨世界盃" />

    <arch.cayenne.lib.skin.widget.SportConstraintLayout
        android:id="@+id/cl_left_info_entry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_tournament_icon">
        <!-- 上下半場 + 比賽時間 -->
        <arch.cayenne.lib.skin.widget.SportTextView
            android:id="@+id/tv_game_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="加時下半場" />

        <arch.cayenne.lib.skin.widget.SportTextView
            android:id="@+id/tv_game_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_4"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_game_status"
            app:layout_constraintStart_toEndOf="@+id/tv_game_status"
            app:layout_constraintTop_toTopOf="@+id/tv_game_status"
            tools:text="117’" />

        <!-- 主隊區塊 -->
        <arch.cayenne.lib.skin.widget.SportConstraintLayout
            android:id="@+id/layout_home_team"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_game_time">

            <arch.cayenne.lib.skin.widget.SportImageView
                android:id="@+id/iv_home_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_baseball_active"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SportTextView
                android:id="@+id/tv_home_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/main_text"
                android:textSize="14sp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_home_score"
                app:layout_constraintStart_toEndOf="@id/iv_home_icon"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="馬恩島" />

            <arch.cayenne.lib.skin.widget.SportTextView
                android:id="@+id/tv_home_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_12"
                android:gravity="center_vertical"
                android:textColor="@color/brand_color"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="1" />

        </arch.cayenne.lib.skin.widget.SportConstraintLayout>

        <!-- 客隊區塊 -->
        <arch.cayenne.lib.skin.widget.SportConstraintLayout
            android:id="@+id/layout_away_team"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_home_team">

            <arch.cayenne.lib.skin.widget.SportImageView
                android:id="@+id/iv_away_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_baseball_active"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SportTextView
                android:id="@+id/tv_away_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/main_text"
                android:textSize="14sp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_away_score"
                app:layout_constraintStart_toEndOf="@id/iv_away_icon"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="阿根廷" />

            <arch.cayenne.lib.skin.widget.SportTextView
                android:id="@+id/tv_away_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_12"
                android:gravity="center_vertical"
                android:textColor="@color/brand_color"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="1" />
        </arch.cayenne.lib.skin.widget.SportConstraintLayout>

        <!--        <LinearLayout-->
        <!--            android:id="@+id/layout_away_team"-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_height="wrap_content"-->
