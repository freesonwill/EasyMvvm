<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout_sub_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/apl_home_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Banner 元件 -->
        <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
            android:id="@+id/ll_banner"
            android:layout_width="match_parent"
            android:layout_height="131dp"
            android:background="@color/color_1E1E1E"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:layout_width="wrap_content"
                android:layout_height="110dp"
                android:layout_marginEnd="@dimen/dp_11"
                android:src="@drawable/ad1" />

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:layout_width="wrap_content"
                android:layout_height="110dp"
                android:src="@drawable/vip" />

        </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_second_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 球種選擇 (固定不變的二級導航) -->
            <arch.cayenne.lib.skin.widget.SkinnableView
                android:id="@+id/view_second_navbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_66"
                android:background="@color/bg_card"
                android:clipChildren="true"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
                android:id="@+id/rv_sports_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_sport_list_rounded"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="0dp"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="@id/view_second_navbar"
                app:layout_constraintEnd_toStartOf="@id/v_mask"
                app:layout_constraintStart_toStartOf="@id/view_second_navbar"
                app:layout_constraintTop_toTopOf="@id/view_second_navbar" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:id="@+id/v_mask"
                android:layout_width="@dimen/dp_6"
                android:layout_height="0dp"
                android:background="@color/bg_card"
                app:layout_constraintBottom_toBottomOf="@id/view_second_navbar"
                app:layout_constraintEnd_toEndOf="@id/cl_second_guide"
                app:layout_constraintTop_toTopOf="@id/view_second_navbar" />

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:layout_width="14dp"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/dp_4"
                android:src="@drawable/gradient_sport_list"
                app:layout_constraintBottom_toBottomOf="@id/view_second_navbar"
                app:layout_constraintEnd_toEndOf="@+id/v_mask"
                app:layout_constraintTop_toTopOf="@id/view_second_navbar" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/cl_second_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="144dp" />

            <!-- 收藏 -->
            <FrameLayout
                android:id="@+id/frame_favorite_click_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="4.5dp"
                app:layout_constraintBottom_toBottomOf="@id/view_second_navbar"
                app:layout_constraintEnd_toStartOf="@id/frame_search_click_area"
                app:layout_constraintStart_toStartOf="@id/cl_second_guide"
                app:layout_constraintTop_toTopOf="@id/view_second_navbar"
                app:layout_constraintVertical_chainStyle="packed">

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_favorite_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="@dimen/dp_8"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_favorite" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_favorite_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="@dimen/dp_5"
                    android:text="@string/favorite_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />

            </FrameLayout>

            <!-- 搜索 -->
            <FrameLayout
                android:id="@+id/frame_search_click_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/view_second_navbar"
                app:layout_constraintEnd_toStartOf="@id/frame_bet_click_area"
                app:layout_constraintStart_toEndOf="@id/frame_favorite_click_area"
                app:layout_constraintTop_toTopOf="@id/view_second_navbar">

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="@dimen/dp_8"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_search" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_search_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="@dimen/dp_5"
                    android:text="@string/search_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />

            </FrameLayout>

            <!-- 注單 -->
            <FrameLayout
                android:id="@+id/frame_bet_click_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="4.5dp"
                app:layout_constraintBottom_toBottomOf="@id/view_second_navbar"
                app:layout_constraintEnd_toEndOf="@id/view_second_navbar"
                app:layout_constraintStart_toEndOf="@id/frame_search_click_area"
                app:layout_constraintTop_toTopOf="@id/view_second_navbar">

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_bet_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="@dimen/dp_8"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_bet" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_bet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="@dimen/dp_5"
                    android:text="@string/bet_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />

            </FrameLayout>
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <arch.cayenne.module.home.ui.view.ClickSearchConstraintLayout
        android:id="@+id/cl_sub_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <include
            android:id="@+id/layout_container"
            layout="@layout/view_home_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableView
            android:id="@+id/v_league_more_mask"
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_52"
            android:layout_marginEnd="@dimen/dp_130"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_14"
            android:background="@drawable/gradient_btn_mask"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
            android:id="@+id/ll_tournament_sort"
            android:layout_width="51dp"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_7"
            android:layout_marginBottom="@dimen/dp_3"
            android:background="@drawable/shape_tournament_more_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/v_league_more_mask"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_league_more_mask">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_tournament_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_1"
                android:text="@string/tournament_section_title_hot"
                android:textColor="@color/color_C0C0C0"
                android:textSize="@dimen/sp_14" />

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginTop="@dimen/dp_2"
                android:layout_marginBottom="@dimen/dp_1"
                android:src="@drawable/ic_tournament_expand" />
        </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
        <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
            android:id="@+id/ll_btn_tournament"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_32"
            android:layout_marginEnd="@dimen/dp_7"
            android:background="@drawable/shape_tournament_more_bg"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/ll_tournament_sort"
            app:layout_constraintEnd_toStartOf="@+id/ll_tournament_sort"
            app:layout_constraintTop_toTopOf="@+id/ll_tournament_sort">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_btn_tournament"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dp_6"
                android:layout_marginEnd="@dimen/dp_2"
                android:text="@string/home_tournament_list"
                android:textColor="@color/color_C0C0C0"
                android:textSize="@dimen/sp_14" />

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:layout_width="16dp"
                android:layout_height="15dp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/dp_2"
                android:layout_marginBottom="@dimen/dp_1"
                android:src="@drawable/ic_tournament_list" />
        </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

        <FrameLayout
            android:id="@+id/ll_tournaments_dropdown"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/fl_champion_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </arch.cayenne.module.home.ui.view.ClickSearchConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>