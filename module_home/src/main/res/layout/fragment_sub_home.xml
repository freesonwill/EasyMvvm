<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.module.home.ui.view.ClickSearchConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_sub_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_second_navbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_66"
        android:background="@drawable/bg_sport_list"
        android:clipChildren="true"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >
        <!-- 球種選擇 (固定不變的二級導航) -->

        <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
            android:id="@+id/rv_sports_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sport_list"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_second_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableView
            android:layout_width="@dimen/dp_28"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_sport_list"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/rv_sports_list"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_second_right"
            android:layout_width="@dimen/dp_144"
            android:layout_height="match_parent"
            android:background="@color/bg_card"
            android:paddingEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <!-- 收藏 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_favorite_entry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/dp_1"
                android:paddingStart="@dimen/dp_6"
                android:paddingEnd="@dimen/dp_7"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_search_entry"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/tv_favorite_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="fitCenter"
                    android:paddingStart="@dimen/dp_1"
                    android:paddingBottom="@dimen/dp_1"
                    android:src="@drawable/ic_home_favorite" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_favorite_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/favorite_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 搜索 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_search_entry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_6"
                android:paddingTop="@dimen/dp_1"
                android:paddingEnd="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_bet_entry"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/tv_search_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:paddingStart="@dimen/dp_1"
                    android:paddingBottom="@dimen/dp_1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_search" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_search_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/search_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 注單 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_bet_entry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="@dimen/dp_1"
                android:paddingEnd="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/tv_bet_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:paddingStart="@dimen/dp_1"
                    android:paddingBottom="@dimen/dp_1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_bet" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/tv_bet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/bet_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    <include
        android:id="@+id/layout_container"
        layout="@layout/view_home_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_second_navbar" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/v_league_more_mask"
        android:layout_width="70dp"
        android:layout_height="@dimen/dp_52"
        android:background="@drawable/gradient_league_tab_more"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_second_navbar" />

    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/ll_home_tournament_more"
        android:layout_width="@dimen/dp_62"
        android:layout_height="@dimen/dp_34"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_4"
        android:background="@drawable/shape_tournament_more_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/v_league_more_mask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_league_more_mask">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_tournament_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/dp_4"
            android:layout_marginBottom="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_2"
            android:text="@string/home_tournament_more"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/sp_14" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_2"
            android:src="@drawable/ic_tournament_more" />
    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_tournament_more"
        android:layout_width="@dimen/dp_52"
        android:layout_height="@dimen/dp_52"
        android:paddingStart="@dimen/dp_18"
        android:paddingTop="@dimen/dp_13"
        android:paddingEnd="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_15"
        android:src="@drawable/ic_league_tabs_expand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/v_league_more_mask"
        app:layout_constraintTop_toTopOf="@+id/v_league_more_mask" />

    <View
        android:id="@+id/view_calendar_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/drawer_scrim_color"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <FrameLayout
        android:id="@+id/ll_calendar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent" />

    <View
        android:id="@+id/v_tournament_list_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="1"
        android:background="@color/drawer_scrim_color"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_second_navbar" />

    <FrameLayout
        android:id="@+id/ll_tournaments_dropdown"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_second_navbar" />

    <FrameLayout
        android:id="@+id/fl_champion_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_second_navbar"
        app:layout_constraintBottom_toBottomOf="parent" />
</arch.cayenne.module.home.ui.view.ClickSearchConstraintLayout>