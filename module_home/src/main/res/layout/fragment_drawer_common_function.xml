<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="117dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/ic_drawer_card_bg">
    <LinearLayout
        android:id="@+id/li_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:text="常用功能"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            />
    </LinearLayout>
    <arch.cayenne.module.home.ui.view.DrawerItemView
        android:id="@+id/drawerItemRecharge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="11dp"
        android:paddingStart="26dp"
        app:drawerIconWidth="38dp"
        app:drawerIconHeight="38dp"
        app:drawerTitleHeight="18dp"
        app:drawerIcon="@drawable/ic_drawer_recharge"
        app:drawerTitle="充值"
        app:item_text_size="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/li_title"
        app:layout_constraintBottom_toBottomOf="parent" />

    <arch.cayenne.module.home.ui.view.DrawerItemView
        android:id="@+id/drawerItemCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="11dp"
        app:drawerIcon="@drawable/ic_drawer_bet_slip"
        app:drawerTitle="注单"
        app:drawerIconWidth="38dp"
        app:drawerIconHeight="38dp"
        app:drawerTitleHeight="18dp"
        app:item_text_size="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/li_title"
        app:layout_constraintBottom_toBottomOf="parent" />

    <arch.cayenne.module.home.ui.view.DrawerItemView
        android:id="@+id/drawerItemRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="11dp"
        android:paddingEnd="26dp"
        app:drawerIconWidth="38dp"
        app:drawerIconHeight="38dp"
        app:drawerTitleHeight="18dp"
        app:item_text_size="13sp"
        app:drawerTitle="教程"
        app:drawerIcon="@drawable/ic_drawer_tutorial"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/li_title"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>