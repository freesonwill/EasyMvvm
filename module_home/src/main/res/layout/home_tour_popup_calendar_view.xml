<?xml version="1.0" encoding="utf-8"?>
<!--待figma確定後再實作換肤效果-->
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_calendar_popup_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_home_calendar_background">
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/ivLeftClick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_10"
        android:padding="@dimen/dp_10"
        android:src="@drawable/img_arrow_left"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/ivRightClick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_15"
        android:padding="@dimen/dp_10"
        android:src="@drawable/img_arrow_right"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tvCurrentMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C0C0C0"
        android:textStyle="bold"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@+id/ivLeftClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivLeftClick"
        tools:text="三月 2025" />

    <com.haibin.calendarview.CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_40"
        app:calendar_height="46dp"
        app:calendar_padding="10dp"
        app:current_month_lunar_text_color="#CFCFCF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCurrentMonth"
        app:min_year="2024"
        app:current_day_text_color="#ffffff"
        app:current_month_text_color="#C0C0C0"
        app:month_view="arch.cayenne.module.home.ui.view.HomeCalendarMonthView"
        app:month_view_scrollable="false"
        app:other_month_text_color="#606060"
        app:scheme_theme_color="@android:color/transparent"
        app:scheme_text_color="#ff0000"
        app:selected_text_color="#ffffff"
        app:selected_theme_color="#00B9D4"
        app:week_background="@color/home_calendar_background"
        app:week_text_color="#C0C0C0"
        app:week_text_size="@dimen/sp_14"
        app:week_view="arch.cayenne.module.home.ui.view.HomeCalendarWeekView"
        app:day_text_size="@dimen/sp_12"
        app:week_view_scrollable="false"
        app:year_view_scrollable="false"
        app:month_view_show_mode="mode_fix"/>
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/calendarView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <arch.cayenne.lib.skin.widget.SkinnableButton
            android:id="@+id/calendar_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:gravity="center"
            android:background="@drawable/shape_home_calendar_cancel"
            android:text="@string/home_calendar_reset"
            android:textColor="@color/title_bar"
            android:textSize="@dimen/sp_13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/calendar_btn_ok"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_max="300dp"
            app:layout_constrainedWidth="true"
            />
        <arch.cayenne.lib.skin.widget.SkinnableButton
            android:id="@+id/calendar_btn_ok"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:gravity="center"
            android:background="@drawable/shape_home_calendar_ok_white_green"
            android:text="@string/home_calendar_ok"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_13"
            app:layout_constraintStart_toEndOf="@id/calendar_btn_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_max="300dp"
            app:layout_constrainedWidth="true"
            />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>