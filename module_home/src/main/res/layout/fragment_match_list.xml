<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SportLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <arch.cayenne.lib.skin.widget.SportConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tl_league_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:background="@color/bg_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabGravity="center"
            app:tabIndicator="@null"
            app:tabIndicatorColor="@null"
            app:tabIndicatorHeight="0dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/league_tab_tint_select"
            app:tabTextColor="@color/league_tab_tint_unselect" />
        <!--做更多和漸層-->
        <View
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:background="@drawable/gradient_league_tab_more"
            app:layout_constraintBottom_toBottomOf="@+id/tl_league_list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tl_league_list" />

        <ImageView
            android:id="@+id/iv_home_league_more"
            android:layout_width="@dimen/dp_22"
            android:layout_height="@dimen/dp_22"
            android:layout_marginBottom="@dimen/dp_4"
            android:src="@drawable/ic_league_tabs_more"
            app:layout_constraintBottom_toBottomOf="@+id/tl_league_list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tl_league_list" />
    </arch.cayenne.lib.skin.widget.SportConstraintLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_date_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_62"
        android:layout_marginEnd="0dp"
        android:background="@color/data_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_6"
        android:visibility="gone"
        app:tabGravity="center"
        app:tabIndicator="@null"
        app:tabIndicatorColor="@null"
        app:tabIndicatorHeight="0dp"
        app:tabMode="scrollable"
        app:tabPaddingStart="0dp"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/date_text_select"
        app:tabTextColor="@color/date_text_unselect" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_game_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/dp_8" />
</arch.cayenne.lib.skin.widget.SportLinearLayout>
