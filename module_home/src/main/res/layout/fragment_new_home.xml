<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:paddingEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:paddingStart="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_home_sidebar"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:layout_gravity="center_vertical"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:src="@drawable/ic_home_sidebar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 主導航 (包含 "今日"、"早盤"、"冠軍") -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tl_home"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_12"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_wallet_entry"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/iv_home_sidebar"
                app:layout_constraintTop_toTopOf="parent"
                app:tabGravity="start"
                app:tabIndicator="@drawable/shape_home_tab_indicator"
                app:tabIndicatorAnimationMode="linear"
                app:tabIndicatorColor="@color/tab_indicator_color"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorGravity="bottom"
                app:tabIndicatorHeight="2dp"
                app:tabMinWidth="34dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/sport_item_text_select"
                app:tabTextAppearance="@style/HomeTabLayoutTextAppearance"
                app:tabTextColor="@color/secondary_text" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_wallet_entry"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_wallet_entry"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingEnd="7dp"
                android:minWidth="97dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_wallet_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_18"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="7dp"
                    android:text="$1,100.00"
                    android:textColor="@color/main_text"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/iv_wallet_add"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center_vertical|end"
                    android:background="@drawable/bg_wallet_add"
                    android:padding="@dimen/dp_3"
                    android:src="@drawable/ic_wallet_add" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <arch.cayenne.lib.skin.widget.SportConstraintLayout
            android:id="@+id/cl_second_navbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_66">
            <!-- 球種選擇 (固定不變的二級導航) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sports_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sport_list"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_favorite_entry"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="23dp"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_sport_list"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/rv_sports_list"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 收藏 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_favorite_entry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.13"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_search_entry"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/tv_favorite_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_favorite" />

                <TextView
                    android:id="@+id/tv_favorite_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 搜索 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_search_entry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.13"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_bet_entry"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/tv_search_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_search" />

                <TextView
                    android:id="@+id/tv_search_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 注單 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_bet_entry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.13"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="5dp"
                android:paddingEnd="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/tv_bet_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home_bet" />

                <TextView
                    android:id="@+id/tv_bet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bet_title"
                    android:textColor="@color/secondary_title"
                    android:textSize="12sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

        </arch.cayenne.lib.skin.widget.SportConstraintLayout>

        <!-- 內容區域 (ViewPager2 負責載入 "今日"、"早盤"、"冠軍") -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_home"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/floating_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
