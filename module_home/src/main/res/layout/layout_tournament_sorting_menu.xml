<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="106dp"
    android:background="@drawable/shape_sorting_menu_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_18"
    android:paddingTop="@dimen/dp_17"
    android:paddingBottom="@dimen/dp_12">

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_sort_by_hot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="按热门联赛排序"
        android:textColor="@color/color_00E0E5"
        android:textSize="@dimen/sp_15" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_sort_by_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/dp_2"
        android:gravity="center_vertical"
        android:text="按比赛时间排序"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_15" />

</arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

