<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_1E1E1E">

    <arch.cayenne.lib.common.ui.view.CustomGameTabGroupLayout
        android:id="@+id/custom_tab_group"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_14"
        app:defaultTabIcon="@drawable/ic_wali_demo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabIconSize="@dimen/dp_25" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_game_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/custom_tab_group" />

    <!-- 蒙層視圖 -->
    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/v_game_list_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="#BF000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/custom_tab_group" />

    <!-- 排序選單下拉容器 -->
    <FrameLayout
        android:id="@+id/ll_tournaments_dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/custom_tab_group" />

</androidx.constraintlayout.widget.ConstraintLayout>
