<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_popup_slot"
        android:layout_width="@dimen/dp_38"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/popup_slot_placeholder"
        app:shapeAppearanceOverlay="@style/PopUpSlotRoundedCorner" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_popup_slot_close"
        android:layout_width="@dimen/dp_33"
        android:layout_height="@dimen/dp_33"
        android:padding="@dimen/dp_9"
        android:scaleType="fitXY"
        android:src="@drawable/popup_slot_close" />


</androidx.appcompat.widget.LinearLayoutCompat>