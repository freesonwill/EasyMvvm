<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SportBackgroundHelper">
        <attr name="android:background"/>
    </declare-styleable>

    <declare-styleable name="SportImageView">
        <attr name="android:src"/>
        <attr format="reference" name="srcCompat"/>
        <attr name="android:radius" format="float"/>
    </declare-styleable>


    <declare-styleable name="SportTextHelper">
        <attr name="android:drawableLeft"/>
        <attr name="android:drawableTop"/>
        <attr name="android:drawableRight"/>
        <attr name="android:drawableBottom"/>
        <attr name="android:drawableStart"/>
        <attr name="android:drawableEnd"/>
        <attr name="android:textAppearance"/>
        <attr name="android:text"/>
    </declare-styleable>


    <declare-styleable name="SportTextAppearance">
        <attr name="android:textSize"/>
        <attr name="android:textColor"/>
        <attr name="android:textColorHint"/>
        <attr name="android:textStyle"/>
        <attr name="android:typeface"/>
        <attr name="textAllCaps"/>
        <attr name="android:shadowColor"/>
        <attr name="android:shadowDy"/>
        <attr name="android:shadowDx"/>
        <attr name="android:shadowRadius"/>
    </declare-styleable>

    <declare-styleable name="SportTabLayoutHelper">
        <attr format="reference" name="tabBackground"/>
        <attr format="color" name="tabIndicatorColor"/>
        <attr format="color" name="tabTextColor"/>
        <attr format="color" name="tabSelectedTextColor"/>
    </declare-styleable>
</resources>