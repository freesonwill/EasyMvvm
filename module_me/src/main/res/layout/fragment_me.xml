<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.common.ui.view.InterceptedConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fitsSystemWindows="false"
    app:interceptedDirection="RIGHT">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/bgLightSet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_335"
        android:alpha="0.3"
        android:background="@drawable/bg_light_set" />

    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/llContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44">

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:id="@+id/iv_drawer"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_12"
                android:src="@drawable/ic_me_drawer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/dot_ham"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/shape_8dp"
                android:backgroundTint="@color/color_FE3666"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/iv_drawer"
                app:layout_constraintTop_toTopOf="@id/iv_drawer" />

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:id="@+id/iv_customer"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_20"
                android:src="@drawable/icon_customer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_setting"
                app:layout_constraintTop_toTopOf="parent" />


            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:id="@+id/iv_setting"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_12"
                android:src="@drawable/ic_me_settings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_54"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12">

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="@dimen/dp_54"
                android:layout_height="@dimen/dp_54"
                android:src="@drawable/ic_avatar_default"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_4"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintTop_toTopOf="parent"
                app:skinnableFontWeight="600" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_join_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_4"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/sp_12"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintTop_toBottomOf="@id/tv_nickname"
                app:skinnableFontWeight="500" />


            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/ct_vip_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_190"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_10">

            <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                android:id="@+id/ct_level_info"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_120"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_16"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_24"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_vip_entry"
                    android:layout_width="@dimen/dp_70"
                    android:layout_height="@dimen/dp_21"
                    android:layout_marginStart="@dimen/dp_10"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_vip_entry"
                    app:layout_constraintBottom_toBottomOf="@id/tv_level"
                    app:layout_constraintStart_toEndOf="@+id/tv_level"
                    app:layout_constraintTop_toTopOf="@+id/tv_level" />


                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_level"
                    android:layout_width="@dimen/dp_63"
                    android:layout_height="@dimen/dp_68"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_level_name"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_15"
                    android:layout_marginEnd="@dimen/dp_33"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>


        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>


    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
</arch.cayenne.lib.common.ui.view.InterceptedConstraintLayout>