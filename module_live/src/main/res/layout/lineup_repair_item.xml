<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp_12"
    android:paddingStart="@dimen/dp_12"
    android:paddingTop="@dimen/dp_6"
    android:paddingBottom="@dimen/dp_6"
    android:background="@color/tran_0"
   >
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="32dp"
      android:layout_marginTop="@dimen/dp_3"
      android:layout_height="wrap_content"
      tools:ignore="MissingConstraints">

    <!-- 红点和数字 -->
    <ImageView
        android:id="@+id/profile_image"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:background="@drawable/lineup_head"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/notification_badge"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:background="@drawable/circle_badge_blue"
        android:gravity="center"
        android:text="12"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints" />
  </androidx.constraintlayout.widget.ConstraintLayout>



  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="0dp"
    android:layout_weight="1"
      android:orientation="vertical"
      android:layout_height="wrap_content">
    <arch.cayenne.lib.skin.widget.SportTextView
        android:layout_marginStart="7dp"
        android:layout_width="wrap_content"
        android:text="meixi"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/substitution_text_color"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginStart="7dp"
        android:layout_width="wrap_content"
        android:text="qianfeng"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_929298"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />

  </androidx.appcompat.widget.LinearLayoutCompat>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="0dp"
      android:layout_weight="1"
      android:gravity="right"
      android:orientation="vertical"
      android:layout_height="wrap_content">
    <arch.cayenne.lib.skin.widget.SportTextView
        android:layout_marginEnd="7dp"
        android:layout_width="wrap_content"
        android:text="meixi"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/substitution_text_color"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginEnd="7dp"
        android:layout_width="wrap_content"
        android:text="qianfeng"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_929298"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />

  </androidx.appcompat.widget.LinearLayoutCompat>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="32dp"
      android:layout_marginTop="@dimen/dp_3"
      android:layout_height="wrap_content"
      tools:ignore="MissingConstraints">

    <!-- 红点和数字 -->
    <ImageView
        android:id="@+id/profile_image_right"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:background="@drawable/lineup_head"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/notification_badge_right"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:background="@drawable/circle_badge"
        android:gravity="center"
        android:text="12"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>