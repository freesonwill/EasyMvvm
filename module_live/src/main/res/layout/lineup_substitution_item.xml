<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp_12"
    android:paddingStart="@dimen/dp_12"
    android:paddingTop="@dimen/dp_6"
    android:paddingBottom="@dimen/dp_6"
    android:id="@+id/homeIncidents"
    android:background="@color/tran_0"
   >
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="32dp"
      android:layout_marginTop="@dimen/dp_3"
      android:layout_height="wrap_content"
      tools:ignore="MissingConstraints">

    <!-- 红点和数字 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homeTopLogo"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/homeTopNumber"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:background="@drawable/circle_badge"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="MissingConstraints" />
  </androidx.constraintlayout.widget.ConstraintLayout>



  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="0dp"
    android:layout_weight="1"
      android:orientation="vertical"
      android:layout_height="wrap_content">
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/homeTopName"
        android:layout_marginStart="7dp"
        android:layout_width="wrap_content"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:maxLines="1"
        android:textColor="@color/substitution_text_color"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/homePositionName"
        android:layout_marginStart="7dp"
        android:layout_width="wrap_content"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_929298"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />

  </androidx.appcompat.widget.LinearLayoutCompat>
  <arch.cayenne.lib.skin.widget.SkinnableTextView
      android:id="@+id/homeTopBottom"
      android:gravity="center_vertical"
      android:layout_width="wrap_content"
      android:drawablePadding="7dp"
      android:textSize="@dimen/sp_14"
      android:textStyle="bold"
      android:textColor="@color/substitution_text_color"
      android:drawableLeft="@drawable/lineup_substitution_top"
      android:drawableRight="@drawable/lineup_substitution_dow"
      android:layout_height="match_parent"
      tools:ignore="MissingConstraints" />


  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="0dp"
      android:layout_weight="1"
      android:gravity="right"
      android:orientation="vertical"
      android:layout_height="wrap_content">
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/homeBottomName"
        android:layout_marginEnd="7dp"
        android:layout_width="wrap_content"
        android:maxLines="1"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/substitution_text_color"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/homeBottomPosition"
        android:layout_marginEnd="7dp"
        android:layout_width="wrap_content"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_929298"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />

  </androidx.appcompat.widget.LinearLayoutCompat>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="32dp"
      android:layout_marginTop="@dimen/dp_3"
      android:layout_height="wrap_content"
      tools:ignore="MissingConstraints">

    <!-- 红点和数字 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homeBottomLogo"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/homeBottomNumber"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:background="@drawable/circle_badge"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>