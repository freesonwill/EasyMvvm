<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.LiveChatFragment">

    <data>

        <variable
            name="viewModel"
            type="com.walisport.module.live.ui.viewmodel.LiveChatViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background">


        <androidx.constraintlayout.widget.Group
            android:id="@+id/live_chat_group_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="live_chat_iv_status,live_chat_tv_status" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/live_chat_group_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="live_chat_recycler" />

        <arch.cayenne.lib.skin.widget.SportImageView
            android:id="@+id/live_chat_iv_status"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_180"
            android:layout_marginTop="@dimen/dp_60"
            android:src="@drawable/live_chat_is_empty"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SportTextView
            android:id="@+id/live_chat_tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/live_chat_empty"
            android:textColor="@color/secondary_text"
            android:textFontWeight="500"
            android:textSize="@dimen/sp_13"
            app:layout_constraintLeft_toLeftOf="@id/live_chat_iv_status"
            app:layout_constraintRight_toRightOf="@id/live_chat_iv_status"
            app:layout_constraintTop_toBottomOf="@id/live_chat_iv_status" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/live_chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/color_909092"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@id/live_chat_keyboard"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/live_chat_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/bottom"
            />
        <View
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_34"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>