<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_thumb"
        android:layout_width="@dimen/dp_103"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/playing_bkg"
        android:layout_width="@dimen/dp_103"
        android:layout_height="@dimen/dp_60"
        android:background="@drawable/video_source_playing_bkg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/iv_thumb"
        app:layout_constraintTop_toTopOf="@id/iv_thumb">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animationView"
            android:layout_width="@dimen/dp_21"
            android:layout_height="@dimen/dp_16"
            app:lottie_autoPlay="true"
            app:lottie_fileName="playing_animation.json"
            app:lottie_loop="true" />
    </androidx.appcompat.widget.LinearLayoutCompat>


    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_4"
        android:ellipsize="end"
        android:maxWidth="@dimen/dp_130"
        android:maxLines="1"
        android:textColor="@color/video_source_item_title_color"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintStart_toEndOf="@id/iv_thumb" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_9"
        android:ellipsize="end"
        android:maxWidth="@dimen/dp_130"
        android:maxLines="1"
        android:textColor="@color/video_source_item_subtitle_color"
        android:textSize="@dimen/sp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_thumb" />


</androidx.constraintlayout.widget.ConstraintLayout>
