<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.walisport.module.live.ui.viewmodel.LiveSoftKeyboardViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/emoji_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            >

            <arch.cayenne.lib.skin.widget.SkinnableTabLayout
                android:id="@+id/keyboard_tb"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginStart="@dimen/dp_12"
                android:background="@color/card_background"
                app:layout_constraintTop_toTopOf="parent"
                app:tabBackground="@null"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="@dimen/dp_42"
                app:tabMode="scrollable"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabRippleColor="@null" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:id="@+id/line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@color/input_box_2"
                app:layout_constraintTop_toBottomOf="@id/keyboard_tb" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/keyboard_tv_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/all_emoji"
                android:textColor="@color/color_909092"
                android:textSize="@dimen/sp_12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/line" />

            <arch.cayenne.lib.common.ui.view.HorizontalRecyclerView
                android:id="@+id/keyboard_emoji_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_weight="1"
                app:layout_constraintBottom_toTopOf="@id/bottom"
                app:layout_constraintTop_toBottomOf="@id/keyboard_tv_all" />

            <View
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_34"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>