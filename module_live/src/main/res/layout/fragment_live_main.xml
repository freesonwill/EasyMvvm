<?xml version="1.0" encoding="utf-8"?>
<com.walisport.module.live.ui.widget.LiveScrollDrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:background="@color/title_bg_classic"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <arch.cayenne.lib.common.ui.view.InterceptedLinearLayout
        android:id="@+id/liveMain"
        app:interceptedDirection="RIGHT"
        app:canScrollView="@id/vp_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <arch.cayenne.lib.common.ui.view.TitleBarView
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.walisport.module.live.ui.widget.LiveMainLayout
            android:id="@+id/liveMainMl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llVideo"
                android:background="@color/menu_lin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_211">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_video"
                    android:fitsSystemWindows="false"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_211"
                    tools:ignore="MissingConstraints" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llText"
                    android:visibility="gone"
                    android:paddingEnd="@dimen/dp_13"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:orientation="horizontal"
                    android:layout_height="match_parent"
                    tools:ignore="MissingConstraints,RtlSymmetry">
                    <TextView
                        android:id="@+id/tv_video_vs"
                        android:layout_width="@dimen/dp_140"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/video_tab_text_color"
                        android:textSize="13sp"
                        />

                    <ImageView
                        android:id="@+id/restoreToInitialState"
                        android:layout_marginStart="15dp"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/live_open_video"
                        />
                    <ImageView
                        android:id="@+id/liveVideoTop"
                        android:layout_marginStart="15dp"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/live_video_top"
                        />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>



            <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
                android:id="@+id/skinTab"
                app:layout_constraintTop_toBottomOf="@id/llVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/live_main_tab_bg"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <arch.cayenne.lib.skin.widget.SkinnableTabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_marginEnd="10dp"
                    android:background="@color/live_main_tab_bg"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="60dp"
                    app:tabMinWidth="60dp"
                    app:tabMode="fixed"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingStart="0dp"
                    app:tabRippleColor="@null"
                    tools:ignore="SpeakableTextPresentCheck" />

                <arch.cayenne.lib.common.ui.view.CustomTabIndicator
                    android:id="@+id/customIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginEnd="13dp"
                    android:background="@color/live_main_tab_bg" />
            </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/ClBotton"
                app:layout_constraintTop_toBottomOf="@id/skinTab"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="match_parent"
                android:layout_weight="1"

                android:layout_height="0dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_page"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.core.widget.NestedScrollView>
        </com.walisport.module.live.ui.widget.LiveMainLayout>


    </arch.cayenne.lib.common.ui.view.InterceptedLinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="312dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:drawerLayoutCornerSize="0dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.navigation.NavigationView>

</com.walisport.module.live.ui.widget.LiveScrollDrawerLayout>