<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.common.ui.view.DynamicStateLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clDynamics"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/app_bg"
    android:orientation="vertical">
<arch.cayenne.lib.skin.widget.SkinnableLinearLayout
    android:id="@+id/liveMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <arch.cayenne.lib.common.ui.view.TitleBarView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_video"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_211" />


    <arch.cayenne.lib.skin.widget.SkinnableTabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:background="@color/live_main_tab_bg"
        android:paddingBottom="2dp"
        app:tabGravity="start"
        app:tabMode="fixed"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@null"
        tools:ignore="SpeakableTextPresentCheck" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fragment_fake_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vp_page"
        app:layout_constraintEnd_toEndOf="@id/vp_page"
        app:layout_constraintStart_toStartOf="@id/vp_page"
        app:layout_constraintTop_toTopOf="@id/vp_page" />
</arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
</arch.cayenne.lib.common.ui.view.DynamicStateLayout>