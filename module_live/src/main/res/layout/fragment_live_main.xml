<?xml version="1.0" encoding="utf-8"?>
<com.walisport.module.live.ui.widget.LiveScrollDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fitsSystemWindows="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/liveMainTopBar"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            tools:ignore="MissingConstraints">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/live_main_top_bg"
                tools:ignore="MissingConstraints" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <arch.cayenne.lib.common.ui.view.InterceptedLinearLayout
            android:id="@+id/liveMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:canScrollView="@id/vp_page"
            app:interceptedDirection="RIGHT">


            <arch.cayenne.lib.common.ui.view.TitleBarView
                android:id="@+id/titleBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="@dimen/dp_7" />

            <com.walisport.module.live.ui.widget.LiveMainLayoutScale
                android:id="@+id/liveMainScale"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="3dp"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/tran_0">

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/fragment_media"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fitsSystemWindows="false"
                        tools:ignore="MissingConstraints" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/llText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/dp_100"
                        android:paddingEnd="@dimen/dp_13"
                        android:visibility="gone"
                        tools:ignore="MissingConstraints,RtlSymmetry">

                        <TextView
                            android:id="@+id/tv_video_vs"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="333333333333"
                            android:textColor="@color/video_tab_text_color"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/restoreToInitialState"
                            android:layout_width="16dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="26dp"
                            app:srcCompat="@drawable/live_open_video" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/liveVideoTop"
                            android:layout_width="15dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="22dp"
                            android:layout_marginEnd="@dimen/dp_10"
                            app:srcCompat="@drawable/live_video_top" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_38">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
                            android:id="@+id/skinTab"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="3dp"
                            android:layout_weight="1"
                            android:background="@color/live_main_tab_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            tools:ignore="MissingConstraints">

                            <arch.cayenne.lib.skin.widget.SkinnableTabLayout
                                android:id="@+id/tabLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_36"
                                android:layout_marginTop="@dimen/dp_2"
                                android:layout_marginEnd="10dp"
                                android:background="@color/live_main_tab_bg"
                                android:focusable="false"
                                app:tabIndicatorHeight="0dp"
                                app:tabMaxWidth="60dp"
                                app:tabMinWidth="60dp"
                                app:tabMode="fixed"
                                app:tabPaddingEnd="0dp"
                                app:tabPaddingStart="0dp"
                                app:tabRippleColor="@null"
                                tools:ignore="SpeakableTextPresentCheck" />

                            <arch.cayenne.lib.common.ui.view.CustomTabIndicator
                                android:id="@+id/customIndicator"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:layout_marginEnd="13dp"
                                android:background="@color/live_main_tab_bg" />
                        </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/ll_switch_narrator"
                            android:layout_width="@dimen/dp_84"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_choose_media_source"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/dp_23"
                                android:layout_height="@dimen/dp_20"
                                android:layout_marginStart="@dimen/dp_7"
                                android:src="@drawable/ic_switch_narrator" />

                            <arch.cayenne.lib.skin.widget.SkinnableTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_5"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/choose_media_source"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_14"
                                app:skinnableFontWeight="500" />

                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View
                        android:id="@+id/viewTab"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_page"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </com.walisport.module.live.ui.widget.LiveMainLayoutScale>

        </arch.cayenne.lib.common.ui.view.InterceptedLinearLayout>

        <com.walisport.module.live.ui.widget.LiveMainLayoutInterceptTouch
            android:id="@+id/LayoutInterceptTouch"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="312dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:drawerLayoutCornerSize="0dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.navigation.NavigationView>

</com.walisport.module.live.ui.widget.LiveScrollDrawerLayout>