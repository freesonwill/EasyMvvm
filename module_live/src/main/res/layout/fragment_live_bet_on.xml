<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.LiveBetOnFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:layout_width="match_parent"
        android:gravity="center_vertical"
        android:layout_height="@dimen/dp_32">

        <arch.cayenne.lib.skin.widget.SportTabLayout
            android:id="@+id/tabLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            app:sportTabBackground="@drawable/tab_selected_background"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabRippleColor="@null"
            android:background="@color/app_bg"
            app:tabTextAppearance="@style/CustomTabText"
            app:tabTextColor="@color/live_bet_selected_text"
            app:tabIndicatorHeight="0dp"
            tools:ignore="MissingConstraints,SpeakableTextPresentCheck" />

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:src="@drawable/live_bet_on_menu"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            />

    </androidx.appcompat.widget.LinearLayoutCompat>


    <androidx.recyclerview.widget.RecyclerView
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        android:id="@+id/rvBetList"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />

</androidx.appcompat.widget.LinearLayoutCompat>