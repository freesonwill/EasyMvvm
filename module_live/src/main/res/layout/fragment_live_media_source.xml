<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="model"
            type="com.walisport.module.live.ui.viewmodel.LiveVideoPlayerViewModel" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
                android:id="@+id/ct_source"
                android:layout_width="match_parent"
                android:layout_height="@dimen/video_source_portrait_height"
                android:background="@drawable/bg_video_source_fragment"
                android:translationY="@dimen/video_source_portrait_margin_top">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_tips"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_7"
                    android:src="@drawable/video_landscape_choose_source"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_9"
                    android:text="@string/choose_source"
                    android:textColor="@color/video_source_fragment_title_color"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintStart_toEndOf="@+id/iv_tips"
                    app:layout_constraintTop_toTopOf="parent"
                    app:skinnableFontWeight="500" />


                <arch.cayenne.lib.skin.widget.SkinnableImageView
                    android:id="@+id/iv_close"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_2"
                    android:padding="@dimen/dp_10"
                    android:src="@drawable/shape_choose_source_close"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_source"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_110"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />


            </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

</layout>