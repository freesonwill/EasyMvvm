<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_47"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_progress_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/video_tab_text_color"
        android:textSize="@dimen/sp_14"
        android:layout_marginTop="@dimen/dp_15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_progress_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/standing_text"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_progress_name"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_progress_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/standing_text"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_progress_name"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_5"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableProgressBar
            android:id="@+id/pro_left"
            android:layout_width="@dimen/dp_160"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/dp_4"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressDrawable="@drawable/style_red_progress_bar"/>

        <arch.cayenne.lib.skin.widget.SkinnableProgressBar
            android:id="@+id/pro_right"
            android:layout_width="@dimen/dp_160"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_4"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressDrawable="@drawable/style_blue_progress_bar"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>