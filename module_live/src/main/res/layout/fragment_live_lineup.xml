<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SportConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_bg"
    tools:context=".ui.LiveLineupFragment">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      tools:ignore="ScrollViewCount">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="7dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        >

    <arch.cayenne.lib.skin.widget.SportLinearLayout
        android:layout_width="match_parent"
        android:layout_height="554dp"
        android:orientation="vertical"
        android:background="@drawable/live_lineup_top_bbg"
        >
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="277dp"
          android:id="@+id/sclLineupItemTop"
          >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBetTitleTop"
            android:layout_marginStart="6dp"
            android:paddingTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints">

          <arch.cayenne.lib.skin.widget.SportConstraintLayout
              android:layout_width="wrap_content"
              android:padding="5dp"
              android:background="@drawable/lineup_compare_bg"
              android:layout_height="wrap_content"
              tools:ignore="MissingConstraints">
            <ImageView
                android:id="@+id/ivNationalFlagTop"
                android:layout_width="21dp"
                android:layout_height="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/live_bet_country_icon"
                tools:ignore="MissingConstraints" />
            <androidx.appcompat.widget.AppCompatTextView
                app:layout_constraintStart_toEndOf="@id/ivNationalFlagTop"
                android:id="@+id/tvNationalNameTop"
                android:layout_marginStart="5dp"
                android:layout_width="wrap_content"
                android:text="2-3-4"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:drawablePadding="8dp"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints" />
          </arch.cayenne.lib.skin.widget.SportConstraintLayout>
          <arch.cayenne.lib.skin.widget.SportConstraintLayout
              android:layout_marginTop="19dp"
              android:layout_width="wrap_content"
              android:padding="5dp"
              app:layout_constraintRight_toRightOf="parent"
              android:background="@drawable/lineup_compare_bg"
              android:layout_height="wrap_content"
              tools:ignore="MissingConstraints">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_marginStart="5dp"
                android:layout_width="wrap_content"
                android:text="@string/live_starting_lineup"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints" />
          </arch.cayenne.lib.skin.widget.SportConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
      </RelativeLayout>
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="277dp"
          android:id="@+id/sclLineupItemBottom"
          >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBetTitleBottom"
            android:layout_margin="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints">

          <arch.cayenne.lib.skin.widget.SportConstraintLayout
              android:layout_width="wrap_content"
              android:padding="5dp"
              android:background="@drawable/lineup_compare_bg"
              android:layout_height="wrap_content"
              tools:ignore="MissingConstraints">
            <ImageView
                android:id="@+id/ivNationalFlagBottom"
                android:layout_width="21dp"
                android:layout_height="14dp"
                app:cornerRadius="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/live_bet_country_icon"
                tools:ignore="MissingConstraints" />
            <androidx.appcompat.widget.AppCompatTextView
                app:layout_constraintStart_toEndOf="@id/ivNationalFlagBottom"
                android:id="@+id/tvNationalNameBottom"
                android:layout_marginStart="5dp"
                android:layout_width="wrap_content"
                android:text="2-3-4"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:drawablePadding="8dp"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints" />
          </arch.cayenne.lib.skin.widget.SportConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

      </RelativeLayout>
    </arch.cayenne.lib.skin.widget.SportLinearLayout>

    <arch.cayenne.lib.skin.widget.SportLinearLayout
        android:layout_marginTop="10dp"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="match_parent"
        android:background="@drawable/lineup_substitution_bg"
        android:orientation="vertical"
        android:layout_height="wrap_content">

      <arch.cayenne.lib.skin.widget.SportTextView
          android:layout_margin="@dimen/dp_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="@dimen/sp_14"
          android:gravity="center_vertical"
          android:paddingStart="@dimen/dp_12"
          android:background="@drawable/lineup_substitution_title_bg"
          android:text="@string/live_substitution_lineup"
          android:textColor="@color/color_929298"
          tools:ignore="RtlSymmetry" />


      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:orientation="vertical"
          android:layout_height="wrap_content">

        <arch.cayenne.lib.skin.widget.SportTextView
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_width="wrap_content"
            android:text="法国"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/live_bet_country_icon"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/substitution_text_color"
            android:drawablePadding="8dp"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />

        <include layout="@layout/lineup_substitution_item"/>
        <include layout="@layout/lineup_substitution_item"/>
        <include layout="@layout/lineup_substitution_item"/>

      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_marginTop="@dimen/dp_30"
          android:layout_width="match_parent"
          android:orientation="vertical"
          android:layout_height="wrap_content">

        <arch.cayenne.lib.skin.widget.SportTextView
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_width="wrap_content"
            android:text="法国"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/live_bet_country_icon"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/substitution_text_color"
            android:drawablePadding="8dp"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />

        <include layout="@layout/lineup_substitution_item_blue"/>
        <include layout="@layout/lineup_substitution_item_blue"/>
        <include layout="@layout/lineup_substitution_item_blue"/>

      </androidx.appcompat.widget.LinearLayoutCompat>

    </arch.cayenne.lib.skin.widget.SportLinearLayout>

      <arch.cayenne.lib.skin.widget.SportLinearLayout
          android:layout_marginTop="10dp"
          android:paddingBottom="@dimen/dp_10"
          android:layout_width="match_parent"
          android:background="@drawable/lineup_substitution_bg"
          android:orientation="vertical"
          android:layout_height="wrap_content">

        <arch.cayenne.lib.skin.widget.SportTextView
            android:layout_margin="@dimen/dp_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_14"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_12"
            android:background="@drawable/lineup_substitution_title_bg"
            android:text="@string/live_repair_lineup"
            android:textColor="@color/color_929298"
            tools:ignore="RtlSymmetry" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

          <androidx.appcompat.widget.LinearLayoutCompat
              android:layout_width="match_parent"
              android:orientation="horizontal"
              android:layout_height="wrap_content">
            <arch.cayenne.lib.skin.widget.SportTextView
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_6"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="法国"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/live_bet_country_icon"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/substitution_text_color"
                android:drawablePadding="8dp"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints" />
            <arch.cayenne.lib.skin.widget.SportTextView
                android:layout_marginEnd="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_6"
                android:layout_width="wrap_content"
                android:text="阿根廷 "
                android:gravity="center_vertical"
                android:drawableEnd="@drawable/live_bet_country_icon"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/substitution_text_color"
                android:drawablePadding="8dp"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints" />

          </androidx.appcompat.widget.LinearLayoutCompat>


          <include layout="@layout/lineup_repair_item"/>
          <include layout="@layout/lineup_repair_item"/>
          <include layout="@layout/lineup_repair_item"/>

        </androidx.appcompat.widget.LinearLayoutCompat>


      </arch.cayenne.lib.skin.widget.SportLinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

  </ScrollView>







</arch.cayenne.lib.skin.widget.SportConstraintLayout>