<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.common.ui.view.DynamicStateLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_bg"
    android:id="@+id/main"
    tools:context=".ui.LiveLineupFragment">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      tools:ignore="ScrollViewCount">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="7dp"
        android:paddingStart="7dp"
        android:visibility="invisible"
        android:paddingEnd="7dp"
        >
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="554dp">
  <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
      android:layout_width="match_parent"
      android:layout_height="554dp"
      android:orientation="vertical"
      android:background="@drawable/live_lineup_top_bbg"
      tools:ignore="MissingConstraints">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="277dp"
        android:id="@+id/sclLineupItemTop"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="277dp"
        android:id="@+id/sclLineupItemBottom"
        />
  </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/clLiveTitleTop"
      android:layout_marginStart="6dp"
      android:paddingTop="6dp"
      android:layout_marginEnd="6dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      tools:ignore="MissingConstraints">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:layout_width="wrap_content"
        android:padding="5dp"
        android:background="@drawable/lineup_compare_bg"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">
      <ImageView
          android:id="@+id/ivNationalFlagTop"
          android:layout_width="wrap_content"
          android:scaleType="fitCenter"
          android:layout_height="20dp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          tools:ignore="MissingConstraints" />
      <androidx.appcompat.widget.AppCompatTextView
          app:layout_constraintStart_toEndOf="@id/ivNationalFlagTop"
          android:id="@+id/tvNationalNameTop"
          android:layout_marginStart="5dp"
          android:layout_width="wrap_content"
          android:textSize="@dimen/sp_14"
          android:textColor="@color/white"
          android:drawablePadding="8dp"
          app:layout_constraintLeft_toLeftOf="parent"
          android:layout_height="wrap_content"
          tools:ignore="MissingConstraints" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:layout_marginTop="19dp"
        android:layout_width="wrap_content"
        android:padding="5dp"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@drawable/lineup_compare_bg"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">
      <androidx.appcompat.widget.AppCompatTextView
          android:layout_marginStart="5dp"
          android:layout_width="wrap_content"
          android:text="@string/live_starting_lineup"
          android:textSize="@dimen/sp_14"
          android:textColor="@color/white"
          android:layout_height="wrap_content"
          tools:ignore="MissingConstraints" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/clLiveTitleBottom"
      android:layout_margin="@dimen/dp_6"
      android:layout_alignParentBottom="true"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      tools:ignore="MissingConstraints">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:layout_width="wrap_content"
        android:padding="5dp"
        android:background="@drawable/lineup_compare_bg"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">
      <ImageView
          android:id="@+id/ivNationalFlagBottom"
          android:layout_width="wrap_content"
          android:scaleType="fitCenter"
          android:layout_height="20dp"
          app:cornerRadius="4dp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          tools:ignore="MissingConstraints" />
      <androidx.appcompat.widget.AppCompatTextView
          app:layout_constraintStart_toEndOf="@id/ivNationalFlagBottom"
          android:id="@+id/tvNationalNameBottom"
          android:layout_marginStart="5dp"
          android:layout_width="wrap_content"
          android:textSize="@dimen/sp_14"
          android:textColor="@color/white"
          android:drawablePadding="8dp"
          app:layout_constraintLeft_toLeftOf="parent"
          android:layout_height="wrap_content"
          tools:ignore="MissingConstraints" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>



    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/sllIncidentsMain"
        android:layout_marginTop="10dp"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="match_parent"
        android:background="@drawable/lineup_substitution_bg"
        android:orientation="vertical"
        android:layout_height="wrap_content">

      <arch.cayenne.lib.skin.widget.SkinnableTextView
          android:layout_margin="@dimen/dp_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="@dimen/sp_14"
          android:gravity="center_vertical"
          android:paddingStart="@dimen/dp_12"
          android:background="@drawable/lineup_substitution_title_bg"
          android:text="@string/live_substitution_lineup"
          android:textColor="@color/color_929298"
          tools:ignore="RtlSymmetry" />

      <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
          android:layout_width="wrap_content"
          android:layout_marginStart="@dimen/dp_12"
          android:layout_marginTop="@dimen/dp_30"
          android:layout_marginBottom="@dimen/dp_6"
          android:layout_height="wrap_content"
          tools:ignore="MissingConstraints">
        <ImageView
            android:id="@+id/homeIncidentsLogo"
            android:layout_width="wrap_content"
            android:scaleType="fitCenter"
            android:layout_height="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="MissingConstraints" />
        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/homeIncidentsName"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_width="wrap_content"
            app:layout_constraintStart_toEndOf="@id/homeIncidentsLogo"
            android:gravity="center_vertical"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/substitution_text_color"
            android:drawablePadding="8dp"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />
      </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/llcHome"
          android:layout_marginTop="@dimen/dp_10"
          android:layout_width="match_parent"
          android:orientation="vertical"
          android:layout_height="wrap_content"/>
      <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
          android:layout_width="wrap_content"
          android:layout_marginTop="@dimen/dp_30"
          android:layout_marginStart="@dimen/dp_12"
          android:layout_marginBottom="@dimen/dp_6"
          android:layout_height="wrap_content"
          tools:ignore="MissingConstraints">
        <ImageView
            android:id="@+id/awayIncidentsLogo"
            android:layout_width="wrap_content"
            android:scaleType="fitCenter"
            android:layout_height="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="MissingConstraints" />
        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/awayIncidentsName"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_width="wrap_content"
            app:layout_constraintStart_toEndOf="@id/awayIncidentsLogo"
            android:gravity="center_vertical"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/substitution_text_color"
            android:drawablePadding="8dp"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />
      </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/llcAway"
          android:layout_width="match_parent"
          android:orientation="vertical"
          android:layout_marginTop="@dimen/dp_10"
          android:layout_height="wrap_content"/>
    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
      <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
          android:id="@+id/sllSubstituteMain"
          android:layout_marginTop="10dp"
          android:paddingBottom="@dimen/dp_10"
          android:layout_width="match_parent"
          android:background="@drawable/lineup_substitution_bg"
          android:orientation="vertical"
          android:layout_height="wrap_content">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_margin="@dimen/dp_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_14"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_12"
            android:background="@drawable/lineup_substitution_title_bg"
            android:text="@string/live_repair_lineup"
            android:textColor="@color/color_929298"
            tools:ignore="RtlSymmetry" />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_6"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints">
              <ImageView
                  android:id="@+id/homeSubstituteLogo"
                  android:layout_width="wrap_content"
                  android:scaleType="fitCenter"
                  android:layout_height="20dp"
                  app:layout_constraintTop_toTopOf="parent"
                  app:layout_constraintBottom_toBottomOf="parent"
                  tools:ignore="MissingConstraints" />
              <arch.cayenne.lib.skin.widget.SkinnableTextView
                  android:id="@+id/homeSubstituteName"
                  android:layout_marginStart="@dimen/dp_12"
                  android:layout_width="wrap_content"
                  android:gravity="center_vertical"
                  android:textSize="@dimen/sp_14"
                  android:textColor="@color/substitution_text_color"
                  android:drawablePadding="8dp"
                  android:textStyle="bold"
                  android:layout_height="wrap_content"
                  tools:ignore="MissingConstraints" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end"
                android:layout_marginEnd="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_6"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints">
              <arch.cayenne.lib.skin.widget.SkinnableTextView
                  android:id="@+id/awaySubstituteName"
                  android:layout_marginEnd="@dimen/dp_12"
                  android:layout_width="wrap_content"
                  android:gravity="center_vertical"
                  android:textSize="@dimen/sp_14"
                  android:textStyle="bold"
                  android:textColor="@color/substitution_text_color"
                  android:drawablePadding="8dp"
                  android:layout_height="wrap_content"
                  tools:ignore="MissingConstraints" />
              <ImageView
                  android:id="@+id/awaySubstituteLogo"
                  android:layout_width="wrap_content"
                  android:scaleType="fitCenter"
                  android:layout_height="20dp"
                  tools:ignore="MissingConstraints" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_height="wrap_content">

          <androidx.appcompat.widget.LinearLayoutCompat
              android:id="@+id/llcHomeSubstitute"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_height="wrap_content">
          </androidx.appcompat.widget.LinearLayoutCompat>
          <androidx.appcompat.widget.LinearLayoutCompat
              android:id="@+id/llcAwaySubstitute"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_height="wrap_content">
          </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
      </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

  </ScrollView>
</arch.cayenne.lib.common.ui.view.DynamicStateLayout>