<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/roots"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/live_bet_list_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="17dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tvBetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:singleLine="true"
            android:text="全场让球"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            tools:ignore="MissingConstraints" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNameOne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:drawableStart="@drawable/bet_outs_icon_ball"
            android:drawablePadding="8dp"
            android:textColor="@color/color_24ee8a"
            app:layout_constraintLeft_toRightOf="@id/tvBetName"
            tools:ignore="MissingConstraints" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNameTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:drawableStart="@drawable/bet_outs_icon_ball"
            android:drawablePadding="8dp"
            android:text="3-2"
            android:textColor="@color/color_24ee8a"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintLeft_toRightOf="@id/tvNameOne"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/clBet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_6"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_weight="1"
            tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/homeLogo"
                android:layout_width="20dp"
                android:scaleType="fitCenter"
                android:layout_height="20dp"
                tools:ignore="MissingConstraints" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/homeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:lines="1"
                android:singleLine="true"
                android:textColor="@color/substitution_text_color"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                tools:ignore="MissingConstraints" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/andName"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_10"
            android:text="@string/and"
            android:gravity="center_horizontal"
            android:textColor="@color/substitution_text_color"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            tools:ignore="MissingConstraints" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_weight="1"
            tools:ignore="MissingConstraints">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/awayName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:drawablePadding="8dp"
                android:gravity="center_vertical|end"
                android:lines="1"
                android:singleLine="true"
                android:textColor="@color/substitution_text_color"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                tools:ignore="MissingConstraints" />

            <ImageView
                android:id="@+id/awayLogo"
                android:layout_width="20dp"
                android:scaleType="fitCenter"
                android:layout_height="20dp"
                tools:ignore="MissingConstraints" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.walisport.module.live.ui.widget.LiveBetListLayout
        android:id="@+id/lbBet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:orientation="horizontal" />
</arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
