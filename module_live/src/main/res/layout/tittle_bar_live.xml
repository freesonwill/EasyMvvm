<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SportLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/title_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <arch.cayenne.lib.skin.widget.SportImageView
        android:id="@+id/iv_back"
        style="@style/CustomToolbarImgStyle"
        app:srcCompat="@drawable/bg_left_arrow"
        tools:ignore="MissingConstraints" />

    <arch.cayenne.lib.skin.widget.SportImageView
        android:id="@+id/iv_landscape_league_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/title_league_icon" />

    <arch.cayenne.lib.skin.widget.SportImageView
        android:layout_width="10dp"
        android:layout_height="@dimen/dp_18"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_6"
        android:src="@drawable/title_landscape_separator" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <arch.cayenne.lib.skin.widget.SportTextView
            android:id="@+id/tv_competition_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/title_bar_dow_icon"
            android:drawablePadding="@dimen/dp_5"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/title_bar"
            android:textSize="15sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <arch.cayenne.lib.skin.widget.SportTextView
        android:id="@+id/tv_money"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginStart="10dp"
        android:background="@drawable/title_live_money_background"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_5"
        android:paddingEnd="@dimen/dp_9"
        android:textColor="@color/title_money_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</arch.cayenne.lib.skin.widget.SportLinearLayout>