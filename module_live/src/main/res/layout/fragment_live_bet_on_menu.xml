<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SportRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:paddingTop="30dp"
    tools:context=".ui.LiveBetOnMenuFragment">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="5000dp">
            <com.walisport.module.live.ui.widget.NesticalRecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="false"
                />
    </androidx.core.widget.NestedScrollView>
</arch.cayenne.lib.skin.widget.SportRelativeLayout>