<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:id="@+id/clRoot"
    android:layout_marginTop="@dimen/dp_10"
    >
   <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
       android:layout_width="0dp"
       android:layout_weight="1"
       android:background="@drawable/bet_list_selected_background"
       android:layout_height="match_parent">

       <androidx.appcompat.widget.AppCompatTextView
           android:id="@+id/tvBetDuelLeft"
           android:layout_width="wrap_content"
           android:text="阿根廷"
           android:layout_marginStart="@dimen/dp_15"
           android:textSize="@dimen/sp_14"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintTop_toTopOf="parent"
           android:textColor="@drawable/live_bet_list_selected_text"
           android:drawablePadding="8dp"
           app:layout_constraintLeft_toLeftOf="parent"
           android:layout_height="wrap_content"
           tools:ignore="MissingConstraints" />
       <arch.cayenne.lib.skin.widget.SkinnableTextView
           android:id="@+id/tvBetDuelRight"
           android:drawablePadding="8dp"
           android:textSize="@dimen/sp_14"
           android:textStyle="bold"
           android:layout_marginEnd="@dimen/dp_15"
           android:textColor="@drawable/live_bet_list_odds_selected_text"
           android:layout_width="wrap_content"
           android:text="2.94"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintRight_toRightOf="parent"
           android:layout_height="wrap_content"
           tools:ignore="MissingConstraints" />
       <androidx.appcompat.widget.AppCompatImageView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           app:srcCompat="@drawable/bet_rise_icon"
           android:layout_margin="5dp"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintRight_toRightOf="parent"
           tools:ignore="MissingConstraints" />
       <androidx.appcompat.widget.AppCompatImageView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           app:srcCompat="@drawable/bet_decline_icon"
           android:layout_margin="5dp"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintRight_toRightOf="parent"
           tools:ignore="MissingConstraints" />

   </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/dp_8"
        android:background="@drawable/bet_list_selected_background"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:text="阿根廷"
            android:layout_marginStart="@dimen/dp_15"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="@drawable/live_bet_list_selected_text"
            android:drawablePadding="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />
        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:drawablePadding="8dp"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/dp_15"
            android:textColor="@drawable/live_bet_list_odds_selected_text"
            android:layout_width="wrap_content"
            android:text="2.94"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/bet_rise_icon"
            android:layout_margin="5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            tools:ignore="MissingConstraints" />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/bet_decline_icon"
            android:layout_margin="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            tools:ignore="MissingConstraints" />

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
</arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
