<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_minutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:textColor="@color/standing_text"
        android:textSize="@dimen/sp_15"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/tv_match_line"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_47"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@color/menu_lin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_match_minutes" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_match_type_left"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintEnd_toStartOf="@+id/tv_match_line"
        app:layout_constraintTop_toTopOf="@+id/tv_match_minutes" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_match_type_left_two"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/iv_match_type_left"
        app:layout_constraintStart_toStartOf="@+id/iv_match_type_left"
        app:layout_constraintEnd_toEndOf="@+id/iv_match_type_left"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_type_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_5"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/standing_text"
        android:layout_marginTop="@dimen/dp_3"
        app:layout_constraintEnd_toStartOf="@+id/iv_match_type_left"
        app:layout_constraintTop_toTopOf="@+id/tv_match_minutes" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_type_left_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/standing_text"
        android:layout_marginTop="@dimen/dp_11"
        app:layout_constraintEnd_toEndOf="@+id/tv_match_type_left"
        app:layout_constraintTop_toBottomOf="@+id/tv_match_type_left"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_player_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:maxWidth="@dimen/dp_100"
        android:lines="1"
        android:ellipsize="end"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/video_tab_text_color"
        android:layout_marginTop="@dimen/dp_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_match_minutes" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_player_left_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:maxWidth="@dimen/dp_100"
        android:lines="1"
        android:ellipsize="end"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/video_tab_text_color"
        android:layout_marginTop="@dimen/dp_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_match_player_left" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_match_type_right"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintStart_toEndOf="@+id/tv_match_line"
        app:layout_constraintTop_toTopOf="@+id/tv_match_minutes" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_match_type_right_two"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/iv_match_type_right"
        app:layout_constraintStart_toStartOf="@+id/iv_match_type_right"
        app:layout_constraintEnd_toEndOf="@+id/iv_match_type_right"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_type_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_5"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/standing_text"
        android:layout_marginTop="@dimen/dp_3"
        app:layout_constraintStart_toEndOf="@+id/iv_match_type_right"
        app:layout_constraintTop_toTopOf="@+id/tv_match_minutes" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_type_right_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/standing_text"
        android:layout_marginTop="@dimen/dp_11"
        app:layout_constraintEnd_toEndOf="@+id/tv_match_type_right"
        app:layout_constraintTop_toBottomOf="@+id/tv_match_type_right"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_player_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        android:maxWidth="@dimen/dp_100"
        android:lines="1"
        android:ellipsize="end"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/video_tab_text_color"
        android:layout_marginTop="@dimen/dp_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_match_minutes" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_match_player_right_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        android:maxWidth="@dimen/dp_100"
        android:lines="1"
        android:ellipsize="end"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/video_tab_text_color"
        android:layout_marginTop="@dimen/dp_11"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_match_player_right" />
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>