<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clRoot"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="@dimen/dp_10"
    android:orientation="horizontal">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/sclTow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bet_list_selected_background">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBetDuelLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_15"
            android:drawablePadding="8dp"
            android:text="阿根廷"
            android:textColor="@drawable/live_bet_list_selected_text"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tvBetDuelRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_15"
            android:drawablePadding="8dp"
            android:text="2.94"
            android:textColor="@drawable/live_bet_list_odds_selected_text"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:visibility="gone"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/bet_rise_icon"
            tools:ignore="MissingConstraints" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="@drawable/bet_decline_icon"
            tools:ignore="MissingConstraints" />

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/sclTow_lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bet_list_selected_background">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_live_market_lock"
            />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
