<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="model"
            type="com.walisport.module.live.ui.viewmodel.LiveVideoMainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_match_not_in_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/live_video_mask">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/live_video_match_overlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_home_team"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_46"
            android:layout_marginTop="@dimen/dp_57"
            android:layout_marginEnd="@dimen/dp_263"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_home_team"
            android:layout_width="@dimen/dp_140"
            android:layout_height="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_15"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            app:layout_constraintEnd_toEndOf="@id/iv_home_team"
            app:layout_constraintStart_toStartOf="@id/iv_home_team"
            app:layout_constraintTop_toBottomOf="@id/iv_home_team" />


        <com.walisport.module.live.ui.widget.HistoryVsView
            android:id="@+id/home_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="@id/iv_home_team"
            app:layout_constraintStart_toStartOf="@id/iv_home_team"
            app:layout_constraintTop_toBottomOf="@id/tv_home_team" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_58"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_away_team"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_46"
            android:layout_marginStart="@dimen/dp_263"
            android:layout_marginTop="@dimen/dp_57"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_away_team"
            android:layout_width="@dimen/dp_140"
            android:layout_height="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_15"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            app:layout_constraintEnd_toEndOf="@id/iv_away_team"
            app:layout_constraintStart_toStartOf="@id/iv_away_team"
            app:layout_constraintTop_toBottomOf="@id/iv_away_team" />

        <com.walisport.module.live.ui.widget.HistoryVsView
            android:id="@+id/away_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="@id/iv_away_team"
            app:layout_constraintStart_toStartOf="@id/iv_away_team"
            app:layout_constraintTop_toBottomOf="@id/tv_away_team" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>