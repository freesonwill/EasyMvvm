<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.cn.game.sdk2.ui.viewmodel.fast3.Fast3ViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llShowSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/game_sdk_shape_9_141624"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/bottomLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#1E2237"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivHomeBg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/bottomLayout"
                app:layout_constraintTop_toBottomOf="@id/centerLayout"
                app:srcCompat="@mipmap/game_sdk_result_bg_bottom" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_history_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/game_sdk_shape_3_66273153"
                app:layout_constraintBottom_toBottomOf="@id/fragment_history"
                app:layout_constraintTop_toBottomOf="@id/centerLayout" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragment_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/bottomLayout" />

            <!--            开奖结果-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/centerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/game_sdk_shape_9_141624"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintBottom_toTopOf="@id/iv_history_bg"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivHomeBgCenter"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:scaleType="fitXY"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:srcCompat="@mipmap/game_sdk_result_bg_bottom" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/resultBgTop"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:scaleType="fitXY"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/ivHomeBgCenter"
                    app:srcCompat="@mipmap/game_sdk_result_bg_top" />

                <RelativeLayout
                    android:id="@+id/titleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="10dp"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingEnd="10dp"
                    android:paddingBottom="@dimen/dp_5"
                    app:layout_constraintBottom_toTopOf="@id/vvvvvv">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivHomeLogo"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:srcCompat="@mipmap/game_sdk_icon_kuai_logo" />

                    <LinearLayout
                        android:id="@+id/llShowCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtHomeStatic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/g_home_txt_please"
                            android:textColor="@color/g_e8e8e9"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtHomeTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:textColor="@{model.homeTimeColorLD,default=@color/c_62DF57}"
                            android:textSize="15sp"
                            tools:text="30" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtHomeUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textColor="@color/g_e8e8e9"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llHomeVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="22dp"
                                android:layout_height="18dp"
                                android:scaleType="fitXY"
                                app:srcCompat="@mipmap/game_sdk_icon_video_bo" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/g_home_txt_video"
                                android:textColor="@color/g_f3f3f3"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llHomeMore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingEnd="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="22dp"
                                android:layout_height="wrap_content"
                                android:duplicateParentState="true"
                                android:scaleType="fitXY"
                                android:tint="@drawable/game_sdk_selector_ll_home_more_btn_bg"
                                app:srcCompat="@mipmap/game_sdk_icon_more" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:duplicateParentState="true"
                                android:text="@string/g_home_txt_more"
                                android:textColor="@drawable/game_sdk_selector_ll_home_more_btn_bg"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/vvvvvv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@id/viewPagerNew">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tl_game"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:layout_centerHorizontal="true"
                        android:layout_alignTop="@id/frrl"
                        android:layout_alignBottom="@id/frrl"
                        android:layout_marginEnd="5dp"
                        android:layout_toStartOf="@id/frrl"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:background="@android:color/transparent"
                        app:tabIndicator="@null"
                        app:tabRippleColor="@null"
                        app:tabIndicatorHeight="0dp"
                        app:tabGravity="start"
                        app:tabMode="scrollable"
                        app:tabTextColor="@color/g_9696b8"
                        app:tabMinWidth="@dimen/dp_30"
                        app:tabIndicatorAnimationMode="elastic"
                        app:tabTextAppearance="@style/TabLayoutTextAppearance"
                        app:tabSelectedTextColor="@color/g_f7cf41" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/frrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/game_sdk_shape_3_111130"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtCurrentMoney"
                            style="@style/ChronicaW03Regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/g_f7cf41"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="¥ 2000000000" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="5dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="@dimen/dp_4"
                            app:layout_constraintBottom_toBottomOf="@id/txtCurrentMoney"
                            app:layout_constraintStart_toEndOf="@id/txtCurrentMoney"
                            app:layout_constraintTop_toTopOf="@id/txtCurrentMoney"
                            app:srcCompat="@mipmap/game_sdk_icon_right" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </RelativeLayout>

                <View
                    android:id="@+id/resultClickView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/cl_chips"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cl_chips" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/g_141624"
                    android:clipChildren="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <!--clipChildren設置於爺ViewGroup=true，
                        會限制孫子ViewGroup的顯示範圍，
                        不超出父ViewGroup的顯示範圍。
                        因上述緣由故多加一層RelativeLayout，
                        讓下注氣泡不被裁切，籌碼清單動畫時也不會超出佈局-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <FrameLayout
                            android:id="@+id/fl_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent">
                        </FrameLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="15dp"
                        android:layout_height="0dp"
                        android:background="@drawable/game_sdk_shape_0_141624"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/betteAgainLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    app:layout_constraintBottom_toBottomOf="@id/cl_chips"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cl_chips">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivBetEndFg"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/game_sdk_again_bg"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivXuya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/game_sdk_icon_xuya_gray"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivMultiple2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/game_sdk_icon_multiple2_sel" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerNew"
                    android:layout_width="match_parent"
                    android:layout_height="174dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:layout_constraintBottom_toTopOf="@id/cl_chips" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/fragment_fake_view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="174dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:layout_constraintBottom_toTopOf="@id/cl_chips" />
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_winning"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/viewPagerNew"
                    app:layout_constraintEnd_toEndOf="@id/viewPagerNew"
                    app:layout_constraintStart_toStartOf="@id/viewPagerNew"
                    app:layout_constraintTop_toTopOf="@id/viewPagerNew" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_draw_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="@id/cl_chips"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cl_chips" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.cn.game.sdk2.ui.view.DoTouchFrameLayout
            android:id="@+id/tempTouch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/topLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/topLayout" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>