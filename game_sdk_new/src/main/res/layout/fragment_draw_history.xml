<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="3dp">

    <RelativeLayout
        android:id="@+id/rlClickHide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="23dp"
            android:layout_height="39dp"
            android:scaleType="fitXY"
            app:srcCompat="@mipmap/game_sdk_icon_bg_btn" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivHomeRotation"
            android:layout_width="7dp"
            android:layout_height="13dp"
            android:layout_centerInParent="true"
            android:rotation="180"
            android:scaleType="fitXY"
            app:srcCompat="@mipmap/game_sdk_icon_arrow_top" />

    </RelativeLayout>

    <!--历史记录-->
    <com.cn.game.sdk2.ui.view.ClickRecyclerView
        android:id="@+id/rv_draw_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rlClickHide"
        app:layout_constraintStart_toStartOf="parent"
        tools:itemCount="1"
        tools:listitem="@layout/item_draw_history" />

</androidx.constraintlayout.widget.ConstraintLayout>