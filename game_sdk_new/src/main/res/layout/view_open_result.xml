<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/game_sdk_shape_6_38000000">
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="@string/g_home_txt_open"
        android:textColor="@color/g_8fe7fb"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtOpenTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="20220411030990"
        android:textColor="@color/g_b2ffff"
        android:layout_marginBottom="4dp"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivOpenOne"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:srcCompat="@drawable/game_sdk_icon_dice_yi"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivOpenTwo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            app:srcCompat="@drawable/game_sdk_icon_dice_er"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivOpenThree"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            app:srcCompat="@drawable/game_sdk_icon_dice_er"/>
    </LinearLayout>
</LinearLayout>