<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.cn.game.sdk2.ui.viewmodel.fast3.SingleDiceVm" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rlHomeRoot"
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/icon_single_bg" />

        <com.cn.game.sdk2.ui.view.game.GameAreaView
            android:id="@+id/gavDiceOne"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:areaInfo="@{model.bettingArray[1]}"
            app:layout_constraintBottom_toTopOf="@id/gavDiceSix"
            app:layout_constraintEnd_toStartOf="@id/gavDiceFour"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiceOne"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/icon_dice_yi" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDiceOddsOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@{model.multiplierStr(1)}"
                    android:textColor="@color/g_f8e0c4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivDiceOne"
                    tools:text="x2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSingleOne"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:srcCompat="@drawable/flash_left_top" />
        </com.cn.game.sdk2.ui.view.game.GameAreaView>

        <com.cn.game.sdk2.ui.view.game.GameAreaView
            android:id="@+id/gavDiceTwo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:areaInfo="@{model.bettingArray[2]}"
            app:layout_constraintBottom_toBottomOf="@id/gavDiceOne"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/gavDiceFour"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiceTwo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/icon_dice_er" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDiceOddsTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@{model.multiplierStr(2)}"
                    android:textColor="@color/g_f8e0c4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivDiceTwo"
                    tools:text="x2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSingleTwo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:srcCompat="@drawable/flash_right_top" />
        </com.cn.game.sdk2.ui.view.game.GameAreaView>

        <com.cn.game.sdk2.ui.view.game.GameAreaView
            android:id="@+id/gavDiceThree"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:areaInfo="@{model.bettingArray[3]}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/gavDiceFive"
            app:layout_constraintStart_toEndOf="@id/gavDiceSix"
            app:layout_constraintTop_toTopOf="@id/gavDiceSix">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiceThree"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/icon_dice_san" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDiceOddsThree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@{model.multiplierStr(3)}"
                    android:textColor="@color/g_f8e0c4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivDiceThree"
                    tools:text="x2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSingleThree"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:srcCompat="@drawable/flash_centre" />

        </com.cn.game.sdk2.ui.view.game.GameAreaView>

        <com.cn.game.sdk2.ui.view.game.GameAreaView
            android:id="@+id/gavDiceFour"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:areaInfo="@{model.bettingArray[4]}"
            app:layout_constraintBottom_toBottomOf="@id/gavDiceOne"
            app:layout_constraintEnd_toStartOf="@id/gavDiceTwo"
            app:layout_constraintStart_toEndOf="@id/gavDiceOne"
            app:layout_constraintTop_toTopOf="@id/gavDiceOne">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiceFour"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/icon_dice_si" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDiceOddsFour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@{model.multiplierStr(4)}"
                    android:textColor="@color/g_f8e0c4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivDiceFour"
                    tools:text="x2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSingleFour"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:srcCompat="@drawable/flash_centre" />
        </com.cn.game.sdk2.ui.view.game.GameAreaView>

        <com.cn.game.sdk2.ui.view.game.GameAreaView
            android:id="@+id/gavDiceFive"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:areaInfo="@{model.bettingArray[5]}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/gavDiceThree"
            app:layout_constraintTop_toTopOf="@id/gavDiceSix">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiceFive"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/icon_dice_wu" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDiceOddsFive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@{model.multiplierStr(5)}"
                    android:textColor="@color/g_f8e0c4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivDiceFive"
                    tools:text="x2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSingleFive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:srcCompat="@drawable/flash_right_be" />

        </com.cn.game.sdk2.ui.view.game.GameAreaView>

        <com.cn.game.sdk2.ui.view.game.GameAreaView
            android:id="@+id/gavDiceSix"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:areaInfo="@{model.bettingArray[6]}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/gavDiceThree"
            app:layout_constraintTop_toBottomOf="@id/gavDiceOne">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiceSix"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/icon_dice_liu" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDiceOddsSix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@{model.multiplierStr(6)}"
                    android:textColor="@color/g_f8e0c4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivDiceSix"
                    tools:text="x2" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSingleSix"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:srcCompat="@drawable/flash_left_be" />
        </com.cn.game.sdk2.ui.view.game.GameAreaView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>