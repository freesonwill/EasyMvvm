<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <!-- 添加任何你想要自定义的样式 -->
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">#00000000</item>
        <!-- 可选：调整对话框的样式 -->
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>


    <style name="dialog_new" parent="Theme.AppCompat.Light.Dialog">
    <!-- 是否有边框 -->
    <item name="android:windowFrame">@null</item>
    <!--是否在悬浮Activity之上  -->
    <item name="android:windowIsFloating">true</item>
    <!--标题  -->
    <item name="android:windowNoTitle">true</item>
    <!--阴影  -->
    <item name="android:windowIsTranslucent">true</item>
    <!--透明背景-->
    <item name="android:background">@android:color/transparent</item>
    <!--窗口背景透明-->
    <item name="android:windowBackground">@android:color/transparent</item>
    <!--弹窗背景是否变暗-->
    <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="TransparentTheme" parent="Theme.AppCompat">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
     </style>
<!--Animation.Activity-->


    <style name="CustomWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!--    直接设置文字-->
    <style name="text_normal">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="text_globalT1" parent="text_normal">
        <item name="android:textColor">#1A1A1A</item>
    </style>


    <style name="text_single_dice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/g_f8e0c4</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/chronica_w03_regular</item>
    </style>

    <style name="text_sum_total">
        <item name="android:layout_width">27dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginTop">0dp</item>
    </style>

    <style name="viewpager_f3_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">174dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="c_center_rounded">
        <item name="cornerSize">8dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="TabLayoutTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="show_money_style">
        <item name="android:fontFamily">@font/chronica_w03_bold</item>
        <item name="android:paddingStart">9.7dp</item>
        <item name="android:paddingEnd">9.7dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/g_f8e0c4</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@mipmap/game_sdk_chips_amount</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">23.7dp</item>

    </style>
</resources>