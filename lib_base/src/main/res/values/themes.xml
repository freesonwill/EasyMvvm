<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ArchBottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ArchButtonSheetStyle</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="bottomSheetStyle">@style/ArchButtonSheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="ArchButtonSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_base_bottom_sheet_dialog</item>
        <item name="behavior_peekHeight">auto</item>
    </style>

    <style name="BaseSideSheetDialogTheme" parent="ThemeOverlay.Material3.SideSheetDialog">
        <item name="background">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>