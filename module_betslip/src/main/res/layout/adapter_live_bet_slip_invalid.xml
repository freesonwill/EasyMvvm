<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_betslip_card">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/bet_expired_iv_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_top"
        app:layout_constraintTop_toTopOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/bet_expired_tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_12"
            android:background="@drawable/bg_bet_confirming"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="0.5dp"
            android:textColor="@color/color_2c3c3e"
            android:textSize="@dimen/sp_13"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:skinnableFontWeight="500"
            tools:text="@string/live_bet_reserve_expired" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/bet_expired_tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/sp_13"
            app:layout_constraintBottom_toBottomOf="@id/bet_expired_tv_status"
            app:layout_constraintLeft_toRightOf="@id/bet_expired_tv_status"
            app:layout_constraintTop_toTopOf="@id/bet_expired_tv_status"
            tools:text="2024/11/14 05:03" />

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/bet_expired_iv_top"
        tools:itemCount="2"
        tools:listitem="@layout/item_live_bet_slip_invalid" />

    <include
        android:id="@+id/il_more"
        layout="@layout/item_betslip_more_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recycler_selection" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/bet_expired_iv_avava"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:src="@mipmap/live_betslip_avava"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/il_more"
        app:layout_goneMarginTop="6dp" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bet_district_line"
        app:layout_constraintBottom_toBottomOf="@id/bet_expired_iv_avava"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/bet_expired_iv_avava"
        app:layout_constraintTop_toTopOf="@id/bet_expired_iv_avava" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bet_district_line"
        app:layout_constraintBottom_toBottomOf="@id/bet_expired_iv_avava"
        app:layout_constraintLeft_toRightOf="@id/bet_expired_iv_avava"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/bet_expired_iv_avava" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_12"
        android:text="@string/live_bet_bet_num"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bet_expired_iv_avava" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_copy_clip"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"
        android:padding="6dp"
        android:src="@drawable/icon_copy_clip"
        app:layout_constraintBottom_toBottomOf="@id/tv_unit1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_unit1" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit1_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/main_text"
        android:textSize="@dimen/sp_14"
        app:skinnableFontWeight="500"
        app:layout_constraintBottom_toBottomOf="@id/tv_unit1"
        app:layout_constraintEnd_toStartOf="@id/iv_copy_clip"
        app:layout_constraintTop_toTopOf="@id/tv_unit1"
        tools:text="2025021112000001" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/live_bet_reserve_odds"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintStart_toStartOf="@id/tv_unit1"
        app:layout_constraintTop_toBottomOf="@id/tv_unit1" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit2_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_12"
        android:textColor="@color/main_text"
        android:textSize="@dimen/sp_14"
        app:skinnableFontWeight="500"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_unit2"
        tools:text="\@1.85" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/live_bet_reserve_bet"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toLeftOf="@id/tv_unit2"
        app:layout_constraintTop_toBottomOf="@id/tv_unit2" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit3_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_12"
        android:textColor="@color/main_text"
        android:textSize="@dimen/sp_14"
        app:skinnableFontWeight="500"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_unit3"
        tools:text="$1000" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="16dp"
        android:text="@string/live_bet_except_max_win"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/tv_unit2"
        app:layout_constraintTop_toBottomOf="@id/tv_unit3" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_unit4_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_12"
        android:textColor="@color/main_text"
        android:textSize="@dimen/sp_14"
        app:skinnableFontWeight="500"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_unit4"
        tools:text="$2312" />
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>