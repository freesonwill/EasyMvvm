<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_ball"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_league_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/color_FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_ball"
        app:layout_constraintStart_toEndOf="@id/iv_ball"
        app:layout_constraintTop_toTopOf="@id/iv_ball" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/color_00E301"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_league_name"
        app:layout_constraintStart_toEndOf="@id/tv_league_name"
        app:layout_constraintTop_toTopOf="@id/tv_league_name"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_game_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/color_999999"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_ball" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_game_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/color_FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_game_status"
        app:layout_constraintStart_toEndOf="@id/tv_game_status"
        app:layout_constraintTop_toTopOf="@id/tv_game_status" />

    <TextView
        android:id="@+id/tv_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/title_order_sport_live"
        android:textColor="@color/color_FE3666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_game_status"
        app:layout_constraintStart_toEndOf="@id/tv_game_time"
        app:layout_constraintTop_toTopOf="@id/tv_game_status" />

    <ImageView
        android:id="@+id/iv_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:src="@drawable/icon_live"
        app:layout_constraintBottom_toBottomOf="@id/tv_live"
        app:layout_constraintStart_toEndOf="@id/tv_live"
        app:layout_constraintTop_toTopOf="@id/tv_live" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_live, iv_live" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        android:src="@drawable/icon_order_right_arrow"
        app:layout_constraintBottom_toBottomOf="@id/tv_game_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_league_name" />

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/shape_9dp"
        android:backgroundTint="@color/color_0FFFFFFF"
        app:layout_constraintBottom_toTopOf="@id/line"
        app:layout_constraintTop_toBottomOf="@id/tv_game_status"
        app:layout_goneMarginBottom="0dp">

        <ImageView
            android:id="@+id/iv_game_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:src="@drawable/icon_sport_success"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_market"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/color_999999"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/iv_game_result"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="13dp" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_match_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/color_999999"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_market"
            app:layout_constraintStart_toEndOf="@id/tv_market"
            app:layout_constraintTop_toTopOf="@id/tv_market" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_selection_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/color_FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_market"
            app:layout_constraintTop_toBottomOf="@id/tv_market" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:textColor="@color/color_FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bet_district_line"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginBottom="0dp" />


</androidx.constraintlayout.widget.ConstraintLayout>