<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <ImageView
        android:id="@+id/bet_settled_iv_ball"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_16"
        android:scaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/bet_settled_tv_race"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_6"
        android:ellipsize="middle"
        android:maxLines="1"
        android:text="中国 vs 巴西"
        android:textColor="@color/main_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@id/bet_settled_iv_ball"
        app:layout_constraintLeft_toRightOf="@id/bet_settled_iv_ball"
        app:layout_constraintRight_toLeftOf="@id/iv_circle_arrow"
        app:layout_constraintTop_toTopOf="@id/bet_settled_iv_ball"
        app:layout_goneMarginEnd="@dimen/dp_16"
        tools:ignore="HardcodedText" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_circle_arrow"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_12"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/bet_settled_tv_race"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/bet_settled_tv_race"
        app:srcCompat="@drawable/icon_circle_arrow" />

    <FrameLayout
        android:id="@+id/fl_stat1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="@id/bet_settled_iv_ball"
        app:layout_constraintTop_toBottomOf="@id/bet_settled_iv_ball">

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/icon_betslip_tick" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/bet_settled_tv_status1"
            android:layout_width="55dp"
            android:layout_height="@dimen/dp_20"
            android:background="@drawable/shape_4dp"
            android:backgroundTint="@color/tab_bg"
            android:gravity="center"
            android:text="输半"
            android:textColor="@color/tab_text"
            android:textSize="@dimen/sp_13"
            app:layout_constraintLeft_toLeftOf="@id/bet_settled_iv_ball"
            app:layout_constraintTop_toBottomOf="@id/bet_settled_iv_ball"
            tools:ignore="HardcodedText" />

    </FrameLayout>


    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/bet_settled_tv_introduce"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_6"
        android:ellipsize="middle"
        android:maxLines="1"
        android:text="中国 +0.5"
        android:textColor="@color/main_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toRightOf="@id/fl_stat1"
        app:layout_constraintRight_toLeftOf="@id/bet_settled_tv_aodds"
        app:layout_constraintTop_toTopOf="@id/fl_stat1"
        tools:ignore="HardcodedText" />


    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/bet_settled_tv_aodds"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_12"
        android:text="\@1.85"
        android:textColor="@color/main_text"
        android:textStyle="bold"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@id/bet_settled_tv_introduce"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/bet_settled_tv_introduce"
        tools:ignore="HardcodedText"
        tools:targetApi="p" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/bet_settled_tv_status"
        android:layout_width="@dimen/dp_42"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@drawable/shape_4dp"
        android:backgroundTint="@color/color_24ee8a_20"
        android:gravity="center"
        android:text="@string/live_bet_grounder"
        android:textColor="@color/color_15b264"
        android:textSize="@dimen/sp_13"
        app:layout_constraintLeft_toLeftOf="@id/bet_settled_iv_ball"
        app:layout_constraintTop_toBottomOf="@id/bet_settled_tv_introduce" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/bet_settled_tv_score"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toRightOf="@id/bet_settled_tv_status"
        app:layout_constraintTop_toBottomOf="@id/bet_settled_tv_introduce"
        app:layout_goneMarginStart="0dp" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/bet_settled_tv_score1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_10"
        android:text="2-1"
        android:textColor="@color/brand_color"
        android:textFontWeight="600"
        android:textSize="@dimen/sp_14"
        app:layout_constraintLeft_toLeftOf="@id/bet_settled_iv_ball"
        app:layout_constraintTop_toBottomOf="@id/bet_settled_tv_score"
        tools:targetApi="p"
        tools:ignore="HardcodedText" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="@dimen/dp_14"
        android:background="@drawable/bet_district_line"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bet_settled_tv_score" />

</androidx.constraintlayout.widget.ConstraintLayout>