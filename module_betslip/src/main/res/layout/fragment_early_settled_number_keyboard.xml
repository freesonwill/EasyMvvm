<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.common.ui.view.BlockSlideConstrainLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_base_bottom_sheet_dialog"
    android:backgroundTint="@color/bottom_sheet_main_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:interceptedDirection="RIGHT"
    app:touchSlop="DEFAULT">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_calculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toTopOf="@id/cl_bottom_button">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_18"
            android:text="@string/want_settle_early"
            android:textColor="@color/main_text"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/capital"
            android:textColor="@color/main_text"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_money"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginEnd="4dp"
            android:background="@drawable/shape_8dp"
            android:backgroundTint="@color/input_box_2"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv1">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_money"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:layout_margin="13dp"
                android:background="@drawable/bg_money_circle"
                android:backgroundTint="@color/arrow_icon_fill_color"
                android:gravity="center"
                android:text="$"
                android:textAlignment="center"
                android:textColor="@color/money_color"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableEditText
                android:id="@+id/et_money"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:background="@null"
                android:inputType="numberDecimal"
                android:textColor="@color/main_text"
                android:textColorHint="@color/search_hint_white_green"
                android:textCursorDrawable="@drawable/edit_cursor"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_money"
                app:layout_constraintTop_toTopOf="parent"
                app:skinnableFontWeight="600" />
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <arch.cayenne.lib.skin.widget.SkinnableTabLayout
            android:id="@+id/ll_tab"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="@dimen/dp_10"
            android:paddingBottom="10dp"
            android:background="@color/main_background"
            app:layout_constraintTop_toBottomOf="@id/cl_money"
            app:sportTabBackground="@drawable/selector_keyboard_tab_percent"
            app:tabGravity="start"
            app:tabIndicatorHeight="0dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/green_white_bg"
            app:tabTextAppearance="@style/CustomTabText"
            app:tabTextColor="@color/secondary_text" />

        <ImageView
            android:id="@+id/iv_faker_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/cl_bottom_button"
            app:layout_constraintTop_toBottomOf="@id/ll_tab" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/cl_bottom_button"
            app:layout_constraintTop_toBottomOf="@id/ll_tab">

            <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
                android:id="@+id/rv_quick_amount"
                android:layout_width="61dp"
                android:layout_height="204dp"
                android:background="@drawable/shape_6dp"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:itemCount="5"
                tools:listitem="@layout/item_quick_amount" />

            <arch.cayenne.lib.common.ui.view.NumberKeyboardView
                android:id="@+id/number_keyboard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="4dp"
                app:layout_constraintBottom_toBottomOf="@id/rv_quick_amount"
                app:layout_constraintEnd_toStartOf="@id/gl_other"
                app:layout_constraintStart_toEndOf="@id/rv_quick_amount"
                app:layout_constraintTop_toTopOf="@id/rv_quick_amount" />

            <GridLayout
                android:id="@+id/gl_other"
                android:layout_width="62dp"
                android:layout_height="0dp"
                android:columnCount="1"
                app:layout_constraintBottom_toBottomOf="@id/rv_quick_amount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/rv_quick_amount">

                <arch.cayenne.lib.skin.widget.SkinnableImageButton
                    android:id="@+id/btn_back"
                    style="@style/NumberKeyboardTextButton"
                    android:layout_marginBottom="2dp"
                    android:scaleType="center"
                    android:src="@drawable/icon_keyboard_back" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/btn_clear"
                    style="@style/NumberKeyboardTextButton"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:text="@string/btn_clear"
                    android:textSize="14sp"
                    app:skinnableFontWeight="500" />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/btn_double"
                    style="@style/NumberKeyboardTextButton"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:alpha="0.5"
                    android:enabled="false"
                    android:text="@string/keyboard_double"
                    android:textSize="14sp"
                    app:skinnableFontWeight="500" />

                <arch.cayenne.lib.skin.widget.SkinnableImageButton
                    android:id="@+id/btn_collapse"
                    style="@style/NumberKeyboardTextButton"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:padding="10dp"
                    android:scaleType="center"
                    android:src="@drawable/icon_keyboard" />

            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>


    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_bottom_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableButton
            android:id="@+id/btn_cancel"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:background="@drawable/shape_green_stroke_8"
            android:foreground="@drawable/bg_click_mask_8dp"
            android:gravity="center"
            android:paddingHorizontal="21dp"
            android:text="@string/cancel"
            android:textColor="@color/green_white_bg"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_part_settle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/selector_send_button"
            android:foreground="@drawable/bg_click_mask_8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_cancel"
            app:layout_constraintTop_toTopOf="@id/btn_cancel">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_bet_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/live_bet_early_settle"
                android:textColor="@color/text_on_theme_color"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_bet_money"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:skinnableFontWeight="500" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/tv_bet_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refund_amount"
                android:textColor="#016F4A"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_bet_hint"
                app:skinnableFontWeight="500" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toTopOf="@id/cl_bottom_button" />

    <TextView
        android:id="@+id/early_settle_tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_early_settle_tip"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/refund_amount_include_principal"
        android:textColor="@color/color_311700"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/line"
        app:layout_constraintEnd_toEndOf="@id/cl_bottom_button"
        app:skinnableFontWeight="500" />

</arch.cayenne.lib.common.ui.view.BlockSlideConstrainLayout>