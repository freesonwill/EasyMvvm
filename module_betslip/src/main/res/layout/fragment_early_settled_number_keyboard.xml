<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_calculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintBottom_toTopOf="@id/cl_bottom_button"
        android:layout_marginBottom="@dimen/dp_30"
        >

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/want_settle_early"
            android:textColor="@color/main_text"
            android:textSize="@dimen/sp_15"
            android:layout_marginTop="@dimen/dp_18"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/capital"
            android:textStyle="bold"
            android:textColor="@color/main_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
            android:id="@+id/cl_money"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginEnd="4dp"
            android:background="@drawable/shape_8dp"
            android:backgroundTint="@color/input_box_2"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv1">

            <ImageView
                android:id="@+id/iv_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="13dp"
                android:src="@drawable/icon_circle_doaller"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <arch.cayenne.lib.skin.widget.SkinnableEditText
                android:id="@+id/et_money"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:background="@null"
                android:inputType="numberDecimal"
                android:textColor="@color/main_text"
                android:textColorHint="@color/search_hint_white_green"
                android:textCursorDrawable="@drawable/edit_cursor"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_money"
                app:layout_constraintTop_toTopOf="parent" />
        </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

        <arch.cayenne.lib.skin.widget.SkinnableTabLayout
            android:id="@+id/ll_tab"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@color/main_background"
            app:layout_constraintTop_toBottomOf="@id/cl_money"
            app:sportTabBackground="@drawable/selector_keyboard_tab_percent"
            app:tabGravity="start"
            app:tabIndicatorHeight="0dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/green_white_bg"
            app:tabTextAppearance="@style/CustomTabText"
            app:tabTextColor="@color/secondary_text" />

        <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
            android:id="@+id/ll_common_amount"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_6dp"
            android:backgroundTint="@color/keyboard_1"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_tab">

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_100"
                style="@style/KeyboardSideTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="100"
                android:textSize="14sp" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_500"
                style="@style/KeyboardSideTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="500"
                android:textSize="14sp" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_1000"
                style="@style/KeyboardSideTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="1000"
                android:textSize="14sp" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_2000"
                style="@style/KeyboardSideTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="2000"
                android:textSize="14sp" />

            <arch.cayenne.lib.skin.widget.SkinnableView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/dividing_line" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_5000"
                style="@style/KeyboardSideTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="5000"
                android:textSize="14sp" />
        </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ll_common_amount,number_keyboard,gl_other"
            />

        <arch.cayenne.lib.common.ui.view.NumberKeyboardView
            android:id="@+id/number_keyboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
            app:layout_constraintEnd_toStartOf="@id/gl_other"
            app:layout_constraintStart_toEndOf="@id/ll_common_amount"
            app:layout_constraintTop_toTopOf="@id/ll_common_amount" />

        <GridLayout
            android:id="@+id/gl_other"
            android:layout_width="62dp"
            android:layout_height="0dp"
            android:columnCount="1"
            app:layout_constraintBottom_toBottomOf="@id/ll_common_amount"
            app:layout_constraintEnd_toEndOf="@id/cl_money"
            app:layout_constraintTop_toTopOf="@id/ll_common_amount">

            <arch.cayenne.lib.skin.widget.SkinnableImageButton
                android:id="@+id/btn_back"
                style="@style/NumberKeyboardButton"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/keyboard_1"
                android:src="@drawable/icon_keyboard_back" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_clear"
                style="@style/NumberKeyboardButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/keyboard_1"
                android:text="@string/keyboard_clear"
                android:textSize="12sp" />

            <arch.cayenne.lib.skin.widget.SkinnableButton
                android:id="@+id/btn_double"
                style="@style/NumberKeyboardButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/keyboard_1"
                android:text="@string/keyboard_double"
                android:textSize="12sp" />

            <arch.cayenne.lib.skin.widget.SkinnableImageButton
                android:id="@+id/btn_collapse"
                style="@style/NumberKeyboardButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@color/keyboard_1"
                android:padding="10dp"
                android:src="@drawable/icon_keyboard" />

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <arch.cayenne.lib.skin.widget.SkinnableButton
            android:id="@+id/btn_cancel"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:background="@drawable/shape_green_stroke_8"
            android:gravity="center"
            android:paddingHorizontal="21dp"
            android:text="@string/cancel"
            android:textColor="@color/green_white_bg"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_part_settle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/gradient_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_cancel"
            app:layout_constraintTop_toTopOf="@id/btn_cancel">

            <TextView
                android:id="@+id/tv_bet_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_bet_early_settle"
                android:textColor="@color/text_on_theme_color"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_bet_money"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_bet_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refund_amount"
                android:textColor="#016F4A"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_bet_hint" />
        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/early_settle_tv_tip"
        android:layout_width="124dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_early_settle_tip"
        android:text="@string/refund_amount_include_principal"
        android:gravity="center"
        android:textColor="@color/color_311700"
        app:layout_constraintRight_toRightOf="@id/cl_bottom_button"
        app:layout_constraintBottom_toTopOf="@id/cl_bottom_button"
        android:layout_marginBottom="-4dp"
        android:visibility="gone"
        />

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>