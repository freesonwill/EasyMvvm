<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/group_gradient"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/iv_gradient"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/live_bet_slip_selection_gradient"
        app:layout_constraintTop_toTopOf="parent"/>

    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/ll_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:paddingHorizontal="22dp"
        android:layout_marginVertical="12dp"
        android:background="@drawable/shape_8dp"
        android:backgroundTint="@color/card_ooo_background"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_8dp"
            android:gravity="center"
            android:text="@string/see_more"
            android:textColor="@color/secondary_text" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:id="@+id/iv_arrow"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:src="@drawable/icon_circle_arrow_down" />

    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
