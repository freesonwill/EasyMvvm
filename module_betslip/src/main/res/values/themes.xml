<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomTabText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item> <!-- 设置字体大小 -->
    </style>

    <style name="KeyboardSideTextView">
        <item name="android:textColor">@color/keyboard_number</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="betSlipTabText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item> <!-- 设置字体大小 -->
    </style>

    <style name="BetSlipTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="OrderTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="OrderSportTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="NumberPickerTextAppearance">
        <item name="centerTextSize">18sp</item>
        <item name="centerTextColor">@color/color_FFFFFF</item>
        <item name="otherTextSize">15sp</item>
        <item name="otherTextColor">@color/color_999999</item>
    </style>

    <style name="ChooseTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/sp_15</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="paddingStart">0dp</item>
        <item name="paddingEnd">0dp</item>
        <item name="android:gravity">start</item>
        <item name="android:textAlignment">textStart</item>
    </style>
</resources>