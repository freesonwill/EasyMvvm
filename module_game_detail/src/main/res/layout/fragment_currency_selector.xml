<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/color_000000">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/view_bg"
        android:layout_width="203dp"
        android:layout_height="321dp"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <net.center.blurview.ShapeBlurView
            android:id="@+id/blurView"
            android:layout_width="203dp"
            android:layout_height="321dp"
            app:blur_radius="9dp"
            app:blur_corner_radius="@dimen/dp_9"
            app:blur_mode="rectangle"
            app:blur_overlay_color="@color/blur_view"
            app:blur_border_width="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/select_currency"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_14"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="277dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:itemCount="10"
            tools:layout_height="277dp"
            tools:listitem="@layout/item_currency_selector" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>