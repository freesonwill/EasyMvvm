<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_66000000">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="333dp"
        app:layout_constraintBottom_toTopOf="@id/line" />

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_2c2c2c"
        app:layout_constraintBottom_toTopOf="@id/cl_bottom"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintLeft_toLeftOf="parent"
        android:background="@color/color_1E1E1E"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_share"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/shape_9dp"
            android:backgroundTint="@color/color_1EFFFFFF"
            android:scaleType="centerInside"
            android:src="@drawable/icon_share_flag"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_go"
            android:layout_width="285dp"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:background="@drawable/shape_9dp"
            android:backgroundTint="@color/color_1EFFFFFF"
            android:gravity="center"
            android:text="@string/follow_bet"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_14"
            app:layout_constraintLeft_toRightOf="@id/iv_share"
            app:layout_constraintTop_toTopOf="@id/iv_share"
            app:skinnableFontWeight="500" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>