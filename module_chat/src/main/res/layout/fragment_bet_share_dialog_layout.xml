<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_66000000">

    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="425dp"
        android:background="@drawable/shape_9_top"
        android:backgroundTint="@color/color_1E1E1E"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_title"
            android:layout_width="match_parent"
            android:layout_height="54dp">

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/title_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:text="南京红姐"
                android:textColor="@color/color_8FBEE9"
                android:textSize="@dimen/sp_14"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:skinnableFontWeight="500" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_vip_flag"
                android:layout_width="39dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/dp_4"
                android:src="@drawable/chat_info_vip"
                app:layout_constraintBottom_toBottomOf="@id/title_name"
                app:layout_constraintLeft_toRightOf="@id/title_name"
                app:layout_constraintTop_toTopOf="@id/title_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:text="投注单"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/sp_14"
                app:layout_constraintBottom_toBottomOf="@id/title_name"
                app:layout_constraintLeft_toRightOf="@id/iv_vip_flag"
                app:layout_constraintTop_toTopOf="@id/title_name" />

            <FrameLayout
                android:id="@+id/iv_close"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_chat_close" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_marginRight="@dimen/dp_8"
                app:layout_constraintRight_toLeftOf="@id/iv_close"
                app:layout_constraintTop_toTopOf="@id/iv_close">

                <ImageView
                    android:id="@+id/iv_expand"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_chat_expand" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="@color/color_2c2c2c"
        app:layout_constraintBottom_toTopOf="@id/cl_bottom"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="80dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_share"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/shape_9dp"
            android:backgroundTint="@color/color_1EFFFFFF"
            android:scaleType="centerInside"
            android:src="@drawable/icon_share_flag"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_replay"
            android:layout_width="137dp"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:background="@drawable/shape_9dp"
            android:backgroundTint="@color/color_1EFFFFFF"
            android:gravity="center"
            android:text="@string/watch_replay"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_14"
            app:layout_constraintLeft_toRightOf="@id/iv_share"
            app:layout_constraintTop_toTopOf="@id/iv_share"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_go"
            android:layout_width="137dp"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:background="@drawable/shape_9dp"
            android:backgroundTint="@color/color_1EFFFFFF"
            android:gravity="center"
            android:text="@string/go_to_mahjong"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_14"
            app:layout_constraintLeft_toRightOf="@id/tv_replay"
            app:layout_constraintTop_toTopOf="@id/iv_share"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_go1"
            android:layout_width="285dp"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:background="@drawable/shape_9dp"
            android:backgroundTint="@color/color_1EFFFFFF"
            android:gravity="center"
            android:text="@string/go_to_mahjong"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_14"
            android:visibility="gone"
            app:layout_constraintLeft_toRightOf="@id/tv_replay"
            app:layout_constraintTop_toTopOf="@id/iv_share"
            app:skinnableFontWeight="500" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>