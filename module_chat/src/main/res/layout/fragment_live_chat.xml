<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="arch.cayenne.module.chat.ui.fragment.ChatHomeFragment">

    <data>

        <variable
            name="viewModel"
            type="arch.cayenne.module.chat.ui.viewmodel.ChatHomeViewModel" />
    </data>

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background"
        android:orientation="vertical">


        <androidx.constraintlayout.widget.Group
            android:id="@+id/live_chat_group_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="live_chat_recycler,live_chat_keyboard" />

        <arch.cayenne.lib.common.ui.view.DynamicStateLayout
            android:id="@+id/dynamic_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/dp_62" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/live_chat_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/dp_62"
            />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/live_chat_keyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>



</layout>