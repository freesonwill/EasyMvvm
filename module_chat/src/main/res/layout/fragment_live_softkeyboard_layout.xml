<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="arch.cayenne.module.chat.ui.viewmodel.SoftKeyboardViewModel" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:id="@+id/screen_top"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/input_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_106"
                android:background="@color/color_272727"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_language"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginStart="@dimen/dp_10"
                    android:background="@drawable/shape_ring_0f_fff"
                    android:padding="@dimen/dp_8"
                    android:src="@drawable/icon_input_language"
                    app:layout_constraintBottom_toBottomOf="@id/chat_ll_input"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="@id/chat_ll_input" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/chat_ll_input"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/shape_20"
                    android:backgroundTint="@color/color_0FFFFFFF"
                    android:orientation="horizontal"
                    app:layout_constraintLeft_toRightOf="@id/iv_language"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginLeft="@dimen/dp_12"
                    app:layout_goneMarginRight="@dimen/dp_10"
                    app:layout_constraintRight_toLeftOf="@id/chat_tv_send"
                    >
                    <EditText
                        android:id="@+id/chat_et_input"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:hint="@string/live_chat_talk"
                        android:imeActionLabel="@string/send"
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:paddingStart="@dimen/dp_16"
                        android:textColor="@color/main_text"
                        android:textColorHint="@color/secondary_text"
                        android:textSize="@dimen/sp_15"
                        app:layout_constraintLeft_toLeftOf="@id/chat_ll_input"
                        app:layout_constraintTop_toTopOf="@id/chat_ll_input"
                        />
                </androidx.appcompat.widget.LinearLayoutCompat>



                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_at"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:src="@drawable/icon_input_at"
                    app:layout_constraintRight_toLeftOf="@id/iv_bet"
                    app:layout_constraintTop_toTopOf="@id/iv_emoji"
                   />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bet"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:src="@drawable/icon_input_bet"
                    app:layout_constraintRight_toLeftOf="@id/iv_emoji"
                    app:layout_constraintTop_toTopOf="@id/iv_emoji"
                  />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_emoji"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/dp_20"
                    android:src="@drawable/icon_input_emoji"
                    app:layout_constraintTop_toTopOf="@id/chat_ll_input"
                    app:layout_constraintBottom_toBottomOf="@id/chat_ll_input"
                    app:layout_constraintRight_toRightOf="@id/chat_ll_input"
                    />

                <arch.cayenne.lib.skin.widget.SkinnableTextView
                    android:id="@+id/chat_tv_send"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/dp_11"
                    android:background="@drawable/bg_keyboard_send"
                    android:gravity="center"
                    android:stateListAnimator="@animator/layout_alpha_animator"
                    android:text="@string/send"
                    android:textColor="@color/color_FFFFFF"
                    app:layout_constraintBottom_toBottomOf="@id/chat_ll_input"
                    app:layout_constraintLeft_toRightOf="@id/chat_ll_input"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@id/chat_ll_input"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:visibility="gone"
                    />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/hot_recyclerview"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chat_ll_input" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bottom_at"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:layout_marginStart="@dimen/dp_15"
                    android:padding="2dp"
                    android:src="@drawable/icon_input_at"
                    app:layout_constraintBottom_toBottomOf="@id/hot_recyclerview"
                    app:layout_constraintLeft_toRightOf="@id/hot_recyclerview"
                    app:layout_constraintTop_toTopOf="@id/hot_recyclerview" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bottom_bet"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:layout_marginStart="@dimen/dp_14"
                    android:padding="2dp"
                    android:src="@drawable/icon_input_bet"
                    app:layout_constraintLeft_toRightOf="@id/iv_bottom_at"
                    app:layout_constraintTop_toTopOf="@id/iv_bottom_at" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bottom_emoji"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:layout_marginStart="@dimen/dp_14"
                    android:padding="2dp"
                    android:src="@drawable/icon_input_emoji"
                    app:layout_constraintLeft_toRightOf="@id/iv_bottom_bet"
                    app:layout_constraintTop_toTopOf="@id/iv_bottom_bet" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/emoji_content"
            android:layout_width="match_parent"
            android:layout_height="241dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/input_bg" />

