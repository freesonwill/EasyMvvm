<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="432dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="@color/color_1E1E1E"
    android:background="@drawable/shape_top_8"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    >
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_porn"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="色情低俗"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_ad"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="非法广告"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_abuse"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="辱骂我或他人"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_illegal"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="违法违规"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_fraud"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="涉嫌诈骗"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_other"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="其他"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />


    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_13"
        android:textSize="@dimen/sp_16"
        android:text="取消"
        app:skinnableFontWeight="500"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />
</LinearLayout>