<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="@color/color_1E1E1E"
    android:background="@drawable/shape_top_8"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    >
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_999999"
        android:text="范哥的忠实粉丝：大于五个字"
        tools:ignore="HardcodedText"
        android:layout_marginTop="@dimen/dp_18"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_18"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_at"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="\@Ta"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_copy"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="复制评论"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_report"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_17"
        android:textSize="@dimen/sp_16"
        android:text="举报评论"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/color_272727"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:layout_marginTop="@dimen/dp_17"
        />


    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/dp_13"
        android:textSize="@dimen/sp_16"
        android:text="取消"
        app:skinnableFontWeight="500"
        android:textColor="@color/white"
        tools:ignore="HardcodedText" />
</LinearLayout>