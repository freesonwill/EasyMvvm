<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@drawable/selector_at_bg"
    android:layout_height="36dp"
   >

    <LinearLayout
        android:id="@+id/vip_flag"
        android:layout_width="@dimen/dp_35"
        android:layout_height="@dimen/dp_14"
        android:layout_marginStart="@dimen/dp_18"
        android:background="@drawable/bg_vip_rect"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_13"
            android:layout_height="wrap_content"
            android:layout_marginStart="4.5dp"
            android:layout_marginTop="2dp"
            android:adjustViewBounds="false"
            android:cropToPadding="true"
            android:maxHeight="@dimen/dp_11"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/icon_vip_flag" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="30"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_9"
            app:skinnableFontWeight="700" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@id/vip_flag"
        app:layout_constraintLeft_toRightOf="@id/vip_flag"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/vip_flag"
        app:skinnableFontWeight="700"
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_FFFFFF"
        android:text="dass"
        android:layout_marginRight="@dimen/dp_36"
        />
    
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_selected"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@drawable/icon_at_hook_selected"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginRight="@dimen/dp_20"
        />

</androidx.constraintlayout.widget.ConstraintLayout>