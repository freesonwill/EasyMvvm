<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@color/color_272727">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_avatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="@dimen/dp_16"
        android:src="@drawable/icon_chat_item_union_pay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_3"
        android:text="官方2联银商"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/sp_15"
        app:layout_constraintLeft_toRightOf="@id/iv_avatar"
        app:layout_constraintTop_toTopOf="@id/iv_avatar"
        app:skinnableFontWeight="500"
        tools:ignore="HardcodedText" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_18"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_22"
        android:text="您好，当前闪付不再线上，您好当前闪付不再线上，请稍后您好，当前闪付不再线上，请稍后"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_13"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@id/name"
        app:layout_constraintRight_toLeftOf="@id/fl_circle"
        app:layout_constraintTop_toBottomOf="@id/name"
        android:ellipsize="end"
      />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_18"
        android:layout_marginEnd="@dimen/dp_16"
        android:text="02:10"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/sp_13"
        app:layout_constraintBottom_toBottomOf="@id/name"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/name"
        tools:ignore="HardcodedText" />

    <FrameLayout
        android:id="@+id/fl_circle"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:background="@drawable/shape_ring"
        android:backgroundTint="@color/color_fe3666"
        app:layout_constraintBottom_toBottomOf="@id/content"
        app:layout_constraintRight_toRightOf="@id/time"
        app:layout_constraintTop_toTopOf="@id/content">

        <TextView
            android:id="@+id/size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="6"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/sp_11"
            app:skinnableFontWeight="510" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>