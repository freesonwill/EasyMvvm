<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_66"
    android:layout_marginStart="@dimen/dp_10"
    android:layout_marginTop="@dimen/dp_60"
    android:layout_marginEnd="@dimen/dp_10"
    android:background="@drawable/shape_bg_notify"
    android:elevation="4dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/iv_notify_logo"
        android:layout_width="@dimen/dp_34"
        android:layout_height="@dimen/dp_34"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_notify_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginEnd="@dimen/dp_20"
        android:ellipsize="end"
        android:lines="1"
        android:textColor="@color/msg_title"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/iv_notify_logo"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_notify_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_20"
        android:ellipsize="end"
        android:lines="1"
        android:textColor="@color/msg_type"
        android:textSize="@dimen/sp_12"
        app:layout_constraintStart_toEndOf="@+id/iv_notify_logo"
        app:layout_constraintTop_toBottomOf="@+id/tv_notify_title" />

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>