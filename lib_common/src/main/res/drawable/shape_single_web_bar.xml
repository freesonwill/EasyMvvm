<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 进度条背景色 -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dip" />
            <gradient
                android:angle="270"
                android:centerColor="@color/bg_gray"
                android:centerY="0.75"
                android:endColor="@color/bg_gray"
                android:startColor="@color/bg_gray" />
        </shape>
    </item>

    <!-- 第二进度条 -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="5dip" />
                <gradient
                    android:angle="270"
                    android:centerColor="@color/color_blue"
                    android:centerY="0.75"
                    android:endColor="#c3b2ff"
                    android:startColor="@color/color_blue" />
            </shape>
        </clip>
    </item>

    <!-- 第二进度条 -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5dip" />
                <gradient
                    android:angle="270"
                    android:centerColor="@color/color_blue"
                    android:centerY="0.75"
                    android:endColor="#8eefff"
                    android:startColor="@color/color_blue" />
            </shape>
        </clip>
    </item>
</layer-list>