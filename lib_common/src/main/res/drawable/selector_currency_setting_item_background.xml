<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 狀態：點擊時 (Pressed state) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <!-- 內部填充顏色 -->
            <solid android:color="@color/color_003A42" />
            <!-- 圓角 -->
            <corners android:radius="6dp" />
            <!-- 邊框 -->
            <stroke
                android:width="1dp"
                android:color="@color/color_00A7C0" />
        </shape>
    </item>

    <!-- 狀態：預設時 (Default state) -->
    <item>
        <shape android:shape="rectangle">
            <!-- 內部填充顏色 -->
            <solid android:color="@color/color_0FFFFFFF" /> <!-- 6% 透明度的白色 -->
            <!-- 圓角 -->
            <corners android:radius="6dp" />
        </shape>
    </item>

</selector>