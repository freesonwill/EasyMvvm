<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 選中狀態 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/bg_league_item_selected" />
        </shape>
    </item>
    <!-- 未選中狀態 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/color_0FFFFFFF" />
            <!--            <stroke android:width="0.8dp" android:color="@color/bg_league_item_unselect" />-->
        </shape>
    </item>
</selector>
