<resources>


    <style name="CustomToolbarStyle">
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingEnd">@dimen/title_bar_padding_end</item>
        <item name="android:paddingStart">@dimen/title_bar_padding_start</item>
    </style>

    <style name="CustomToolbarStyleAccount">
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingStart">@dimen/title_bar_padding_start</item>
    </style>

    <style name="CustomToolbarImgStyle">
        <item name="android:layout_height">@dimen/dp_24</item>
        <item name="android:layout_width">@dimen/dp_24</item>
        <item name="android:stateListAnimator">@animator/layout_alpha_animator</item>
        <item name="srcCompat">@drawable/universal_icon_back</item>
        <item name="layout_constraintLeft_toLeftOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>

    <style name="CustomToolbarCancelStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="layout_constraintLeft_toLeftOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>

    <style name="CustomToolbarTvStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="layout_constraintLeft_toLeftOf">parent</item>
        <item name="layout_constraintRight_toRightOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>

    <style name="CustomToolbarLine">
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_width">0dp</item>
    </style>
    <style name="gameCustomToolbarLine">
        <item name="android:layout_height">37dp</item>
        <item name="android:layout_width">0dp</item>
    </style>
    <style name="CustomToolbarEditStyle">
        <item name="android:layout_height">38dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CustomBottomToolbarEditStyle">
        <item name="android:layout_height">38dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="NumberKeyboardButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:background">@drawable/selector_number_button_pressed</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="skinnableFontWeight">500</item>
    </style>

    <style name="MoneyKeyboardButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/dp_48</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="fontFamily">@font/sf_pro</item>
        <item name="android:background">@drawable/selector_money_button_pressed</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_FFFFFF</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="NumberKeyboardTextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:background">@drawable/selector_number_text_button_pressed</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/sf_pro</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:background">@drawable/selector_send_button</item>
        <item name="android:textColor">@color/color_FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>


    <declare-styleable name="LetterIndex">
        <attr name="text_size" format="integer" />
        <attr name="text_color" format="color" />
        <attr name="text_selected_color" format="color" />
        <attr name="circle_padding" format="dimension" />
        <attr name="circle_color" format="color" />
        <attr name="item_space" format="dimension" />
        <!--        选择的背景色是否随着触摸取消，而取消-->
        <attr name="draw_circle_action_up" format="boolean" />
        <attr name="show_pop" format="boolean" />
    </declare-styleable>

    <style name="CommonDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_scale_out</item>
    </style>

    <declare-styleable name="InterceptedView">
        <attr name="touchSlop" format="integer|string" />
        <attr name="interceptedDirection" format="flags">
            <flag name="NONE" value="0x00" />
            <flag name="UP" value="0x01" />
            <flag name="DOWN" value="0x02" />
            <flag name="LEFT" value="0x04" />
            <flag name="RIGHT" value="0x08" />
        </attr>
        <attr name="canScrollView" format="reference" />
    </declare-styleable>

    <declare-styleable name="GameRoundProgressBar">
        <!-- 背景顏色 -->
        <attr name="backgroundColor" format="color" />
        <!-- 進度條顏色 -->
        <attr name="progressColor" format="color" />
        <!-- 觸發時間（例如進度動畫時間），單位毫秒 -->
        <attr name="triggerTime" format="integer" />
    </declare-styleable>

    <declare-styleable name="CustomGameTabGroupLayout">
        <attr name="defaultTabIcon" format="reference" />
        <attr name="tabIconSize" format="dimension" />
    </declare-styleable>

</resources>