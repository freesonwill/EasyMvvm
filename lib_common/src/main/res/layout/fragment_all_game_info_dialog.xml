<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:padding="@dimen/dp_8"
        android:maxLines="10"
        android:ellipsize="end"
        android:layout_marginEnd="@dimen/dp_9"
        android:background="@drawable/shape_game_ranking_info_top_bg"
        android:maxWidth="@dimen/dp_110"
        android:textColor="@color/color_000000"
        android:textSize="@dimen/sp_13"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_bg_bottom"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_10"
        android:layout_marginTop="-2dp"
        app:layout_constraintStart_toStartOf="@+id/tv_text"
        app:layout_constraintEnd_toEndOf="@id/tv_text"
        app:layout_constraintTop_toBottomOf="@+id/tv_text"
        app:srcCompat="@drawable/ic_game_ranking_info_bottom" />
</androidx.constraintlayout.widget.ConstraintLayout>