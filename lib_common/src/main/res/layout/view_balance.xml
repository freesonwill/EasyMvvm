<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_36"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_shape_balance">
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_currency_icon"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:background="@drawable/ic_usdt"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_wallet_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="@dimen/dp_2"
        android:layout_gravity="center_vertical"
        android:fontFamily="@font/sf_pro_display_bold"
        android:textColor="@color/main_text"
        android:textSize="14sp"
        android:layout_marginLeft="@dimen/dp_7"
        android:text="1100.11100"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_currency_icon"/>
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_arrow"
        android:layout_width="@dimen/dp_10"
        android:layout_height="@dimen/dp_7"
        android:background="@drawable/ic_arrow_down"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintLeft_toRightOf="@+id/tv_wallet_balance"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:background="@drawable/ic_recharge"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_6"
        app:layout_constraintLeft_toRightOf="@+id/iv_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>