<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_32"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/ll_btn_sort"
        android:layout_width="51dp"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_7"
        android:layout_marginBottom="@dimen/dp_3"
        android:background="@drawable/shape_custom_game_tab_button_bg"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UnknownId">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_btn_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_1"
            android:text="@string/custom_tab_hot"
            android:textColor="@color/color_C0C0C0"
            android:textSize="@dimen/sp_14" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_1"
            android:src="@drawable/ic_custom_game_tab_sort" />
    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/ll_btn_expand"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_32"
        android:layout_marginEnd="@dimen/dp_7"
        android:background="@drawable/shape_custom_game_tab_button_bg"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/ll_btn_sort"
        app:layout_constraintEnd_toStartOf="@+id/ll_btn_sort"
        app:layout_constraintTop_toTopOf="@+id/ll_btn_sort">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_btn_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_2"
            android:text="供应商"
            android:textColor="@color/color_C0C0C0"
            android:textSize="@dimen/sp_14" />

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:layout_width="16dp"
            android:layout_height="15dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_1"
            android:src="@drawable/ic_custom_game_tab_expand" />
    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/v_more_mask"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_38"
        android:background="@drawable/bg_gradient_btn_mask"
        android:paddingBottom="@dimen/dp_14"
        app:layout_constraintEnd_toStartOf="@+id/ll_btn_expand"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>