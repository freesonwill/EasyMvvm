<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="3">

    <!-- 數字與符號按鈕 -->
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_one"
        style="@style/NumberKeyboardButton"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="1"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_two"
        style="@style/NumberKeyboardButton"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="2"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_three"
        style="@style/NumberKeyboardButton"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="3"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_four"
        style="@style/NumberKeyboardButton"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="4"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_five"
        style="@style/NumberKeyboardButton"
        android:layout_margin="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="5"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_six"
        style="@style/NumberKeyboardButton"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="6"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_seven"
        style="@style/NumberKeyboardButton"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="7"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_eight"
        style="@style/NumberKeyboardButton"
        android:layout_margin="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="8"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_nine"
        style="@style/NumberKeyboardButton"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="9"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_other"
        style="@style/NumberKeyboardButton"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:textSize="14sp"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_zero"
        style="@style/NumberKeyboardButton"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="0"
        app:skinnableFontWeight="500" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/btn_dot"
        style="@style/NumberKeyboardButton"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:backgroundTint="@color/keyboard_2"
        android:foreground="@drawable/bg_click_mask_6dp_white_blue"
        android:text="."
        app:skinnableFontWeight="500" />

</GridLayout>