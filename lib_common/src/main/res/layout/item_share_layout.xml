<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/dp_72"
    android:layout_height="88dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iv"
        android:layout_width="@dimen/dp_46"
        android:layout_height="@dimen/dp_46"
        android:background="@drawable/icon_share_chat"
        android:scaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginRight="@dimen/dp_13"
        />

    <TextView
        android:id="@+id/tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="2"
        app:layout_constraintTop_toBottomOf="@id/iv"
        android:layout_marginTop="@dimen/dp_8"
        android:textColor="@color/color_C0C0C0"
        android:textSize="@dimen/sp_12"
        android:text="聊天聊天聊天聊天聊天聊天聊天聊天"
        app:layout_constraintLeft_toLeftOf="@id/iv"
        app:layout_constraintRight_toRightOf="@id/iv"
        android:maxWidth="@dimen/dp_57"
        tools:ignore="HardcodedText" />


</androidx.constraintlayout.widget.ConstraintLayout>