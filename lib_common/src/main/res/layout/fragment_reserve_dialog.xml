<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    >

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_calculator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11.72dp"
        android:layout_marginBottom="11.5dp"
        android:background="@drawable/bg_reserve_dialog"
        android:paddingHorizontal="12dp"
        android:paddingTop="10.28dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_triangle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_triangle"
        app:layout_constraintVertical_bias="0.0"
        app:layout_goneMarginBottom="0dp"
        app:layout_goneMarginTop="0dp">

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:text="@string/title_rate"
            android:textColor="@color/color_FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/et_rate"
            app:layout_constraintEnd_toStartOf="@id/et_rate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/et_rate"
            app:skinnableFontWeight="500" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/et_rate"
            app:layout_constraintEnd_toEndOf="@id/et_rate"
            app:layout_constraintTop_toTopOf="@id/et_rate"
            app:layout_constraintBottom_toBottomOf="@id/et_rate"
            app:layout_constraintHorizontal_bias="0"
            android:padding="8dp"
            android:text="\@"
            android:textColor="@color/color_C0C0C0"
            android:textSize="15sp"
            android:textStyle="bold"
            app:skinnableFontWeight="700"
            />

        <arch.cayenne.lib.skin.widget.SkinnableEditText
            android:id="@+id/et_rate"
            android:layout_width="130dp"
            android:layout_height="36dp"
            android:background="@drawable/shape_8dp"
            android:backgroundTint="@color/color_1FFFFFFF"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/sf_pro"
            android:inputType="numberDecimal"
            android:paddingStart="22dp"
            android:paddingEnd="8dp"
            android:paddingVertical="@dimen/dp_8"
            android:textColor="@color/color_00E0E5"
            android:textCursorDrawable="@drawable/shape_edittext_cursor"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:skinnableFontWeight="700"
            android:maxLines="1"
            android:maxLength="7"
            tools:text="\1.85" />

        <arch.cayenne.lib.common.ui.view.NumberKeyboardView
            android:id="@+id/number_keyboard"
            android:layout_width="224dp"
            android:layout_height="0dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@id/gl_other"
            app:layout_constraintEnd_toStartOf="@id/gl_other"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/gl_other"
            android:spacing="@dimen/dp_4"
            app:otherTextSize="@dimen/sp_16"
            />

        <GridLayout
            android:id="@+id/gl_other"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_rate">

            <arch.cayenne.lib.skin.widget.SkinnableImageButton
                android:id="@+id/btn_back"
                style="@style/NumberKeyboardTextButton"
                android:layout_width="62dp"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                android:scaleType="center"
                android:src="@drawable/icon_keyboard_back" />

            <arch.cayenne.lib.skin.widget.SkinnableTextView
                android:id="@+id/btn_clear"
                style="@style/NumberKeyboardTextButton"
                android:layout_width="62dp"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:text="@string/btn_clear"
                android:textSize="14sp"
                app:skinnableFontWeight="500" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                style="@style/ButtonStyle"
                android:layout_width="62dp"
                android:layout_height="100dp"
                android:layout_columnWeight="2"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:text="@string/btn_confirm"
                android:textSize="14sp"
                app:skinnableFontWeight="500"
                />

        </GridLayout>

    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/top_triangle"
        android:layout_width="32dp"
        android:layout_height="13dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_triangle_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/bottom_triangle"
        android:layout_width="32dp"
        android:layout_height="13dp"
        android:layout_marginEnd="13dp"
        android:visibility="gone"
        android:background="@drawable/bg_triangle_down"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>