<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CustomToolbarStyle">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBack"
        style="@style/CustomToolbarImgStyle"
        tools:ignore="MissingConstraints"
        app:srcCompat="@drawable/base_backin"
        />
    <arch.cayenne.lib.common.ui.widget.ClearableEditText
        android:id="@+id/ce_search"
        android:textColor="@color/white"
        style="@style/CustomToolbarEditStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintEnd_toStartOf="@id/tvSearchText"
        android:drawableStart="@drawable/search_icon"
        android:drawablePadding="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/search_rounded_background"
        tools:ignore="MissingConstraints" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSearchText"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textColor="@color/search_btn"
        android:text="搜索"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>