<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SportConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/title_bg"
    style="@style/CustomToolbarStyle">

    <arch.cayenne.lib.skin.widget.SportImageView
        android:id="@+id/ivBack"
        style="@style/CustomToolbarImgStyle"
        tools:ignore="MissingConstraints"
        app:srcCompat="@drawable/bg_left_arrow"
        />
    
    
    <arch.cayenne.lib.skin.widget.SportLinearLayout
        style="@style/CustomToolbarLine"
        android:layout_marginLeft="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintEnd_toStartOf="@id/tvSearchText"
        android:background="@drawable/search_rounded_background"
        android:gravity="center_vertical"
        >
        
        <arch.cayenne.lib.skin.widget.SportImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/search_icon"
            />
        
        <arch.cayenne.lib.common.ui.widget.ClearableEditText
            android:id="@+id/ce_search"
            style="@style/CustomToolbarEditStyle"
            android:textColor="@color/search_text"
            android:textColorHint="@color/search_hint"
            android:drawablePadding="@dimen/dp_10"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@null"
            tools:ignore="MissingConstraints" />
    </arch.cayenne.lib.skin.widget.SportLinearLayout>
    
    
   

    <arch.cayenne.lib.skin.widget.SportTextView
        android:id="@+id/tvSearchText"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textColor="@color/search_btn"
        android:text="搜索"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

</arch.cayenne.lib.skin.widget.SportConstraintLayout>