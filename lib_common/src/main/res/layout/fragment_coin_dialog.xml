<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <arch.cayenne.lib.skin.widget.SkinnableConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginHorizontal="@dimen/dp_28"
        android:background="@drawable/bg_shape_currency"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <net.center.blurview.ShapeBlurView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:blur_border_width="0dp"
            app:blur_corner_radius="@dimen/dp_9"
            app:blur_mode="rectangle"
            app:blur_overlay_color="@color/blur_view"
            app:blur_radius="9dp"
            tools:ignore="MissingConstraints" />

        <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
            android:id="@+id/ll_search_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:layout_marginHorizontal="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/search_rounded_background"
            android:backgroundTint="@color/color_0FFFFFFF"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toStartOf="@+id/iv_setting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <arch.cayenne.lib.skin.widget.SkinnableImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/search_icon" />

            <arch.cayenne.lib.common.ui.view.ClearableEditText
                android:id="@+id/ce_search"
                style="@style/CustomToolbarEditStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:drawablePadding="@dimen/dp_10"
                android:gravity="center_vertical"
                android:hint="@string/search_title"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/search_text_for_search_bar"
                android:textColorHint="@color/color_999999"
                tools:ignore="MissingConstraints" />
        </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>

        <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
            android:id="@+id/rv_currency"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_search_bar" />
    </arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>