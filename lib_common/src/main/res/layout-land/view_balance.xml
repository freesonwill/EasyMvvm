<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_37"
    android:layout_height="129dp"
    android:background="@drawable/bg_shape_balance">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_add"
        android:layout_width="@dimen/dp_25"
        android:layout_height="@dimen/dp_25"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_6"
        android:background="@drawable/ic_recharge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/view_bg_second"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_shape_balance_second"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_add" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_currency_icon"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_24"
        android:background="@drawable/ic_usdt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_add" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_arrow"
        android:layout_width="@dimen/dp_10"
        android:layout_height="@dimen/dp_7"
        android:layout_marginTop="@dimen/dp_20"
        android:background="@drawable/ic_arrow_down"
        android:rotation="90"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_currency_icon" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_wallet_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/dp_5"
        android:fontFamily="@font/sf_pro_display_bold"
        android:text="1100.11100"
        android:textColor="@color/main_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>