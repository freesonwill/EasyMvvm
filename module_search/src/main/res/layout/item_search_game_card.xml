<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <arch.cayenne.lib.common.ui.view.RoundedImageView
        android:id="@+id/iv_game_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="111:146"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="9dp" />

    <LinearLayout
        android:id="@+id/ll_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="7dp"
        app:layout_constraintTop_toBottomOf="@id/iv_game_cover">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_hot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search_game_hot" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:text="1.2%" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:textColor="@color/color_999999"
            android:textSize="12sp"
            android:text="@string/back_percent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/ll_back">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:src="@drawable/ic_search_game_dot" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:text="553" />

        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:textColor="@color/color_999999"
            android:textSize="12sp"
            android:text="@string/online_count" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>



