<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="103dp"
    android:layout_height="122dp"
    android:background="@drawable/shape_search_result_list_item_bg"
    app:layout_constraintDimensionRatio="103:122">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="23dp"
        android:background="@drawable/shape_search_result_list_item_text_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:singleLine="true"
        android:textColor="@color/main_text"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>