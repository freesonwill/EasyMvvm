<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root"
    android:layout_width="359dp"
    android:layout_height="108dp"
    android:background="@drawable/shape_search_result_race_item_bg"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_score_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="195dp" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_score_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="tv_score_home_team,tv_score_away_team" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_score_arrow_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="iv_arrow_team_home,iv_arrow_team_away" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:lines="1"
        android:textColor="@color/search_result_race_text_1"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:skinnableFontWeight="400"
        tools:text="英超" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="22dp"
        android:textColor="@color/search_result_race_text_1"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_away_team"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_icon_home_team"
        app:skinnableFontWeight="500"
        tools:text="09:00" />

    <arch.cayenne.lib.skin.widget.SkinnableView
        android:id="@+id/view_divider"
        android:layout_width="1dp"
        android:layout_height="34dp"
        android:layout_marginStart="56dp"
        android:background="@color/search_result_race_divider"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_away_team"
        app:layout_constraintEnd_toStartOf="@id/iv_icon_home_team"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_icon_home_team" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_icon_home_team"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="5dp"
        android:paddingStart="3.5dp"
        android:paddingEnd="3.5dp"
        app:layout_constraintStart_toEndOf="@id/view_divider"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        tools:src="@drawable/ic_search_result_placeholder" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_name_home_team"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/search_result_race_team_name"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_home_team"
        app:layout_constraintEnd_toStartOf="@id/guide_score_start"
        app:layout_constraintStart_toEndOf="@id/iv_icon_home_team"
        app:layout_constraintTop_toTopOf="@id/iv_icon_home_team"
        app:skinnableFontWeight="500"
        tools:text="阿根廷" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_score_home_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/search_result_race_team_name"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_home_team"
        app:layout_constraintEnd_toEndOf="@id/barrier_score_end"
        app:layout_constraintStart_toStartOf="@id/guide_score_start"
        app:layout_constraintTop_toTopOf="@id/iv_icon_home_team"
        app:skinnableFontWeight="600"
        tools:text="2" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_arrow_team_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_home_team"
        app:layout_constraintStart_toStartOf="@id/barrier_score_end"
        app:layout_constraintTop_toTopOf="@id/iv_icon_home_team"
        app:srcCompat="@drawable/ic_search_result_current_team"
        tools:visibility="visible" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_icon_away_team"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:paddingStart="3.5dp"
        android:paddingEnd="3.5dp"
        app:layout_constraintStart_toStartOf="@id/iv_icon_home_team"
        app:layout_constraintTop_toBottomOf="@id/iv_icon_home_team"
        tools:src="@drawable/ic_search_result_placeholder" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_name_away_team"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/search_result_race_team_name"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_away_team"
        app:layout_constraintEnd_toStartOf="@id/guide_score_start"
        app:layout_constraintStart_toEndOf="@id/iv_icon_away_team"
        app:layout_constraintTop_toTopOf="@id/iv_icon_away_team"
        app:skinnableFontWeight="500"
        tools:text="马恩岛" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_score_away_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/search_result_race_team_name"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_away_team"
        app:layout_constraintEnd_toEndOf="@id/barrier_score_end"
        app:layout_constraintStart_toStartOf="@id/guide_score_start"
        app:layout_constraintTop_toTopOf="@id/iv_icon_away_team"
        app:skinnableFontWeight="600"
        tools:text="299" />

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_arrow_team_away"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_away_team"
        app:layout_constraintStart_toStartOf="@id/barrier_score_end"
        app:layout_constraintTop_toTopOf="@id/iv_icon_away_team"
        app:srcCompat="@drawable/ic_search_result_current_team"
        tools:visibility="visible" />

    <arch.cayenne.lib.skin.widget.SkinnableImageButton
        android:id="@+id/btn_favorite"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/shape_search_result_favorite_bg"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/layer_search_result_favorite"
        app:layout_constraintEnd_toStartOf="@id/btn_bet"
        app:layout_constraintTop_toTopOf="@id/btn_bet" />

    <arch.cayenne.lib.skin.widget.SkinnableButton
        android:id="@+id/btn_bet"
        android:layout_width="63dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_search_result_bet_btn_state"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:padding="7dp"
        android:textColor="@color/btn_search_result_bet_text"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:skinnableFontWeight="500"
        tools:text="@string/search_result_btn_bet" />

</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>