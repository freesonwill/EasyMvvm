<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="model"
            type="com.walisport.module.topup.ui.viewmodel.TopUpRecordsViewModel" />
    </data>

    <arch.cayenne.lib.common.ui.view.InterceptedConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        app:interceptedDirection="RIGHT">

        <arch.cayenne.lib.common.ui.view.TitleBarView
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <arch.cayenne.lib.common.ui.view.PullRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleBar"
            app:srlEnablePreviewInEditMode="true">

            <arch.cayenne.lib.skin.widget.SkinnableRecyclerView
                android:id="@+id/rv_collect_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                android:background="#161823"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:interceptedDirection="RIGHT"
                app:touchSlop="DEFAULT" />
        </arch.cayenne.lib.common.ui.view.PullRefreshLayout>

        <arch.cayenne.lib.common.ui.view.DynamicStateLayout
            android:id="@+id/cl_dynamics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </arch.cayenne.lib.common.ui.view.InterceptedConstraintLayout>
</layout>