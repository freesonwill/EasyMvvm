<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_98"
    android:layout_height="@dimen/dp_48"
    android:layout_marginBottom="@dimen/dp_11"
    android:background="@drawable/selector_pay_method">

    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_pay_icon"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_pay_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_14"
        android:textColor="@color/selector_pay_type"
        android:layout_marginStart="@dimen/dp_33"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_pay_recommend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_shape_recommend"
        android:paddingHorizontal="@dimen/dp_4"
        android:paddingVertical="@dimen/dp_1"
        android:text="@string/song_tip"
        android:textColor="@color/text_recommend"
        android:textSize="@dimen/sp_9"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>