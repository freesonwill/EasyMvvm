<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_topup"
    app:startDestination="@id/topUpMainFragment">

    <fragment
        android:id="@+id/topUpMainFragment"
        android:name="com.walisport.module.topup.ui.fragment.TopUpMainFragment"
        android:label="fragment_topup_main"
        tools:layout="@layout/fragment_topup_main">

        <deepLink app:uri="walisport://module_topup/topUpFragment" />
        <action
            android:id="@+id/action_topUpMainFragment_to_topUpRecordsFragment"
            app:destination="@id/topUpRecordsFragment" />
    </fragment>


    <fragment
        android:id="@+id/topUpDetailFragment"
        android:name="com.walisport.module.topup.ui.fragment.TopUpDetailFragment"
        android:label="TopUpDetailFragment" />
    <fragment
        android:id="@+id/topUpRecordsFragment"
        android:name="com.walisport.module.topup.ui.fragment.TopUpRecordsFragment"
        android:label="TopUpRecordsFragment" >
        <action
            android:id="@+id/action_topUpRecordsFragment_to_topUpDetailFragment"
            app:destination="@id/topUpDetailFragment" />
    </fragment>


</navigation>