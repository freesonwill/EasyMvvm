<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_topup">

    <fragment
        android:id="@+id/topUpFragment"
        android:name="com.walisport.module.topup.ui.fragment.TopUpFragment"
        android:label="TopUpFragment">

        <deepLink app:uri="walisport://module_topup/topUpFragment" />

        <!--跳转添加提现银行卡页面-->
        <action
            android:id="@+id/action_topUpFragment_to_addBankCardFragment"
            app:destination="@id/addBankCardFragment" />

        <!--跳转订单详情页面-->
        <action
            android:id="@+id/action_topUpFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/withdrawFiatFragment"
        android:name="com.walisport.module.topup.ui.fragment.WithdrawFiatFragment"
        android:label="WithdrawFiatFragment" />

    <fragment
        android:id="@+id/betDetailFragment"
        android:name="com.walisport.module.topup.ui.fragment.BetDetailFragment"
        android:label="BetDetailFragment" />

    <fragment
        android:id="@+id/addressEditFragment"
        android:name="com.walisport.module.topup.ui.fragment.AddressEditFragment"
        android:label="AddressEditFragment" />

    <fragment
        android:id="@+id/addressFragment"
        android:name="com.walisport.module.topup.ui.fragment.AddressNoteFragment"
        android:label="AddressFragment">

        <!--跳转编辑地址页面-->
        <action
            android:id="@+id/action_addressFragment_to_addressEditFragment"
            app:destination="@id/addressEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/withdrawFragment"
        android:name="com.walisport.module.topup.ui.fragment.WithdrawFragment"
        android:label="WithdrawFragment" >

        <deepLink app:uri="walisport://module_topup/withdrawFragment" />

        <!--跳转地址本页面-->
        <action
            android:id="@+id/action_withdrawFragment_to_addressFragment"
            app:destination="@id/addressFragment" />

        <!--跳转投注额详情页面-->
        <action
            android:id="@+id/action_withdrawFragment_to_betDetailFragment"
            app:destination="@id/betDetailFragment" />

        <!--跳转添加提现银行卡页面-->
        <action
            android:id="@+id/action_withdrawFragment_to_addBankCardFragment"
            app:destination="@id/addBankCardFragment" />
    </fragment>

    <fragment
        android:id="@+id/bankCardFragment"
        android:name="com.walisport.module.topup.ui.fragment.BankCardFragment"
        android:label="BankCardFragment">

        <!--跳转添加银行卡页面-->
        <action
            android:id="@+id/action_bankCardFragment_to_addBankCardFragment"
            app:destination="@id/addBankCardFragment" />
    </fragment>

    <fragment
        android:id="@+id/selectBankFragment"
        android:name="com.walisport.module.topup.ui.fragment.SelectBankFragment"
        android:label="SelectBankFragment" />

    <fragment
        android:id="@+id/addBankCardFragment"
        android:name="com.walisport.module.topup.ui.fragment.AddBankCardFragment"
        android:label="AddBankCardFragment">

        <!--跳转选择所属银行页面-->
        <action
            android:id="@+id/action_addBankCardFragment_to_selectBankFragment"
            app:destination="@id/selectBankFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.walisport.module.topup.ui.fragment.OrderDetailFragment"
        android:label="OrderDetailFragment">
    </fragment>
</navigation>