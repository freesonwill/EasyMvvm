<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_105"
    android:layout_height="161dp"
    android:id="@+id/rvRoot"
    android:paddingEnd="@dimen/dp_7"
    xmlns:tool="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <arch.cayenne.lib.common.ui.view.RoundedImageView
        android:id="@+id/iv_game_cover"
        android:layout_width="111dp"
        android:layout_height="146dp"
        app:layout_constraintDimensionRatio="111:146"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="9dp"
        />
    <LinearLayout
        android:id="@+id/ll_count"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintTop_toBottomOf="@+id/iv_game_cover"
        app:layout_constraintLeft_toLeftOf="parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dp_7"
        android:layout_height="@dimen/dp_7"
        android:background="@drawable/ic_game_dot" />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_3"
        android:textColor="@color/color_FFFFFF"
        android:textSize="12sp"
        android:text="553" />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_3"
        android:textColor="@color/color_999999"
        android:textSize="12sp"
        android:text="@string/online_count" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>