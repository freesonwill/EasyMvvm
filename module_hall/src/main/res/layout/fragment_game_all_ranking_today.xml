<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="351dp"
        android:layout_height="110dp"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:background="@drawable/bg_game_all_bonus"
        app:layout_constraintDimensionRatio="351:110"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <TextView
            android:id="@+id/tv_today_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_D9BFAA"
            android:text="@string/daily_betting_game"
            android:layout_marginTop="@dimen/dp_3"
            android:layout_marginStart="@dimen/dp_93"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            tools:ignore="RtlHardcoded" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_title_line"
            android:layout_width="0.5dp"
            android:layout_height="0dp"
            android:background="@color/color_D0B5A1"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintTop_toTopOf="@+id/tv_today_title"
            app:layout_constraintBottom_toBottomOf="@+id/tv_today_title"
            app:layout_constraintLeft_toRightOf="@+id/tv_today_title" />
        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_FFFFFF"
            android:text="23:59:59"
            android:gravity="center"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginTop="@dimen/dp_3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_title_line" />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_12"
            android:layout_height="@dimen/dp_12"
            app:srcCompat="@drawable/ic_helper"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="@+id/tv_today_title"
            app:layout_constraintBottom_toBottomOf="@+id/tv_today_title"
            app:layout_constraintLeft_toRightOf="@+id/tv_timer" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="331dp"
            android:layout_height="80dp"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginBottom="@dimen/dp_6"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            android:background="@drawable/bg_game_all_ranking_today_bonus"
            app:layout_constraintTop_toBottomOf="@+id/tv_today_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_today_money"
                android:layout_width="@dimen/dp_102"
                android:layout_height="@dimen/dp_66"
                android:layout_marginTop="8dp"
                android:background="@drawable/ic_game_all_ranking_today_money"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_line_inner"
                android:layout_width="0.5dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="@dimen/dp_8"
                android:background="@color/color_513D301A"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/iv_today_money" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bonus_title"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_19"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginStart="81dp"
                app:srcCompat="@drawable/ic_game_all_ranking_today_title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/iv_line_inner" />
            <TextView
                android:id="@+id/tv_currency_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_965F25"
                android:textSize="@dimen/sp_20"
                android:text="¥"
                android:layout_marginEnd="@dimen/dp_6"
                android:layout_marginBottom="@dimen/dp_9"
                app:layout_constraintRight_toLeftOf="@+id/tv_bonus"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <TextView
                android:id="@+id/tv_bonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_bold"
                android:textColor="@color/color_965F25"
                android:includeFontPadding="false"
                android:textSize="34sp"
                android:text="1,457,000"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_6"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>