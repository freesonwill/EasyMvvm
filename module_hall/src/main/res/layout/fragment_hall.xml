<?xml version="1.0" encoding="utf-8"?>
<arch.cayenne.lib.skin.widget.SkinnableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/title_bg"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:interceptedDirection="RIGHT">
    <!--  頂端列  -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/dp_0"
        android:orientation="horizontal" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homeBarIcon"
        android:layout_width="124dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_top_bar_right_bg"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/iv_right_logo"
        app:layout_constraintRight_toRightOf="parent" />
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_left_logo"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_15"
        android:src="@drawable/ic_top_bar_left_logo"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintTop_toTopOf="@+id/iv_right_logo"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <arch.cayenne.lib.common.ui.view.BalanceView
        android:id="@+id/balance_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_9"
        app:layout_constraintTop_toTopOf="@+id/iv_left_logo"
        app:layout_constraintBottom_toBottomOf="@+id/iv_left_logo"
        app:layout_constraintLeft_toRightOf="@+id/iv_left_logo"/>
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_right_logo"
        android:layout_width="@dimen/dp_103"
        android:layout_height="@dimen/dp_68"
        app:srcCompat="@drawable/ic_top_bar_right_logo"
        app:layout_constraintTop_toTopOf="@+id/guideline"
        app:layout_constraintRight_toRightOf="parent" />
    <!--  搜尋列  -->
    <arch.cayenne.lib.skin.widget.SkinnableImageView
        android:id="@+id/iv_home_sidebar"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_14"
        app:srcCompat="@drawable/ic_drawer_entry"
        app:layout_constraintTop_toTopOf="@+id/ll_search_bar"
        app:layout_constraintBottom_toBottomOf="@+id/ll_search_bar"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_unread_dot"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        android:src="@drawable/ic_shape_unread_msg_dot"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_home_sidebar"
        app:layout_constraintTop_toTopOf="@id/iv_home_sidebar" />

    <arch.cayenne.lib.skin.widget.SkinnableLinearLayout
        android:id="@+id/ll_search_bar"
        style="@style/CustomToolbarLine"
        android:background="@drawable/search_rounded_background"
        android:backgroundTint="@color/color_0FFFFFFF"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_19"
        android:layout_marginEnd="@dimen/dp_14"
        app:layout_constraintStart_toEndOf="@+id/iv_home_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_right_logo">

        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginStart="8dp"
            app:srcCompat="@drawable/search_icon" />

        <arch.cayenne.lib.common.ui.view.ClearableEditText
            android:id="@+id/ce_search"
            style="@style/CustomToolbarEditStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@null"
            android:drawablePadding="@dimen/dp_10"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:gravity="center_vertical"
            android:textColor="@color/search_text_for_search_bar"
            android:textColorHint="@color/color_999999"
            tools:ignore="MissingConstraints" />
        <arch.cayenne.lib.skin.widget.SkinnableImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_9"
            android:layout_marginBottom="@dimen/dp_9"
            android:background="@color/color_0FFFFFFF" />
        <arch.cayenne.lib.skin.widget.SkinnableTextView
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:text="@string/search_title"
            android:textColor="@color/color_FFFFFF"
            android:textSize="15sp"
            android:paddingEnd="@dimen/dp_15"
            tools:ignore="RtlSymmetry" />
    </arch.cayenne.lib.skin.widget.SkinnableLinearLayout>
    
    
    <!--  下方的遊戲分類TAB  -->
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTab"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_height="@dimen/dp_64">

        
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aci_tab_bg"
            android:layout_width="@dimen/dp_108"
            android:layout_height="@dimen/dp_55"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/hall_tab_bg"
            tools:ignore="MissingConstraints" />

        <arch.cayenne.lib.skin.widget.SkinnableTabLayout
            android:id="@+id/tl_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@android:color/transparent"
            app:tabContentStart="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingTop="0dp"
            app:tabPaddingBottom="0dp"
            app:tabPaddingEnd="@dimen/dp_0"
            app:tabMaxWidth="69dp"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="0dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@null"
            tools:ignore="MissingConstraints" />
        
    </androidx.constraintlayout.widget.ConstraintLayout>
   
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_game"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toBottomOf="@+id/clTab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
</arch.cayenne.lib.skin.widget.SkinnableConstraintLayout>