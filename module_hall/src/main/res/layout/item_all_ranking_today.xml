<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:layout_height="@dimen/dp_48"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_game_all_rank_list_bg">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_rank"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_22"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_C0C0C0"
        android:layout_marginBottom="@dimen/dp_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/iv_rank"
        app:layout_constraintRight_toRightOf="@+id/iv_rank"
        tools:ignore="RtlHardcoded" />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_player_name"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_14"
        android:gravity="center"
        android:textColor="@color/color_C0C0C0"
        android:layout_marginStart="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_rank"
        tools:ignore="RtlHardcoded" />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_betting"
        android:layout_width="@dimen/dp_91"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_14"
        android:gravity="center"
        android:textColor="@color/color_C0C0C0"
        android:layout_marginStart="@dimen/dp_27"
        android:layout_marginBottom="@dimen/dp_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_player_name"
        tools:ignore="RtlHardcoded" />
    <arch.cayenne.lib.skin.widget.SkinnableTextView
        android:id="@+id/tv_bonus"
        android:layout_width="51dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_14"
        android:gravity="center"
        android:textColor="@color/color_C0C0C0"
        android:layout_marginBottom="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_32"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_betting"
        tools:ignore="RtlHardcoded" />
</androidx.constraintlayout.widget.ConstraintLayout>